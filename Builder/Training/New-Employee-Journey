const LearnerLesson = ({ db, params, navigate }) => {
  const [isPlaying, setIsPlaying] = useState(false);
  const [challengeResponse, setChallengeResponse] = useState('');
  
  const topicLessons = db.lessons.filter(l => l.topic_id === params.topicId).sort((a,b) => a.order - b.order);
  
  // Guard against missing lessons (e.g., clicking on a topic without mock lesson content)
  if (!topicLessons || topicLessons.length === 0) {
    return (
      <div className="animate-in fade-in duration-300 max-w-3xl">
        <button onClick={() => navigate('dashboard')} className="flex items-center text-[#52404B] text-sm font-medium hover:text-[#1F1C1B] transition-colors mb-8">
          <ChevronLeft className="w-4 h-4 mr-1" /> EXIT
        </button>
        <div className="p-8 border border-[#E5E4E3] bg-[#FAFBF8] text-center">
          <p className="font-body text-[#52404B]">This topic does not have any lesson content loaded in the current demo database.</p>
        </div>
      </div>
    );
  }

  const lesson = topicLessons[params.lessonIndex];
  const card = lesson.cards[params.cardIndex];
  const progressPercent = Math.round(((params.cardIndex + 1) / lesson.cards.length) * 100);

  const handleNext = () => {
    setIsPlaying(false);
    // Track: Save challenge response, log card view completion here.
    if (params.cardIndex < lesson.cards.length - 1) {
      navigate('lesson', { ...params, cardIndex: params.cardIndex + 1 });
    } else if (params.lessonIndex < topicLessons.length - 1) {
      navigate('lesson', { ...params, lessonIndex: params.lessonIndex + 1, cardIndex: 0 });
      setChallengeResponse('');
    } else {
      navigate('test', { topicId: params.topicId });
    }
  };

  return (
    <div className="animate-in fade-in duration-300 max-w-3xl">
      <button onClick={() => navigate('dashboard')} className="flex items-center text-[#52404B] text-sm font-medium hover:text-[#1F1C1B] transition-colors mb-8">
        <ChevronLeft className="w-4 h-4 mr-1" /> EXIT
      </button>

      <div className="w-full h-1 bg-[#E5E4E3] mb-4">
        <div className="h-full bg-[#007970] transition-all duration-500" style={{ width: `${progressPercent}%` }}></div>
      </div>
      <div className="flex justify-between text-[10px] text-[#52404B] font-bold tracking-widest uppercase mb-16">
        <span>{lesson.title}</span>
        <span>Part {params.cardIndex + 1} of {lesson.cards.length}</span>
      </div>

      <div className="mb-12">
        {card.image_url && (
          <div className="mb-10 w-full rounded-2xl overflow-hidden border border-[#E5E4E3] bg-[#FAFBF8]">
            <img 
              src={card.image_url} 
              alt={card.title}
              className="w-full h-72 object-cover object-center"
            />
          </div>
        )}

        <span className="text-[10px] font-bold text-[#007970] tracking-widest uppercase mb-4 block">
          {card.type}
        </span>
        <h2 className="font-heading text-4xl font-medium text-[#1F1C1B] mb-4">{card.title}</h2>
        
        <NativeAudioPlayer 
          isPlaying={isPlaying} 
          onPlayPause={() => setIsPlaying(!isPlaying)} 
          duration={card.estimated_duration} 
        />

        <div className="font-body text-lg text-[#1F1C1B] leading-relaxed whitespace-pre-wrap">
          {card.content}
        </div>

        {card.type === 'challenge' && (
          <div className="mt-12 pt-10 border-t border-dashed border-[#E5E4E3]">
            <label className="block text-sm font-medium text-[#1F1C1B] mb-4 uppercase tracking-wider">Your Response (Required)</label>
            <textarea 
              rows="5" 
              value={challengeResponse}
              onChange={(e) => setChallengeResponse(e.target.value)}
              className="w-full p-5 text-base border border-[#E5E4E3] focus:border-[#C74601] outline-none font-body transition-colors bg-[#FAFBF8]"
              placeholder="Analyze the scenario and type your action steps here..."
            />
          </div>
        )}
      </div>

      <div className="mt-20 pt-8 border-t border-[#E5E4E3] flex justify-between items-center">
        <button 
          disabled={params.cardIndex === 0}
          onClick={() => navigate('lesson', { ...params, cardIndex: params.cardIndex - 1 })}
          className="text-sm font-medium text-[#52404B] hover:text-[#1F1C1B] disabled:opacity-30 disabled:cursor-not-allowed"
        >
          PREVIOUS
        </button>
        <button 
          onClick={handleNext}
          disabled={card.type === 'challenge' && challengeResponse.trim().length < 10}
          className="bg-[#C74601] text-white px-8 py-3 text-sm font-medium hover:bg-[#a63a01] transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center tracking-wide"
        >
          {params.cardIndex === lesson.cards.length - 1 ? 'PROCEED TO TEST' : 'CONTINUE'} <ChevronRight className="w-4 h-4 ml-2" />
        </button>
      </div>
    </div>
  );
};

const LearnerTest = ({ db, params, navigate }) => {
  const [testSelection, setTestSelection] = useState(null);
  const test = db.tests.find(t => t.topic_id === params.topicId);
  
  if (!test) {
    return (
      <div className="animate-in fade-in duration-300 max-w-3xl">
        <button onClick={() => navigate('dashboard')} className="flex items-center text-[#52404B] text-sm font-medium hover:text-[#1F1C1B] transition-colors mb-8">
          <ChevronLeft className="w-4 h-4 mr-1" /> EXIT
        </button>
        <div className="p-8 border border-[#E5E4E3] bg-[#FAFBF8] text-center">
          <p className="font-body text-[#52404B]">This topic does not have a test loaded in the current demo database.</p>
        </div>
      </div>
    );
  }

  const q = test.questions[0];

  const handleSubmit = () => {
    const passed = testSelection === q.correct_answer;
    navigate('complete', { topicId: params.topicId, passed, rationale: q.rationale });
  };

  return (
    <div className="animate-in fade-in duration-300 max-w-3xl">
      <div className="mb-16 pb-8 border-b border-[#E5E4E3]">
        <h2 className="font-heading text-3xl font-medium text-[#1F1C1B] mb-2">Final Knowledge Check</h2>
        <p className="font-body text-[#52404B]">Select the most accurate response. Passing score: {test.passing_score}%</p>
      </div>
      
      <div className="mb-16">
        <p className="font-heading text-xl text-[#1F1C1B] font-medium leading-relaxed mb-8">{q.prompt}</p>
        <div className="space-y-4">
          {q.choices.map((choice, idx) => (
            <label key={idx} className={`flex items-start p-6 border transition-colors cursor-pointer ${testSelection === idx ? 'border-[#007970] bg-[#E5FEFF]' : 'border-[#E5E4E3] hover:border-[#007970]'}`}>
              <input 
                type="radio" name="test_q" value={idx} 
                checked={testSelection === idx} onChange={() => setTestSelection(idx)}
                className="mt-1 w-4 h-4 text-[#007970]" 
              />
              <span className="ml-4 font-body text-lg text-[#1F1C1B]">{choice}</span>
            </label>
          ))}
        </div>
      </div>

      <button 
        onClick={handleSubmit} disabled={testSelection === null}
        className="bg-[#007970] text-white px-10 py-3.5 text-sm font-medium tracking-wide hover:bg-[#005a53] transition-colors disabled:opacity-50"
      >
        SUBMIT ANSWERS
      </button>
    </div>
  );
};

