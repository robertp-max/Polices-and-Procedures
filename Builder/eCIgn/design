      {/* Main Content Area */}
      <main className="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 flex flex-col">
        
        {/* Stepper (Hidden on Final Step for cleaner UI) */}
        {currentStep < 4 && <Stepper currentStep={currentStep} />}

        {/* Step Content Container */}
        <div className="flex-1">
          {currentStep === 1 && (
            <SignatureStep 
              onNext={nextStep} 
              signatureData={signatureData} 
              setSignatureData={setSignatureData} 
            />
          )}
          {currentStep === 2 && (
            <VerifyStep onNext={nextStep} onSkip={nextStep} />
