// 1. Stepper Component
const Stepper = ({ currentStep }) => {
  const steps = [
    { num: 1, label: 'Sign', icon: PenTool },
    { num: 2, label: 'Verify', icon: Camera },
    { num: 3, label: 'Review', icon: FileCheck },
    { num: 4, label: 'Options', icon: Download }
  ];

  return (
    <div className="flex items-center justify-center w-full max-w-3xl mx-auto mb-12">
      {steps.map((step, index) => (
        <React.Fragment key={step.num}>
          <div className="flex flex-col items-center relative z-10">
            <div 
              className={`w-12 h-12 rounded-full flex items-center justify-center transition-all duration-300 border-2 ${
                currentStep > step.num 
                  ? 'bg-indigo-600 border-indigo-600 text-white' 
                  : currentStep === step.num 
                    ? 'bg-white border-indigo-600 text-indigo-600 shadow-[0_0_15px_rgba(79,70,229,0.3)]' 
                    : 'bg-white border-slate-200 text-slate-400'
