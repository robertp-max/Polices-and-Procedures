  );
};

// 2. Step 1: Signature Canvas
const SignatureStep = ({ onNext, signatureData, setSignatureData }) => {
  const canvasRef = useRef(null);
  const [isDrawing, setIsDrawing] = useState(false);
  const [hasDrawn, setHasDrawn] = useState(!!signatureData);
  const [mode, setMode] = useState('draw'); // 'draw', 'type', 'upload'
  const [typedText, setTypedText] = useState(SIGNER_INFO.name);
  const [isCanvasInitialized, setIsCanvasInitialized] = useState(false);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (canvas && mode === 'draw' && !isCanvasInitialized) {
      // Slight timeout allows CSS layout to calculate dimensions when un-hiding the canvas
      setTimeout(() => {
        canvas.width = canvas.offsetWidth || 500;
        canvas.height = canvas.offsetHeight || 300;
        const ctx = canvas.getContext('2d');
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.lineWidth = 3;
        ctx.strokeStyle = '#0f172a'; // slate-900

        // Restore signature if exists
        if (signatureData) {
          const img = new Image();
          img.src = signatureData;
          img.onload = () => ctx.drawImage(img, 0, 0);
        }
        setIsCanvasInitialized(true);
      }, 50);
    }
  }, [mode, isCanvasInitialized, signatureData]);

  const handleModeChange = (newMode) => {
    if (mode === newMode) return;
    setMode(newMode);
    setSignatureData(null);
    setHasDrawn(false);
    if (newMode === 'type') {
      setTypedText(SIGNER_INFO.name);
    }
    if (newMode === 'draw') {
      setIsCanvasInitialized(false);
    }
  };

  const handleFileUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        setSignatureData(event.target.result);
      };
      reader.readAsDataURL(file);
    }
  };

  const handleConfirm = () => {
    if (mode === 'type' && typedText.trim()) {
      // Generate an image from the typed text so the rest of the app receives a unified base64 PNG
      const canvas = document.createElement('canvas');
      canvas.width = 600;
      canvas.height = 200;
      const ctx = canvas.getContext('2d');
      ctx.font = 'italic 56px "Brush Script MT", "Caveat", "Segoe Print", cursive';
      ctx.fillStyle = '#0f172a';
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'center';
      ctx.fillText(typedText, canvas.width / 2, canvas.height / 2);
      setSignatureData(canvas.toDataURL('image/png'));
    }
    onNext();
  };

  const startDrawing = (e) => {
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    const rect = canvas.getBoundingClientRect();
    
    const clientX = e.clientX || (e.touches && e.touches[0].clientX);
    const clientY = e.clientY || (e.touches && e.touches[0].clientY);

    ctx.beginPath();
    ctx.moveTo(clientX - rect.left, clientY - rect.top);
    setIsDrawing(true);
    setHasDrawn(true);
  };

  const draw = (e) => {
    if (!isDrawing) return;
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    const rect = canvas.getBoundingClientRect();
    
    const clientX = e.clientX || (e.touches && e.touches[0].clientX);
    const clientY = e.clientY || (e.touches && e.touches[0].clientY);

    ctx.lineTo(clientX - rect.left, clientY - rect.top);
    ctx.stroke();
  };

  const stopDrawing = () => {
    if (isDrawing) {
      setIsDrawing(false);
      const canvas = canvasRef.current;
      setSignatureData(canvas.toDataURL('image/png'));
    }
  };

  const clearCanvas = () => {
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    setHasDrawn(false);
    setSignatureData(null);
  };

  const canConfirm = 
    (mode === 'draw' && hasDrawn) || 
    (mode === 'type' && typedText.trim().length > 0) || 
    (mode === 'upload' && signatureData !== null);

  return (
    <div className="flex flex-col lg:flex-row gap-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
      {/* Left Column: Context */}
      <div className="w-full lg:w-1/3 space-y-6">
        <div className="bg-gradient-to-br from-indigo-900 to-slate-900 rounded-2xl p-6 text-white shadow-lg">
          <div className="flex items-center gap-3 mb-6">
            <div className="bg-white/10 p-2 rounded-lg backdrop-blur-sm">
              <ShieldCheck className="w-6 h-6 text-indigo-300" />
            </div>
            <h3 className="font-semibold text-lg">Secure Signing</h3>
          </div>
          <p className="text-slate-300 text-sm leading-relaxed">
            Your identity, location, and document edits are captured automatically and packaged into the attestation certificate.
          </p>
        </div>

        <div className="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-6">
          <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <User className="w-4 h-4" /> Signer Identity
          </h4>
          <div className="space-y-4">
            <div>
              <p className="text-sm font-medium text-slate-900">{SIGNER_INFO.name}</p>
              <p className="text-xs text-slate-500">{SIGNER_INFO.role}</p>
            </div>
            <div>
              <p className="text-sm text-slate-700">{SIGNER_INFO.email}</p>
            </div>
            <div className="flex items-center gap-4 text-xs text-slate-500">
              <span className="flex items-center gap-1"><Clock className="w-3 h-3" /> {SIGNER_INFO.date}</span>
            </div>
          </div>

          <div className="pt-6 border-t border-slate-100">
            <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2 mb-4">
              <Globe className="w-4 h-4" /> Location & Network
            </h4>
            <div className="grid grid-cols-1 gap-y-4 gap-x-4 text-xs text-slate-600">
              <div>
                <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">IP Address</p>
                <p className="font-mono truncate" title={SIGNER_INFO.ip}>{SIGNER_INFO.ip}</p>
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">City</p>
                  <p>{SIGNER_INFO.city}</p>
                </div>
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">State / Region</p>
                  <p>{SIGNER_INFO.state}</p>
                </div>
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Country</p>
                  <p>{SIGNER_INFO.country}</p>
                </div>
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Coordinates</p>
                  <p>{SIGNER_INFO.latitude}, {SIGNER_INFO.longitude}</p>
                </div>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Network Org</p>
                <p className="truncate">{SIGNER_INFO.network}</p>
              </div>
            </div>
          </div>

          <div className="pt-6 border-t border-slate-100">
            <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2 mb-4">
              <Laptop className="w-4 h-4" /> Device & System
            </h4>
            <div className="grid grid-cols-1 gap-y-4 gap-x-4 text-xs text-slate-600">
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Device Name</p>
                  <p className="font-medium text-slate-800">{SIGNER_INFO.deviceName}</p>
                </div>
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Platform Role</p>
                  <p className="font-medium text-slate-800">{SIGNER_INFO.platformRole}</p>
                </div>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Operating System</p>
                <p className="truncate font-medium text-slate-800" title={SIGNER_INFO.os}>{SIGNER_INFO.os}</p>
                <p className="text-slate-400 truncate text-[10px] mt-0.5" title={SIGNER_INFO.osVersion}>{SIGNER_INFO.osVersion}</p>
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Manufacturer</p>
                  <p className="font-medium text-slate-800">{SIGNER_INFO.systemManufacturer}</p>
                </div>
                <div>
                  <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Model</p>
                  <p className="font-medium text-slate-800">{SIGNER_INFO.systemModel}</p>
                </div>
              </div>
              <div>
                <p className="text-[10px] text-slate-400 font-bold uppercase mb-0.5">Processor</p>
                <p className="truncate font-medium text-slate-800" title={SIGNER_INFO.processor}>{SIGNER_INFO.processor}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Right Column: Canvas/Input */}
      <div className="w-full lg:w-2/3 flex flex-col">
        <div className="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h2 className="text-2xl font-bold text-slate-900">Provide your signature</h2>
            <p className="text-slate-500 mt-1 text-sm">Choose how you'd like to sign this document.</p>
          </div>
          
          {/* Mode Selector Tabs */}
          <div className="flex bg-slate-100 p-1 rounded-xl w-full sm:w-auto min-w-[280px]">
            <button 
              onClick={() => handleModeChange('draw')} 
              className={`flex-1 flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-sm font-medium transition-all ${mode === 'draw' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}
            >
              <PenTool className="w-4 h-4" /> Draw
            </button>
            <button 
              onClick={() => handleModeChange('type')} 
              className={`flex-1 flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-sm font-medium transition-all ${mode === 'type' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}
            >
              <Keyboard className="w-4 h-4" /> Type
            </button>
            <button 
              onClick={() => handleModeChange('upload')} 
              className={`flex-1 flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-sm font-medium transition-all ${mode === 'upload' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}
            >
              <UploadCloud className="w-4 h-4" /> Upload
            </button>
          </div>
        </div>
        
        {/* DRAW MODE */}
        <div className={`flex-1 bg-white border-2 border-dashed border-slate-200 rounded-2xl relative overflow-hidden flex-col shadow-inner min-h-[300px] ${mode === 'draw' ? 'flex' : 'hidden'}`}>
          {!hasDrawn && (
            <div className="absolute inset-0 flex flex-col items-center justify-center text-slate-300 pointer-events-none">
              <PenTool className="w-12 h-12 mb-2 opacity-50" />
              <span className="text-lg font-medium">Sign Here</span>
            </div>
          )}
          
          <canvas
            ref={canvasRef}
            className="flex-1 w-full h-full cursor-crosshair touch-none"
            onMouseDown={startDrawing}
            onMouseMove={draw}
            onMouseUp={stopDrawing}
            onMouseLeave={stopDrawing}
            onTouchStart={startDrawing}
            onTouchMove={draw}
            onTouchEnd={stopDrawing}
          />

          <div className="absolute bottom-4 left-4 right-4 flex justify-between items-center px-4 py-3 bg-white/80 backdrop-blur-md rounded-xl border border-slate-100 shadow-sm pointer-events-none">
             <span className="text-xs text-slate-400 font-medium tracking-widest uppercase pointer-events-auto">Signature Line</span>
             <button 
                onClick={clearCanvas}
                className="text-sm font-medium text-slate-500 hover:text-red-500 flex items-center gap-1 transition-colors pointer-events-auto"
             >
                <RotateCcw className="w-4 h-4" /> Clear
             </button>
          </div>
        </div>

        {/* TYPE MODE */}
        <div className={`flex-1 bg-white border-2 border-slate-200 rounded-2xl p-6 flex-col min-h-[300px] shadow-sm ${mode === 'type' ? 'flex' : 'hidden'}`}>
          <label className="text-sm font-bold text-slate-700 mb-2 block uppercase tracking-wider">Type your full name</label>
          <input 
            type="text" 
            value={typedText}
            onChange={(e) => setTypedText(e.target.value)}
            className="w-full p-4 border border-slate-300 rounded-xl mb-6 text-lg focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all shadow-sm"
            placeholder="e.g. JD Vance"
          />
          <div className="flex-1 flex flex-col relative">
            <span className="text-xs text-slate-400 font-medium tracking-widest uppercase mb-2 absolute top-4 left-6 z-10">Preview</span>
            <div className="flex-1 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center overflow-hidden min-h-[150px]">
               <span 
                 className={`text-slate-900 transition-all ${!typedText ? 'opacity-30' : ''}`}
                 style={{ fontFamily: '"Brush Script MT", "Caveat", "Segoe Print", cursive', fontSize: '4rem' }}
               >
                 {typedText || 'Signature'}
               </span>
            </div>
          </div>
        </div>

        {/* UPLOAD MODE */}
        <div className={`flex-1 bg-white border-2 border-dashed border-slate-200 rounded-2xl flex-col items-center justify-center min-h-[300px] relative transition-colors hover:bg-slate-50 overflow-hidden ${mode === 'upload' ? 'flex' : 'hidden'}`}>
           <input 
              type="file" 
              accept="image/png, image/jpeg"
              onChange={handleFileUpload}
              className="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
            />
            {signatureData && mode === 'upload' ? (
              <div className="relative w-full h-full flex flex-col items-center justify-center bg-slate-50">
                 <img src={signatureData} alt="Uploaded signature" className="max-h-[200px] object-contain p-4 mix-blend-multiply z-10" />
                 <div className="absolute bottom-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-lg shadow-sm border border-slate-200 z-10 pointer-events-none">
                    <p className="text-xs font-medium text-slate-600 flex items-center gap-2"><UploadCloud className="w-3 h-3"/> Click or drag to replace</p>
                 </div>
              </div>
            ) : (
              <div className="flex flex-col items-center pointer-events-none z-10">
                <div className="bg-indigo-50 p-4 rounded-full mb-4 shadow-sm">
                  <UploadCloud className="w-8 h-8 text-indigo-600" />
                </div>
                <p className="font-semibold text-slate-900 text-lg">Upload Signature Image</p>
                <p className="text-sm text-slate-500 mt-1">Click or drag a file here</p>
                <p className="text-xs text-slate-400 mt-4">Supports PNG, JPG</p>
              </div>
            )}
        </div>

        <div className="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p className="text-xs text-slate-500 flex-1">
            By signing, you confirm you are <strong className="text-slate-700">{SIGNER_INFO.name}</strong> and agree to attach this signature to <strong className="text-slate-700">{SIGNER_INFO.formId} v6.0</strong>.
          </p>
          <button 
            onClick={handleConfirm}
            disabled={!canConfirm}
            className={`px-8 py-3.5 rounded-xl font-semibold transition-all shadow-sm flex items-center justify-center gap-2 ${
              canConfirm 
                ? 'bg-indigo-600 text-white hover:bg-indigo-700 hover:shadow-md active:transform active:scale-95' 
                : 'bg-slate-100 text-slate-400 cursor-not-allowed'
            }`}
          >
            Confirm Signature
          </button>
        </div>
      </div>
    </div>
  );
};

