              <p className="text-sm font-medium text-slate-700">Tier Matrix Agreement</p>
            </div>
          </div>

          <div className="flex items-center gap-4">
             <div className="hidden sm:flex items-center gap-2 px-3 py-1.5 bg-slate-100 rounded-lg text-xs font-mono text-slate-500">
               <span>ID:</span>
               <span className="text-slate-700">{SIGNER_INFO.formId}</span>
             </div>
