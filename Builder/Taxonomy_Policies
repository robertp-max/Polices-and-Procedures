    REFERENCE: {bg:'rgba(255,255,255,0.03)', border:'rgba(255,255,255,0.1)', text:'rgba(255,255,255,0.4)'},
  };
  const s = c[tier] || c.REFERENCE;
  return (
    <span className={`inline-flex rounded-full font-bold uppercase tracking-widest ${small ? 'px-2 py-0.5 text-[7px]' : 'px-4 py-1.5 text-[10px]'}`} style={{background:s.bg, border:`1px solid ${s.border}`, color:s.text}}>
