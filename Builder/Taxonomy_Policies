// Ensure unique hardcoded policies
const uniqueHardcoded = Array.from(new Map(HARDCODED_POLICIES.map(p => [p.id, p])).values());

// Generate the remaining policies dynamically up to exactly 253
const GENERATED_POLICIES = [];
const TARGET_TOTAL = 253;
const allSubdomainsFlat = DOMAINS.flatMap(d => d.subdomains.map(s => ({ ...s, domainCode: d.code, domainName: d.fullName })));
const tiers = ['REQUIRED', 'ESSENTIAL', 'OPERATIONAL', 'REFERENCE'];
const statuses = ['ACTIVE', 'DRAFT', 'UNDER_REVIEW', 'DEPRECATED'];
const regs = ['42cfr', 'hipaa', 'osha', 'ca', 'ibm', 'fca'];
const risks = ['HIGH', 'MEDIUM', 'LOW'];

let counter = 1000;
let subIndex = 0;

while (uniqueHardcoded.length + GENERATED_POLICIES.length < TARGET_TOTAL) {
  const sub = allSubdomainsFlat[subIndex % allSubdomainsFlat.length];
  counter++;
  
  // Randomly assign 1 to 3 regulatory tags for rich filtering
  const regCount = (counter % 3) + 1; 
  const assignedRegs = [];
  for (let r = 0; r < regCount; r++) {
    assignedRegs.push(regs[(counter + r) % regs.length]);
  }
  
  GENERATED_POLICIES.push({
    id: `${sub.domainCode.toLowerCase()}-${sub.code.toLowerCase()}-${counter}`,
    policyId: `${sub.domainCode}-${sub.code}-${counter}`,
    title: `${sub.name} Standard Operating Procedure ${counter}`,
    domain: sub.domainName,
    domainCode: sub.domainCode,
    subdomain: `${sub.code} — ${sub.name}`,
    subdomainCode: sub.code,
    classificationTier: tiers[counter % tiers.length],
    // Make mostly ACTIVE to look like a healthy system
    status: statuses[(counter % 7 === 0) ? 1 : (counter % 11 === 0) ? 2 : (counter % 13 === 0) ? 3 : 0],
    version: `1.${counter % 5}`,
    effectiveDate: '2025-07-10',
    nextReviewDate: '2026-07-10',
    policyOwner: 'Department Director',
    approvedBy: 'Governing Body Chair',
    cfrMapping: ['Standard CFR Mapping'],
    purpose: `This procedure establishes the operational standards for ${sub.name} within the ${sub.domainCode} domain, ensuring compliance with state and federal guidelines.`,
    scope: ['Applicable Department Staff', 'Management'],
    linkedPolicies: [],
    enforcementRules: ['Standard enforcement rule 1', 'Annual review required'],
    appendices: [],
    riskLevel: risks[counter % 3],
    regulatoryTags: [...new Set(assignedRegs)]
  });
  
  subIndex++;
}

const FULL_POLICY_DATASET = [...uniqueHardcoded, ...GENERATED_POLICIES];

