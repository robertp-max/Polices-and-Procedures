// ══════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ══════════════════════════════════════════════════════════════

export default function FrameworkCommandShell() {
  // Navigation & Filtering State
  const [viewMode, setViewMode] = useState('grid'); // 'grid' | 'detail'
  const [selectedPolicy, setSelectedPolicy] = useState(null);

  const [selectedDomain, setSelectedDomain] = useState('ALL');
  const [selectedSubdomain, setSelectedSubdomain] = useState('ALL');
  const [activeRegFilters, setActiveRegFilters] = useState(new Set());
  const [searchQuery, setSearchQuery] = useState('');

  // Pre-flatten all subdomains for the 14x3 persistent view
  const allSubdomainsList = useMemo(() => {
    return DOMAINS.flatMap(d => d.subdomains.map(s => ({ ...s, domainCode: d.code, color: d.color })));
  }, []);

  const currentDomain = DOMAINS.find(d => d.code === selectedDomain);
  const subdomainOptions = selectedDomain === 'ALL' ? allSubdomainsList : currentDomain?.subdomains || [];

  const scopedPolicies = useMemo(() => {
    let p = FULL_POLICY_DATASET;
    if (selectedDomain !== 'ALL') p = p.filter(x => x.domainCode === selectedDomain);
    if (selectedSubdomain !== 'ALL') p = p.filter(x => x.subdomainCode === selectedSubdomain);
    return p;
  }, [selectedDomain, selectedSubdomain]);

  const visiblePolicies = useMemo(() => {
    let p = scopedPolicies;
    if (activeRegFilters.size > 0) {
      p = p.filter(x => {
        for (const f of activeRegFilters) {
          if (!x.regulatoryTags.includes(f)) return false;
        }
        return true;
      });
    }
    if (searchQuery.trim()) {
      const q = searchQuery.toLowerCase();
      p = p.filter(x =>
        x.policyId.toLowerCase().includes(q) ||
        x.title.toLowerCase().includes(q) ||
        x.policyOwner.toLowerCase().includes(q) ||
        x.cfrMapping.some(c => c.toLowerCase().includes(q))
      );
    }
    return p;
  }, [scopedPolicies, activeRegFilters, searchQuery]);

  const statusCounts = useMemo(() => ({
    ACTIVE: visiblePolicies.filter(p => p.status === 'ACTIVE').length,
    DRAFT: visiblePolicies.filter(p => p.status === 'DRAFT').length,
    UNDER_REVIEW: visiblePolicies.filter(p => p.status === 'UNDER_REVIEW').length,
  }), [visiblePolicies]);

  const toggleRegFilter = useCallback((id) => {
    setActiveRegFilters(prev => {
      const n = new Set(prev);
      if (n.has(id)) n.delete(id); else n.add(id);
      return n;
    });
  }, []);

  const handleDomainChange = useCallback((code) => {
    setSelectedDomain(code);
    setSelectedSubdomain('ALL');
    setViewMode('grid');
  }, []);

  const handleSubdomainChange = useCallback((code) => {
    setSelectedSubdomain(code);
    setViewMode('grid');
  }, []);

  const handlePolicyClick = useCallback((policy) => {
    setSelectedPolicy(policy);
    setViewMode('detail');
  }, []);

  const handleBackToGrid = useCallback(() => {
    setViewMode('grid');
    setSelectedPolicy(null);
  }, []);

  return (
    <>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Roboto:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');
        .font-montserrat { font-family: 'Montserrat', sans-serif; }
        .font-roboto { font-family: 'Roboto', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fadeIn { animation: fadeIn 0.3s ease-out forwards; }

        /* The 14-column grid for Subdomains when ALL is selected */
        .subdomain-grid-14 {
          display: grid;
          grid-template-columns: repeat(14, 1fr);
          grid-auto-rows: min-content;
          gap: 8px;
        }

        /* The horizontal-scrolling 11-column grid for Policies */
        .pp-grid-wrapper {
          width: 100%;
          overflow-x: auto;
          padding-bottom: 20px;
        }
        .pp-grid-11 {
          display: grid;
          grid-template-columns: repeat(11, 240px);
          width: max-content; 
          gap: 12px;
        }
      `}</style>

      {/* SINGLE GLASS SHELL IMPLEMENATION */}
      <div className="min-h-screen font-roboto text-white relative bg-[#111111] overflow-hidden">
        
        {/* The single container housing the entire interface */}
        <div className="relative w-full max-w-[2200px] mx-auto p-8 md:p-12 flex flex-col h-screen">

          {/* Conditional Header rendering - either Dashboard Title or Detail Header */}
          {viewMode === 'grid' && (
            <div className="shrink-0">
              <div className="flex justify-between items-center mb-8">
                 <div className="flex items-center gap-4">
                    <button className="text-[#00e59b] font-montserrat text-[11px] font-bold tracking-[0.2em] flex items-center gap-2 hover:opacity-80 uppercase transition-opacity">
                       <ChevronLeft size={16} /> TAXONOMY ROOT
                    </button>
                 </div>
                 <div className="flex gap-4">
                     <button className="border border-white/20 hover:bg-white/5 px-5 py-2.5 rounded-full font-bold text-[10px] tracking-[0.2em] transition-colors flex items-center gap-2 text-white uppercase">
                        <Printer size={14} /> EXPORT LIST
                     </button>
                 </div>
              </div>

              <h1 className="font-montserrat text-4xl md:text-[44px] leading-tight font-light text-white mb-12 tracking-wide">
                Enterprise Framework <span className="text-white/30 text-3xl ml-2 font-mono align-middle">v6.0</span>
              </h1>

              {/* DOMAIN SELECTION */}
              <div className="mb-8">
                <h2 className="font-montserrat text-[13px] font-bold text-white flex items-center tracking-widest uppercase border-l-[3px] border-[#00e59b] pl-4 mb-4">
                  <LayoutList className="text-[#00e59b] mr-3" size={18} /> Domain Context
                </h2>
                
                <div className="flex gap-2 overflow-x-auto no-scrollbar pl-5 pb-2">
                  <button onClick={() => handleDomainChange('ALL')}
                    className={`flex-shrink-0 px-5 py-2 rounded-full font-montserrat font-bold text-[11px] uppercase tracking-wider transition-colors ${
                      selectedDomain === 'ALL'
                        ? 'bg-white/10 text-white border border-white/20'
                        : 'text-white/50 border border-transparent hover:text-white'
                    }`}>
                    ALL DOMAINS
                  </button>
                  
                  {DOMAINS.map(d => {
                    const isActive = selectedDomain === d.code;
                    const Icon = d.icon;
                    return (
                      <button key={d.code} onClick={() => handleDomainChange(d.code)}
                        className={`flex-shrink-0 px-5 py-2 rounded-full font-montserrat font-bold text-[11px] uppercase tracking-wider transition-colors flex items-center gap-2 ${
                          isActive ? 'bg-[#00e59b]/20 text-[#00e59b] border border-[#00e59b]/50' : 'text-white/50 border border-transparent hover:text-white'
                        }`}>
                        <Icon size={14} className={isActive ? 'text-[#00e59b]' : 'text-white/30'} />
                        {d.name}
                      </button>
                    );
                  })}
                </div>

                {/* Persistent Subdomain Selection */}
                <div className="pl-10 mt-4 pb-2 border-l-2 border-white/10 ml-2 relative">
                  {selectedDomain === 'ALL' ? (
                    // Persistent 14x3 dense layout for ALL Subdomains
                    <div className="subdomain-grid-14 custom-scrollbar overflow-y-auto max-h-[120px] pr-2">
                       <button onClick={() => handleSubdomainChange('ALL')}
                          className={`col-span-2 px-3 py-1.5 rounded-md font-montserrat font-bold text-[9px] uppercase tracking-wider transition-colors text-left ${
                            selectedSubdomain === 'ALL' ? 'text-white bg-white/10 border border-white/20' : 'text-white/30 hover:text-white'
                          }`}>
                          ALL SUBDOMAINS
                       </button>
                       {subdomainOptions.map(s => {
                         const isActive = selectedSubdomain === s.code;
                         return (
                           <button key={`${s.domainCode || 'ALL'}-${s.code}`} onClick={() => handleSubdomainChange(s.code)}
                              className={`px-2 py-1.5 rounded-md font-montserrat font-bold text-[9px] uppercase tracking-wider transition-colors text-center truncate ${
                                isActive ? 'bg-white/10 border border-white/20 text-white' : 'text-white/40 hover:text-white border border-transparent'
                              }`}
                              style={{ color: isActive ? s.color : undefined, borderColor: isActive ? `${s.color}60` : undefined, backgroundColor: isActive ? `${s.color}15` : undefined }}>
                              {s.code}
                           </button>
                         );
                       })}
                    </div>
                  ) : (
                    // Horizontal scroll layout for specific domain
                    <div className="flex gap-2 overflow-x-auto no-scrollbar pb-1">
                      <button onClick={() => handleSubdomainChange('ALL')}
                        className={`flex-shrink-0 px-4 py-1.5 rounded-full font-montserrat font-bold text-[10px] uppercase tracking-wider transition-colors ${
                          selectedSubdomain === 'ALL' ? 'text-white bg-white/5 border border-white/10' : 'text-white/30 hover:text-white'
                        }`}>
                        ALL SUBDOMAINS
                      </button>
                      {subdomainOptions.map(s => {
                        const isActive = selectedSubdomain === s.code;
                        return (
                          <button key={`${selectedDomain}-${s.code}`} onClick={() => handleSubdomainChange(s.code)}
                            className={`flex-shrink-0 px-4 py-1.5 rounded-full font-montserrat font-bold text-[10px] uppercase tracking-wider transition-colors ${
                              isActive ? 'text-[#00e59b] border border-[#00e59b]/30 bg-[#00e59b]/10' : 'text-white/40 hover:text-white border border-transparent'
                            }`}>
                            {s.code} - {s.name}
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>

              {/* CONTROL STRIP (Unified search, stats, and regulatory) */}
              <div className="mb-6 border-y border-white/10 py-5">
                 <div className="flex flex-wrap items-center justify-between gap-8">
                    <div className="w-full md:w-80 relative flex items-center border-b border-white/20 pb-2">
                       <Search size={16} className="text-[#00e59b] mr-3" />
                       <input type="text" placeholder="Search Title, ID, or Keywords..." value={searchQuery} onChange={e => setSearchQuery(e.target.value)}
                          className="bg-transparent w-full text-white outline-none font-roboto text-sm placeholder:text-white/30" />
                       {searchQuery && <button onClick={() => setSearchQuery('')} className="absolute right-0 text-white/30 hover:text-white"><X size={14}/></button>}
                    </div>

                    <div className="flex items-center gap-6">
                       <div className="flex items-center gap-3">
                          <span className="text-[10px] uppercase tracking-[0.2em] text-white/30 font-bold">Scope:</span>
                          <span className="text-[14px] font-mono text-white">{visiblePolicies.length} <span className="text-white/30 text-xs font-roboto">Policies</span></span>
                       </div>
                       <div className="w-px h-6 bg-white/10"></div>
                       <div className="flex items-center gap-4">
                          {[{k:'ACTIVE', c:'#00e59b'}, {k:'DRAFT', c:'#f97316'}, {k:'UNDER_REVIEW', c:'#3b82f6'}].map(s => statusCounts[s.k] > 0 && (
                             <div key={s.k} className="flex items-center gap-2">
                                <span className="w-2 h-2 rounded-full" style={{background: s.c}}></span>
                                <span className="text-[12px] font-mono text-white/80">{statusCounts[s.k]}</span>
                             </div>
                          ))}
                       </div>
                    </div>
                 </div>

                 <div className="mt-5 flex flex-wrap gap-4 items-center">
                    <span className="text-[10px] uppercase tracking-[0.2em] text-white/30 font-bold mr-2">Regulatory Mapping:</span>
                    {REGULATORY_ITEMS.map(reg => {
                      const isActive = activeRegFilters.has(reg.id);
                      const Icon = reg.icon;
                      return (
                        <button key={reg.id} onClick={() => toggleRegFilter(reg.id)}
                          className="flex items-center gap-2 px-3 py-1.5 rounded-lg border transition-all"
                          style={{
                            borderColor: isActive ? reg.color : 'rgba(255,255,255,0.1)',
                            background: isActive ? `${reg.color}15` : 'transparent',
                            color: isActive ? reg.color : 'rgba(255,255,255,0.5)'
                          }}>
                          <Icon size={14} />
                          <span className="text-[10px] font-bold tracking-widest uppercase">{reg.shortName}</span>
                        </button>
                      );
                    })}
                 </div>
              </div>
            </div>
          )}

          {/* DYNAMIC CONTENT AREA (Yellow Box replacement) */}
          {viewMode === 'grid' ? (
            <div className="flex-1 pp-grid-wrapper custom-scrollbar">
              <div className="pp-grid-11 animate-fadeIn">
                {visiblePolicies.map(policy => {
                  const domain = DOMAINS.find(d => d.code === policy.domainCode);
                  const color = domain?.color || '#ffffff';
                  return (
                    <button key={policy.id} onClick={() => handlePolicyClick(policy)}
                      className="flex flex-col justify-between text-left p-4 rounded-xl transition-all border border-white/5 hover:bg-white/[0.02] hover:border-white/10 group min-h-[140px]">
                      
                      <div>
                         <div className="flex items-center justify-between mb-3">
                           <span className="text-[10px] font-bold font-mono tracking-wider" style={{color: color}}>
                             {policy.policyId}
                           </span>
                         </div>
                         <h3 className="text-xs text-white/80 font-medium leading-snug line-clamp-3 group-hover:text-white transition-colors">
                           {policy.title}
                         </h3>
                      </div>

                      <div className="mt-4 flex items-center justify-between">
                         <span className="text-[8px] uppercase tracking-widest text-white/30 font-bold border border-white/10 px-2 py-0.5 rounded">
                           {policy.classificationTier.substring(0,3)}
                         </span>
                         <span className="w-1.5 h-1.5 rounded-full" style={{
                           background: policy.status === 'ACTIVE' ? '#00e59b' : policy.status === 'DRAFT' ? '#f97316' : '#3b82f6'
                         }}></span>
                      </div>
                    </button>
                  );
                })}
              </div>

              {visiblePolicies.length === 0 && (
                <div className="text-center py-20 text-white/20 w-full absolute left-0 right-0">
                  <Search size={40} className="mx-auto mb-4 text-white/10"/>
                  <p className="text-lg font-light font-montserrat">No policies match criteria.</p>
                  <p className="text-sm mt-2 text-white/30">Adjust scope or regulatory filters to view documentation.</p>
                </div>
              )}
            </div>
          ) : (
            <PolicyDetailView policy={selectedPolicy} onBack={handleBackToGrid} />
          )}

        </div>
      </div>
    </>
  );
}