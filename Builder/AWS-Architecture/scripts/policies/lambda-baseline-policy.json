{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-west-1:__ACCOUNT_ID__:log-group:/aws/lambda/hhc-*:*"
    },
    {
      "Sid": "DDBReadWriteNoDelete",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-1:__ACCOUNT_ID__:table/compliance_objects",
        "arn:aws:dynamodb:us-west-1:__ACCOUNT_ID__:table/compliance_objects/index/*"
      ]
    },
    {
      "Sid": "DenyDDBDelete",
      "Effect": "Deny",
      "Action": [ "dynamodb:DeleteItem", "dynamodb:DeleteTable" ],
      "Resource": "*"
    },
    {
      "Sid": "S3PrefixedAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:AbortMultipartUpload",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1/uploads/*",
        "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1/evidence/*",
        "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1/forms/*",
        "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1/esign/*",
        "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1/audit/*",
        "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1/exports/*"
      ]
    },
    {
      "Sid": "S3ListBucketRoot",
      "Effect": "Allow",
      "Action": [ "s3:ListBucket", "s3:GetBucketLocation" ],
      "Resource": "arn:aws:s3:::hhc-__ENV__-__ACCOUNT_ID__-us-west-1"
    },
    {
      "Sid": "DenyS3Deletes",
      "Effect": "Deny",
      "Action": [ "s3:DeleteObject", "s3:DeleteObjectVersion" ],
      "Resource": "*"
    },
    {
      "Sid": "KMSUse",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:us-west-1:__ACCOUNT_ID__:alias/hhc-evidence",
        "arn:aws:kms:us-west-1:__ACCOUNT_ID__:alias/hhc-data"
      ]
    }
  ]
}
