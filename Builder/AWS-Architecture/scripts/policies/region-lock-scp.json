{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllExceptUsWest1",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "support:*",
        "sts:*",
        "budgets:*",
        "cloudfront:*",
        "globalaccelerator:*",
        "route53:*",
        "waf:*",
        "wafv2:*",
        "organizations:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:RequestedRegion": "us-west-1" }
      }
    }
  ]
}
