{
  "name": "frontend-cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "synth": "cdk synth",
    "deploy:staging": "cdk deploy CiPolicyFrontend-staging CiPolicyFrontendAlarms-staging --require-approval never",
    "deploy:prod":    "cdk deploy CiPolicyFrontend-prod    CiPolicyFrontendAlarms-prod    --require-approval never",
    "diff:staging":   "cdk diff CiPolicyFrontend-staging",
    "diff:prod":      "cdk diff CiPolicyFrontend-prod",
    "destroy:staging": "cdk destroy CiPolicyFrontend-staging CiPolicyFrontendAlarms-staging"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.196.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "aws-cdk": "^2.1033.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
