# ───────────────────────────────────────────────────────────────
# Regulatory Planner — Google Calendar Integration
# Copy this file to `.env` (at repo root) and fill in values.
# `.env` is gitignored — never commit real values.
# ───────────────────────────────────────────────────────────────

# Absolute or repo-relative path to the service-account JSON key.
# Default: ./server/credentials/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./server/credentials/service-account.json

# Target calendar. This is the calendar the service account has been
# granted "Make changes to events" on.
GOOGLE_CALENDAR_ID=c_e486af964106461821405ec832fecc5362587dc4468d2c487aed5b9af76795e5@group.calendar.google.com

# Default IANA timezone used when events do not specify one.
DEFAULT_TIMEZONE=America/Los_Angeles

# Express API port.
PORT=8787

# Dev-only: the Vite origin allowed to call the API.
# Production deploys should set this to the real web origin.
ALLOWED_ORIGIN=http://localhost:5173

# Optional: bearer token required on every /api/calendar/* call.
# Leave blank for local dev. Set a strong value for shared environments.
API_SHARED_SECRET=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ───────────────────────────────────────────────────────────────
# Compliance Intelligence (iAdministrator) — local RAG engine.
# All defaults work out of the box for a local Ollama install at
# 127.0.0.1:11434. No external services are required.
# ───────────────────────────────────────────────────────────────

# Where the local index is persisted (JSON vectors + metadata).
# Default: ./.cache/ia-index  (gitignored)
IA_INDEX_ROOT=.cache/ia-index

# Corpus root. Defaults to the repo root; ingestion only reads
# `Builder/` subtree (policies, procedures, forms, appendices).
IA_CORPUS_ROOT=.

# If true, the index build ABORTS when Ollama embeddings are
# unavailable. If false (default), the build falls back to a
# lexical-only BM25 index and logs a warning.
IA_REQUIRE_EMBEDDINGS=false

# Ollama endpoint + model selection. Swap at will without code changes.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000

# ───────────────────────────────────────────────────────────────
# Demo Auth (AWS Cognito + SES + DynamoDB)
# Backend (server + lambda-compatible env names)
# ───────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
APP_BASE_URL=http://localhost:5173
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
FROM_EMAIL=no-reply@careindeed.com
REGISTRATION_TABLE_NAME=demo_auth_registrations
SETUP_TOKEN_TTL_MINUTES=60
AUTO_APPROVED_DOMAIN=careindeed.com
DEMO_AUTH_DEBUG=false

# Frontend auth API base.
# Local Express: /api/auth
# Deployed API Gateway: https://<api-id>.execute-api.<region>.amazonaws.com/auth
VITE_AUTH_API_BASE_URL=/api/auth

# ───────────────────────────────────────────────────────────────
# Evidence storage — environment-mode boundary
# ───────────────────────────────────────────────────────────────
# Controls which adapter `src/policy/evidence/storageMode.ts` selects.
#   local-demo   → IndexedDB / per-tab cache (current behaviour, default).
#   aws-staging  → presigned PUT/GET against the API Gateway in
#                  infra/aws-staging. NEVER use 'aws-staging' from a
#                  client without VITE_AWS_API_BASE_URL set.
VITE_EVIDENCE_STORAGE_MODE=local-demo

# AWS staging API endpoint (output of infra/aws-staging/05-apigateway.sh).
# Leave blank in local/demo mode.
VITE_AWS_API_BASE_URL=
VITE_AWS_REGION=us-west-1

# ───────────────────────────────────────────────────────────────
# AWS staging deploy variables (read by infra/aws-staging/*.sh).
# Not used by the web app — only the deploy scripts.
# ───────────────────────────────────────────────────────────────
HHC_ENV=staging
HHC_BUDGET_EMAIL=
# Optional: web origin allowed in S3 CORS + API Gateway CORS.
HHC_WEB_ORIGIN=http://localhost:5173
# Filled in by 01-buckets.sh / 02-dynamodb.sh after deploy.
HHC_S3_BUCKET=
HHC_DDB_TABLE=
