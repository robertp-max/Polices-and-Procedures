# ───────────────────────────────────────────────────────────────
# Regulatory Planner — Google Calendar Integration
# Copy this file to `.env` (at repo root) and fill in values.
# `.env` is gitignored — never commit real values.
# ───────────────────────────────────────────────────────────────

# Absolute or repo-relative path to the service-account JSON key.
# Default: ./server/credentials/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./server/credentials/service-account.json

# Target calendar. This is the calendar the service account has been
# granted "Make changes to events" on.
GOOGLE_CALENDAR_ID=c_e486af964106461821405ec832fecc5362587dc4468d2c487aed5b9af76795e5@group.calendar.google.com

# Default IANA timezone used when events do not specify one.
DEFAULT_TIMEZONE=America/Los_Angeles

# Express API port.
PORT=8787

# Dev-only: the Vite origin allowed to call the API.
# Production deploys should set this to the real web origin.
ALLOWED_ORIGIN=http://localhost:5173

# Optional: bearer token required on every /api/calendar/* call.
# Leave blank for local dev. Set a strong value for shared environments.
API_SHARED_SECRET=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ───────────────────────────────────────────────────────────────
# Compliance Intelligence (iAdministrator) — local RAG engine.
# All defaults work out of the box for a local Ollama install at
# 127.0.0.1:11434. No external services are required.
# ───────────────────────────────────────────────────────────────

# Where the local index is persisted (JSON vectors + metadata).
# Default: ./.cache/ia-index  (gitignored)
IA_INDEX_ROOT=.cache/ia-index

# Corpus root. Defaults to the repo root; ingestion only reads
# `Builder/` subtree (policies, procedures, forms, appendices).
IA_CORPUS_ROOT=.

# If true, the index build ABORTS when Ollama embeddings are
# unavailable. If false (default), the build falls back to a
# lexical-only BM25 index and logs a warning.
IA_REQUIRE_EMBEDDINGS=false

# Ollama endpoint + model selection. Swap at will without code changes.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000
