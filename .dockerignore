# Build-context exclusions for the Cloud Run web-tier image.
# Goal: ship only what the Vite SPA build needs; never leak secrets or bloat.

# Dependencies & build outputs (rebuilt inside the image)
node_modules
**/node_modules
dist
.cache

# Version control
.git
.gitignore

# Secrets & local env (NEVER copy into the build context)
.env
.env.*
**/*service-account*.json
**/*credentials*.json
**/*.private.json
server/credentials

# server/ IS included — the combined image (Dockerfile.server) runs the Express
# API from it. The web-tier Dockerfile ignores it anyway (its runtime copies
# only dist). Secrets under server/credentials stay excluded (above).
infra
migrations

# Editor / agent / CI metadata
.vscode
.cursor
.agents
.github

# Heavy or irrelevant local content (mirrors .vercelignore)
Bin-(thrash)
Project_Intelligence
REVIEW_OUTPUTS
# Generated scratch outputs (may contain PHI extractions/PDFs) — never copy
output
outputs
**/mock_assessments
**/screenshots
**/uat-results
**/uat-html-report
**/downloads
*.docx
*.xlsx
*.pptx
*.mov
*.mp4
*.mp3

# Scratch, logs, manifests, temp files
*.log
*.pid
*.err
npm-run-*
tmp_*
tmp-*
temp-*
build*.log
tsc-*.log
dev-*.log
*_MANIFEST.txt
DELETE_LIST.txt

# Docker / deploy meta (not needed inside the build)
Dockerfile
.dockerignore
