{
  "name": "ci-policy-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "predev:web": "node scripts/cleanEmittedJs.mjs && node scripts/syncMasterControlInventory.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "prebuild": "node scripts/cleanEmittedJs.mjs && node scripts/syncMasterControlInventory.mjs",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "check:designless": "node scripts/check-designless.mjs",
    "verify:designless": "npm run build && node scripts/check-designless.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gao:tts:freeze": "node scripts/generateGaoTtsSourceManifest.mjs --write",
    "gao:tts:verify": "node scripts/generateGaoTtsSourceManifest.mjs --check",
    "test:threads": "vitest run src/policy/help-center/threads",
    "test:audit-firestore-emulator": "node scripts/auditFirestoreEmulator.mjs",
    "test:e2e": "playwright test",
    "test:server-unit": "vitest run --config vitest.server.config.ts",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:journey": "playwright test --config playwright.journey.config.ts",
    "check:packet-coverage": "tsx --tsconfig tsconfig.app.json scripts/reportPacketCoverage.ts",
    "test:packets": "vitest run server/packets src/policy/packets src/v6/screens/packets",
    "preview": "vite preview",
    "sync:master-control-inventory": "node scripts/syncMasterControlInventory.mjs",
    "build:master-controls": "tsx scripts/buildMasterControls.ts",
    "build:brad-intakes": "tsx --tsconfig tsconfig.app.json scripts/buildBradMandatedEventIntakes.ts",
    "ia:index": "tsx server/cli/build-index.ts",
    "ia:health": "node -e \"fetch('http://127.0.0.1:8787/api/ia/health').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\"",
    "push-events": "tsx scripts/pushAllEvents.ts",
    "cleanup-duplicates": "tsx scripts/cleanupDuplicates.ts",
    "cleanup-duplicates:apply": "tsx scripts/cleanupDuplicates.ts --apply",
    "compile:workflows": "tsx scripts/compileWorkflows.ts",
    "verify:alignment": "tsx scripts/verifyAlignment.ts",
    "verify:pm-unified": "tsx scripts/verifyUnifiedTaskProjection.ts",
    "verify:task-identity": "tsx --tsconfig tsconfig.app.json scripts/verifyTaskIdentity.ts",
    "verify:identity-sync": "tsx --tsconfig tsconfig.app.json scripts/verifyIdentitySync.ts",
    "verify:required-forms": "tsx --tsconfig tsconfig.app.json scripts/verifyRequiredForms.ts",
    "verify:q1-ces-readiness": "tsx --tsconfig tsconfig.app.json scripts/verifyQ1CesReadiness.ts",
    "verify:calendar-keys": "node scripts/checkCalendarTaskKeys.mjs",
    "verify:ui": "tsx --tsconfig tsconfig.app.json scripts/verifyUiDesignSystem.ts",
    "verify:v3-pre-rollout": "tsx --tsconfig tsconfig.app.json scripts/verifyV3PreRollout.ts",
    "verify:brad-scenario": "tsx --tsconfig tsconfig.app.json scripts/verifyBradScenarioActionLayer.ts",
    "verify:brad-protection": "tsx --tsconfig tsconfig.app.json scripts/verifyBradOssProtection.ts",
    "verify:surface-protection": "tsx scripts/verifySurfaceProtection.ts",
    "controls:generate": "tsx --tsconfig tsconfig.app.json scripts/generateControlRegistry.ts",
    "controls:verify": "tsx scripts/verifyControlRegistry.ts",
    "verify:brad-home": "tsx --tsconfig tsconfig.app.json scripts/verifyBradDefaultHomeNav.ts",
    "verify:brad-builder": "tsx scripts/verifyBradBuilder.ts",
    "verify:brad-chat": "tsx scripts/verifyBradChatNoHarness.ts",
    "verify:brad-upload-bridge": "tsx scripts/verifyBradUploadSnapshotBridge.ts",
    "verify:brad-critical": "tsx scripts/verifyBradCriticalIncidentRouting.ts",
    "verify:brad-refs": "tsx --tsconfig tsconfig.app.json scripts/verifyBradReferenceResolver.ts",
    "verify:brad-trauma": "tsx scripts/verifyBradTraumaResponse.ts",
    "verify:brad-harassment": "tsx scripts/verifyBradSexualHarassmentResponse.ts",
    "verify:brad-forms": "tsx --tsconfig tsconfig.app.json scripts/verifyBradFormRendering.ts",
    "verify:brad-guided": "tsx --tsconfig tsconfig.app.json scripts/verifyBradGuidedAssistance.ts",
    "verify:drive-lock": "tsx scripts/verifyDriveEvidenceLock.ts",
    "validate:event-dataflow": "tsx --tsconfig tsconfig.app.json scripts/validateEventDataflow.ts",
    "validate:references": "tsx --tsconfig tsconfig.app.json scripts/validateReferenceIntegrity.ts",
    "validate:signer-hierarchy-ecign": "tsx --tsconfig tsconfig.app.json Builder/_system/audit-signer-hierarchy-and-ecign-task-mapping.ts",
    "validate:ecign-consent-signature": "tsx --tsconfig tsconfig.app.json Builder/_system/audit-ecign-consent-signature-profile-and-permission.ts",
    "check:evidence-phase01": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase01.ts",
    "check:evidence-phase15": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase15.ts",
    "check:evidence-phase2": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase2.ts",
    "check:evidence-phase21": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase21.ts",
    "check:evidence-phase22": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase22.ts",
    "check:evidence-phase23": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase23.ts",
    "check:evidence-phase235": "tsx --tsconfig tsconfig.app.json scripts/checkEvidencePhase235.ts",
    "check:evidence-intake": "tsx --tsconfig tsconfig.app.json scripts/checkEvidenceIntakeDomain.ts",
    "check:evidence-intake-service": "tsx --tsconfig tsconfig.app.json scripts/checkEvidenceIntakeService.ts",
    "check:evidence-intake-nav": "tsx --tsconfig tsconfig.app.json scripts/checkEvidenceIntakeNav.ts",
    "test:evidence": "npm run check:evidence-intake && npm run check:evidence-intake-service && npm run check:evidence-intake-nav",
    "check:ecign-routes": "tsx scripts/checkEcignRouteHealth.ts",
    "check:ecign-demo-local": "tsx --tsconfig tsconfig.app.json scripts/checkEcignDemoLocal.ts",
    "validate:aws-ces-mapping": "tsx scripts/validateAwsCesMapping.ts",
    "validate:google-drive-evidence": "tsx Builder/_system/audit-google-calendar-drive-evidence-sync.ts",
    "validate:ces-no-localstorage": "tsx Builder/_system/audit-ces-no-localstorage.ts",
    "validate:google-drive-ces-evidence": "tsx Builder/_system/audit-google-drive-ces-evidence-storage.ts",
    "push-hubstaff": "tsx scripts/pushToHubstaff.ts",
    "seed:deeb": "tsx scripts/seedDeeb.ts",
    "forms:build": "tsx scripts/formsSystemBuild.ts",
    "cdk:auth:synth": "npm --prefix infra/demo-auth-cdk run synth",
    "cdk:auth:deploy": "npm --prefix infra/demo-auth-cdk run deploy",
    "cdk:frontend:install": "npm --prefix infra/frontend-cdk install",
    "cdk:frontend:synth": "npm --prefix infra/frontend-cdk run synth",
    "cdk:frontend:deploy:staging": "npm --prefix infra/frontend-cdk run deploy:staging",
    "cdk:frontend:deploy:prod": "npm --prefix infra/frontend-cdk run deploy:prod",
    "cdk:frontend:diff:staging": "npm --prefix infra/frontend-cdk run diff:staging",
    "cdk:frontend:diff:prod": "npm --prefix infra/frontend-cdk run diff:prod",
    "cdk:ces-api:install": "npm --prefix infra/ces-api-cdk install",
    "cdk:ces-api:synth": "npm --prefix infra/ces-api-cdk run synth",
    "cdk:ces-api:diff": "npm --prefix infra/ces-api-cdk run diff",
    "cdk:ces-api:deploy:staging": "npm --prefix infra/ces-api-cdk run deploy:staging"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.922.0",
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-ses": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.42.0",
    "googleapis": "^144.0.0",
    "gradflow": "^0.1.0",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.1",
    "connect-history-api-fallback": "^2.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.51.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  }
}
