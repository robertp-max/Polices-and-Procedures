#!/usr/bin/env bash
# =============================================================================
# ANTI-WIPE GUARDRAIL (git-level, Layer 2)  —  pre-push hook
# -----------------------------------------------------------------------------
# Rejects a NON-FAST-FORWARD (force) push or a DELETION of a protected branch on
# origin — i.e. anything that would rewrite or remove shared history. Normal
# pushes (new branch, fast-forward) pass through untouched.
#
# Activated via:  git config core.hooksPath .githooks
# Override:       GUARDRAIL_ALLOW_DESTRUCTIVE_GIT=1
# stdin lines:    <local-ref> <local-oid> <remote-ref> <remote-oid>
# =============================================================================
[ "${GUARDRAIL_ALLOW_DESTRUCTIVE_GIT:-}" = "1" ] && exit 0

iszero() { case "$1" in ''|*[!0]*) return 1 ;; *) return 0 ;; esac; }

is_protected() {
  case "$1" in
    refs/heads/main|refs/heads/def2-alpha-admission-pagination) return 0 ;;
    refs/heads/checkpoint/*|refs/heads/safety/*|refs/heads/backup/*|refs/heads/evidence*) return 0 ;;
    *) return 1 ;;
  esac
}

status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  is_protected "$remote_ref" || continue
  iszero "$remote_oid" && continue   # creating the branch on the remote — fine
  if iszero "$local_oid"; then
    echo "GUARDRAIL: refusing to DELETE remote protected ref $remote_ref. Override: GUARDRAIL_ALLOW_DESTRUCTIVE_GIT=1" >&2
    status=1; continue
  fi
  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    echo "GUARDRAIL: refusing NON-FAST-FORWARD (force) push to protected $remote_ref — would rewrite remote history. Override: GUARDRAIL_ALLOW_DESTRUCTIVE_GIT=1" >&2
    status=1
  fi
done
exit $status
