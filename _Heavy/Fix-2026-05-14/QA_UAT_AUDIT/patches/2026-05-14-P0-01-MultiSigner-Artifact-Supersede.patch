# Patch: P0-01 - Multi-Signer eCign Artifact Identity & Supersede Chain
# Date: 2026-05-14
# Severity: P0 Blocker
# Root Cause Location: src/policy/components/FormSigningWorkspace.tsx (finalizeSigning)
# Related Finding: P0-01 in QA_UAT_FINDINGS_REGISTER.md

# Description:
# Subsequent signers (e.g. DON after DON Assistant) currently do a manual
# removeEvidence + fresh uploadEvidence. This produces a new unrelated EV- ID
# every time, breaking the single canonical artifact requirement for a
# canonicalFormInstanceId. The store already has a proper supersedeEvidence
# method that maintains version, supersedesEvidenceId, and proper audit events.
# This patch switches the subsequent signer path to use supersedeEvidence.

diff --git a/src/policy/components/FormSigningWorkspace.tsx b/src/policy/components/FormSigningWorkspace.tsx
index 8f4c2a1..c9e7f3b 100644
--- a/src/policy/components/FormSigningWorkspace.tsx
+++ b/src/policy/components/FormSigningWorkspace.tsx
@@ -1514,26 +1514,42 @@ export default function FormSigningWorkspace({ ... }: Props) {
     const isSubsequentSigner = (signerIndex > 1 && totalSigners > 1) || hasExistingSignedPackage;

-    // For subsequent signers, supersede existing evidence; for first signer, upload fresh.
+    // For subsequent signers use the proper supersedeEvidence mechanism so that
+    // we maintain a single canonical artifact identity (with version/supersede linkage)
+    // for the canonicalFormInstanceId. This is critical for Evidence Center,
+    // Audit Trail, and Artifact Viewer traceability.
     let signedPackageArtifactId: string;
     let signedFormInstanceArtifactId: string | undefined;

     if (isSubsequentSigner) {
-      const aliases = [hhcEventId, ...(exec.eventInstanceIdsBySourceEventId[hhcEventId] ?? [])];
-      const allDocs = aliases.flatMap(alias => exec.evidence[alias] ?? []);
-      const priorArtifacts = allDocs.filter(d =>
-        d.linkedFormInstanceId === canonicalFormInstanceId
-        && ['signed_package', 'signed_form_instance'].includes(d.artifactType || '')
-        && d.status !== 'SUPERSEDED',
-      );
-      for (const prior of priorArtifacts) {
-        exec.removeEvidence(hhcEventId, prior.id);
-      }
+      // Find the current active (non-superseded) signed package for this form instance
+      const current = (exec.evidence[hhcEventId] ?? []).find(e =>
+        e.linkedFormInstanceId === canonicalFormInstanceId &&
+        e.artifactType === 'signed_package' &&
+        !['SUPERSEDED', 'RETAINED'].includes(e.status ?? '')
+      );

-      const versionedMeta = {
-        ...commonArtifactMeta,
-        artifactVersion: `${formVersion}-s${signerIndex}`,
-        note: `signer_index=${signerIndex};total_signers=${totalSigners};canonical_form_instance_id=${canonicalFormInstanceId};ecign_session_id=${instance?.instance_id ?? ''}`,
-      };
+      if (current) {
+        signedPackageArtifactId = exec.supersedeEvidence(
+          hhcEventId,
+          current.id,
+          {
+            name: `${formId}-${canonicalFormInstanceId}-signed-package.html`,
+            kind: 'signed_package',
+            sizeLabel: `${Math.round(packetPdfDataUrl.length / 1024)} KB`,
+            linkedFormInstanceId: canonicalFormInstanceId,
+            localDataUrl: packetPdfDataUrl,
+            note: `signer_index=${signerIndex};total_signers=${totalSigners};signed_by=${signer.role}`,
+          },
+          actorLabel
+        );
+      } else {
+        // Rare fallback - treat as first signer
+        signedPackageArtifactId = exec.uploadEvidence(hhcEventId, {
+          ...commonArtifactMeta,
+          name: `${formId}-${canonicalFormInstanceId}-signed-package.html`,
+          kind: 'signed_package',
+          sizeLabel: `${Math.round(packetPdfDataUrl.length / 1024)} KB`,
+          artifactType: 'signed_package',
+          localDataUrl: packetPdfDataUrl,
+        }, actorLabel);
+      }

-      signedPackageArtifactId = exec.uploadEvidence(hhcEventId, {
-        ...versionedMeta,
-        name: `${formId}-${canonicalFormInstanceId}-signed-package-v${signerIndex}.html`,
-        kind: 'signed_package',
-        sizeLabel: `${Math.round(packetPdfDataUrl.length / 1024)} KB`,
-        artifactType: 'signed_package',
-        localDataUrl: packetPdfDataUrl,
-      }, actorLabel);
+      // Update the corresponding signer task status
       const signerTasks = exec.signerTasksByFormInstanceId?.[canonicalFormInstanceId] ?? [];
       const myTask = signerTasks.find(t => t.signerIndex === signerIndex && t.status !== 'signed');
       if (myTask) {
         exec.updateSignerTaskStatus(canonicalFormInstanceId, myTask.taskId, 'signed');
       }
     } else {
       signedPackageArtifactId = exec.uploadEvidence(hhcEventId, {
         ...commonArtifactMeta,
         name: `${formId}-${canonicalFormInstanceId}-signed-package.html`,
         kind: 'signed_package',
         sizeLabel: `${Math.round(packetPdfDataUrl.length / 1024)} KB`,
         artifactType: 'signed_package',
         note: `artifact_type=signed_package;canonical_form_instance_id=${canonicalFormInstanceId};ecign_session_id=${instance?.instance_id ?? ''}`,
         localDataUrl: packetPdfDataUrl,
       }, actorLabel);

       signedFormInstanceArtifactId = undefined;
     }

     if (!signedPackageArtifactId) {
       return;
     }

     // ... (rest of stash + createdArtifactsRef remains the same)

-    exec.appendTaskAuditEvent(hhcEventId, 'evidence', signedPackageArtifactId, 'SIGNED_PACKAGE_CREATED', {
-      after: { artifactType: 'signed_package', canonicalFormInstanceId, ecignSessionId: instance?.instance_id },
-    });
-    exec.appendTaskAuditEvent(hhcEventId, 'evidence', signedPackageArtifactId, 'ARTIFACT_LOCKED', {
-      after: { artifactType: 'signed_package', canonicalFormInstanceId, lockedAt: finalizedAt },
-    });
+    // Always emit clean top-level targetKind + targetId so AuditModePage and
+    // artifactRouteForAuditEntry can resolve links without falling back to 'after' inspection.
+    exec.appendTaskAuditEvent(hhcEventId, 'evidence', signedPackageArtifactId, 'SIGNED_PACKAGE_CREATED', {
+      targetKind: 'evidence',
+      targetId: signedPackageArtifactId,
+      reason: `Signed by ${signer.role} (signer #${signerIndex} of ${totalSigners})`,
+      after: { canonicalFormInstanceId, ecignSessionId: instance?.instance_id },
+    });
+    exec.appendTaskAuditEvent(hhcEventId, 'evidence', signedPackageArtifactId, 'ARTIFACT_LOCKED', {
+      targetKind: 'evidence',
+      targetId: signedPackageArtifactId,
+      reason: `Artifact locked after final signature (signer #${signerIndex})`,
+      after: { canonicalFormInstanceId, lockedAt: finalizedAt },
+    });

     // ... (rest of appendExecutionAudit calls can stay or be enhanced similarly)
```

# Additional One-Time Cleanup Recommendation
# After applying the above, also update the two appendTaskAuditEvent calls
# that currently only put data in `after` to include:
#   targetKind: 'evidence',
#   targetId: signedPackageArtifactId,
# for better audit trail link reliability going forward.

# Testing: Run the manual Test 2 (DON Assistant → DON) defined in QA_UAT_TEST_PLAN.md
