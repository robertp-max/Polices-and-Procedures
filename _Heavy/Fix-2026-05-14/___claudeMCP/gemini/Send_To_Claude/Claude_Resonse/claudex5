  const toggleExpand = (id: string) => {
    setExpandedIds(prev => {
      const next = new Set(prev);
      next.has(id) ? next.delete(id) : next.add(id);
      return next;
    });
  };

  // Recursive folder renderer
  const renderFolder = (node: FolderNode, indentLevel: number) => {
    const isExpanded = expandedIds.has(node.id);
    const hasChildren = (node.children && node.children.length > 0) || (node.files && node.files.length > 0);
    const indent = indentLevel * 24;

    return (
      <div key={node.id}>
        {/* Folder row */}
        <div
          onClick={() => hasChildren && toggleExpand(node.id)}
          style={{
            display: 'flex', alignItems: 'center', gap: 10,
            padding: '8px 12px', paddingLeft: 12 + indent,
            cursor: hasChildren ? 'pointer' : 'default',
