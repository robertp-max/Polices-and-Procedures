// ================================================================
// V3PageWrapper.tsx — CSS-only page transition wrapper
// No framer-motion dependency. Uses v3-tokens.css @keyframes.
// Wrap every route's root JSX with this to get the 0.7s transition.
// ================================================================

import React, { useEffect, useRef, useState } from 'react';
import { useLocation } from 'react-router-dom';

interface V3PageWrapperProps {
  children: React.ReactNode;
  className?: string;
}

/**
 * Wraps a route's content. On mount (route change), triggers the
 * v3PageIn animation (0.7s, cubic-bezier(0.16, 1, 0.3, 1), scale + blur + opacity).
 *
 * Usage:
 *   <V3PageWrapper>
 *     <YourPageContent />
 *   </V3PageWrapper>
 */
export const V3PageWrapper: React.FC<V3PageWrapperProps> = ({ children, className = '' }) => {
  const location = useLocation();
  const [animKey, setAnimKey] = useState(0);

  useEffect(() => {
    // Re-trigger animation on route change
    setAnimKey(prev => prev + 1);
  }, [location.pathname]);

  return (
    <div
      key={animKey}
      className={`v3-page-animate ${className}`}
      style={{ width: '100%', minHeight: '100%' }}
    >
      {children}
    </div>
  );
};

/**
 * For sub-view transitions (tab changes, toggle switches).
 * Re-animates when `viewKey` changes.
 */
export const V3SubView: React.FC<{ viewKey: string; children: React.ReactNode; className?: string }> = ({
  viewKey,
  children,
  className = '',
}) => (
  <div
    key={viewKey}
    className={`v3-subview-animate ${className}`}
    style={{ width: '100%' }}
  >
    {children}
  </div>
);

