// Helper: flatten all routes for React Router registration
export function flattenRoutes(items: NavItem[]): Array<{ path: string; component: string }> {
  const routes: Array<{ path: string; component: string }> = [];
  for (const item of items) {
    routes.push({ path: item.route, component: item.component });
    if (item.children) {
      routes.push(...flattenRoutes(item.children));
    }
  }
  return routes;
}

// Helper: find active nav item by current path
export function findActiveNavItem(path: string, items: NavItem[] = NAV_CONFIG): NavItem | null {
  for (const item of items) {
    if (item.children) {
      const child = findActiveNavItem(path, item.children);
      if (child) return child;
    }
    // Exact match or pattern match for parameterized routes
    const pattern = item.route.replace(/:[^/]+/g, '[^/]+');
    if (new RegExp(`^${pattern}$`).test(path)) return item;
  }
  return null;
}

Maintenance Protocol
All navigation changes go through navConfig.ts — no hardcoded routes in components
Breadcrumbs auto-generate from the nav tree by walking the parent chain
Route registration uses flattenRoutes() to generate React Router <Route> elements
Status field gates feature visibility: phase-2 items render as disabled with a "Coming Soon" tooltip; phase-3 items are hidden entirely
Adding a new page: Add one entry to NAV_CONFIG → route auto-registers → sidebar auto-renders → breadcrumb auto-populates
PR reviews must verify that any new route exists in navConfig.ts
Part 2: Full V3 Veil Glass Design System Documentation
2.1 Design Philosophy

V3 Veil Glass is a seamless matte slate-carbon theme built on the principle of subtractive design — every element must earn its presence. The system produces interfaces that feel like expensive dark stationery in a quiet room: calm, authoritative, and restrained.

Core Tenets:

Invisible by default — surfaces are transparent until interaction demands they emerge
Color is information — teal and orange are semantic signals, not decoration
Depth through subtlety — glass blur and border opacity create hierarchy, not drop shadows
Motion is narrative — transitions tell the user where they are and where they came from
