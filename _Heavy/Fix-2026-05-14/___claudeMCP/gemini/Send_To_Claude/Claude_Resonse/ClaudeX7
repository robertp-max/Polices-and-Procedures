                color: V3.textTertiary, padding: '8px 0', textTransform: 'uppercase', letterSpacing: '0.5px',
              }}>{d}</div>
            ))}
          </div>
          {/* Day Cells */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '2px' }}>
            {cells.map((day, idx) => {
              if (day === null) return <div key={`empty-${idx}`} />;
              const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
              const dayEvents = getEventsForDay(day);
              const isSelected = selectedDate === dateStr;
              const isToday = day === 19 && currentMonth === 4 && currentYear === 2026;

              return (
                <button
                  key={day}
                  onClick={() => setSelectedDate(dateStr)}
                  style={{
                    minHeight: '80px', padding: '6px', borderRadius: '8px', cursor: 'pointer',
                    border: isSelected ? `1px solid ${V3.tealLight}` : `1px solid transparent`,
                    background: isSelected ? 'rgba(0,209,193,0.05)' : 'transparent',
                    display: 'flex', flexDirection: 'column', gap: '4px',
                    transition: 'all 0.2s', textAlign: 'left',
                  }}
                  onMouseEnter={(e) => { if (!isSelected) e.currentTarget.style.background = V3.glass2; }}
                  onMouseLeave={(e) => { if (!isSelected) e.currentTarget.style.background = 'transparent'; }}
                >
                  <span style={{
                    fontSize: '13px', fontWeight: isToday ? 700 : 500,
                    color: isToday ? V3.tealLight : V3.textPrimary,
                    width: '24px', height: '24px', borderRadius: '50%',
                    display: 'flex', alignItems: 'center', justifyContent: 'center',
                    background: isToday ? 'rgba(0,209,193,0.15)' : 'transparent',
                  }}>{day}</span>
                  {dayEvents.slice(0, 2).map(ev => {
