          <ChevronLeft size={18} />
        </button>
        <h2 style={{ fontSize: '18px', fontWeight: 600, margin: 0 }}>{MONTHS[currentMonth]} {currentYear}</h2>
        <button onClick={nextMonth} style={{ background: 'transparent', border: `1px solid ${V3.borderDefault}`, borderRadius: '8px', padding: '8px', cursor: 'pointer', color: V3.textSecondary }}>
          <ChevronRight size={18} />
        </button>
      </div>

