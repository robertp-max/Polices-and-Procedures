  const [expandedIds, setExpandedIds] = useState<Set<string>>(new Set(['Y-2026', 'Q2-2026', 'M-05', 'EVT-001']));
  const [selectedFile, setSelectedFile] = useState<EvidenceFile | null>(null);

  const toggleExpand = (id: string) => {
    setExpandedIds(prev => {
      const next = new Set(prev);
      next.has(id) ? next.delete(id) : next.add(id);
      return next;
    });
  };

  // Recursive folder renderer
  const renderFolder = (node: FolderNode, indentLevel: number) => {
    const isExpanded = expandedIds.has(node.id);
    const hasChildren = (node.children && node.children.length > 0) || (node.files && node.files.length > 0);
    const indent = indentLevel * 24;

    return (
      <div key={node.id}>
        {/* Folder row */}
        <div
          onClick={() => hasChildren && toggleExpand(node.id)}
          style={{
            display: 'flex', alignItems: 'center', gap: 10,
            padding: '8px 12px', paddingLeft: 12 + indent,
            cursor: hasChildren ? 'pointer' : 'default',
            borderRadius: 8,
            transition: 'background 0.2s ease',
            background: isExpanded ? 'rgba(255,255,255,0.02)' : 'transparent',
          }}
          onMouseEnter={e => (e.currentTarget.style.background = 'rgba(255,255,255,0.03)')}
          onMouseLeave={e => (e.currentTarget.style.background = isExpanded ? 'rgba(255,255,255,0.02)' : 'transparent')}
        >
          {/* Expand arrow */}
          {hasChildren && (
            <span style={{ fontSize: 12, color: V3.textTertiary, transform: isExpanded ? 'rotate(90deg)' : 'rotate(0)', transition: 'transform 0.2s ease', display: 'inline-block', width: 12 }}>▸</span>
          )}
          {!hasChildren && <span style={{ width: 12 }} />}

          {/* Folder icon with completion ring */}
          <FolderIcon pct={node.completionPct} depth={node.depth} />

          {/* Label */}
          <div style={{ flex: 1 }}>
            <div style={{ color: V3.textPrimary, fontSize: 13, fontWeight: node.depth === 'year' || node.depth === 'quarter' ? 600 : 500 }}>
              {node.label}
            </div>
            <div style={{ color: V3.textTertiary, fontSize: 11, marginTop: 1 }}>
              {node.totalItems} items
            </div>
          </div>

          {/* Completion % badge */}
          <span style={{
            fontSize: 11, fontWeight: 600, padding: '2px 8px', borderRadius: 6,
            color: node.completionPct === 100 ? '#4ADE80' : node.completionPct >= 75 ? V3.tealLight : node.completionPct >= 50 ? '#FBBF24' : '#F87171',
            background: node.completionPct === 100 ? 'rgba(74, 222, 128, 0.1)' : node.completionPct >= 75 ? 'rgba(0, 209, 193, 0.1)' : node.completionPct >= 50 ? 'rgba(251, 191, 36, 0.1)' : 'rgba(248, 113, 113, 0.1)',
          }}>
            {node.completionPct}%
          </span>
        </div>

        {/* Children */}
        {isExpanded && node.children && node.children.map(child => renderFolder(child, indentLevel + 1))}

        {/* Files (leaf level) */}
        {isExpanded && node.files && node.files.map(file => {
          const badge = statusBadge(file.status);
          return (
            <div
              key={file.id}
              onClick={() => setSelectedFile(file)}
              style={{
                display: 'flex', alignItems: 'center', gap: 10,
                padding: '6px 12px', paddingLeft: 12 + indent + 24 + 12,
                cursor: 'pointer', borderRadius: 6,
                transition: 'background 0.15s ease',
                background: selectedFile?.id === file.id ? 'rgba(0, 209, 193, 0.06)' : 'transparent',
              }}
              onMouseEnter={e => { if (selectedFile?.id !== file.id) e.currentTarget.style.background = 'rgba(255,255,255,0.02)'; }}
              onMouseLeave={e => { if (selectedFile?.id !== file.id) e.currentTarget.style.background = 'transparent'; }}
            >
              <FileIcon type={file.artifactType} />
              <div style={{ flex: 1 }}>
                <div style={{ color: file.status === 'missing' ? V3.textTertiary : V3.textSecondary, fontSize: 12, fontWeight: 400, fontStyle: file.status === 'missing' ? 'italic' : 'normal' }}>
                  {file.name}
                </div>
              </div>
              <span style={{ fontSize: 10, padding: '2px 7px', borderRadius: 4, background: badge.bg, color: badge.color, fontWeight: 500 }}>
                {badge.label}
              </span>
              {file.size !== '—' && <span style={{ color: V3.textTertiary, fontSize: 10, width: 50, textAlign: 'right' }}>{file.size}</span>}
            </div>
          );
        })}
      </div>
    );
  };

  // Stats
  const allFiles = TREE.flatMap(function collectFiles(n: FolderNode): EvidenceFile[] {
    return [...(n.files || []), ...(n.children || []).flatMap(collectFiles)];
  });
  const stats = {
    total: allFiles.length,
    verified: allFiles.filter(f => f.status === 'verified').length,
    pending: allFiles.filter(f => f.status === 'pending').length,
    missing: allFiles.filter(f => f.status === 'missing').length,
  };

  return (
    <div className="v3-page-animate" style={{ padding: 24, display: 'flex', gap: 20 }}>
      {/* Left: Hierarchy tree */}
      <div style={{ flex: 1 }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 }}>
