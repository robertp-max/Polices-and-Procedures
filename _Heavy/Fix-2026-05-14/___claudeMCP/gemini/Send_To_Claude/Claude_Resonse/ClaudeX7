        d.name.toLowerCase().includes(search.toLowerCase()) ||
        d.subdomains.some(sd =>
          sd.name.toLowerCase().includes(search.toLowerCase()) ||
          sd.policies.some(p => p.title.toLowerCase().includes(search.toLowerCase()) || p.id.toLowerCase().includes(search.toLowerCase()))
