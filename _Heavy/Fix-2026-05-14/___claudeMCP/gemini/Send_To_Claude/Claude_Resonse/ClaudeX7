            <p style={{ color: V3.textTertiary, fontSize: 12, margin: '4px 0 0' }}>Triplet-enforced: policy_id + workflow_id + event_id</p>
          </div>
          <div style={{ display: 'flex', gap: 4, background: V3.glass2, borderRadius: 8, padding: 3 }}>
            {(['hierarchy', 'audit-ready', 'orphans'] as ViewMode[]).map(m => (
              <button key={m} onClick={() => setViewMode(m)} style={{
                padding: '6px 12px', fontSize: 11, borderRadius: 6, border: 'none', cursor: 'pointer',
                background: viewMode === m ? V3.teal : 'transparent',
                color: viewMode === m ? '#FFF' : V3.textTertiary,
                fontWeight: viewMode === m ? 600 : 400, textTransform: 'capitalize',
              }}>{m.replace('-', ' ')}</button>
            ))}
          </div>
        </div>

        {/* Stats */}
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 12, marginBottom: 20 }}>
          {[
            { label: 'Total', value: stats.total, color: V3.textPrimary },
            { label: 'Verified', value: stats.verified, color: V3.tealLight },
            { label: 'Pending', value: stats.pending, color: '#FBBF24' },
            { label: 'Missing', value: stats.missing, color: '#F87171' },
          ].map((s, i) => (
            <div key={i} style={{ textAlign: 'center', padding: 12 }}>
              <div style={{ fontSize: 22, fontWeight: 600, color: s.color }}>{s.value}</div>
              <div style={{ fontSize: 10, color: V3.textTertiary, marginTop: 2, textTransform: 'uppercase', letterSpacing: '0.06em' }}>{s.label}</div>
            </div>
          ))}
        </div>

        {/* Tree */}
        <div key={viewMode} className="v3-subview-animate" style={{ borderRadius: 12, border: `1px solid ${V3.borderDefault}`, background: V3.glass2, padding: '8px 0' }}>
          {TREE.map(node => renderFolder(node, 0))}
        </div>
      </div>

      {/* Right: Detail panel (when file selected) */}
      {selectedFile && (
        <div style={{ width: 320, flexShrink: 0 }}>
          <div style={{ padding: 20, borderRadius: 12, background: V3.glass2, border: `1px solid ${V3.borderDefault}`, position: 'sticky', top: 24 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
              <span style={{ fontSize: 11, color: V3.tealLight, fontWeight: 600, letterSpacing: '0.06em' }}>EVIDENCE DETAIL</span>
              <button onClick={() => setSelectedFile(null)} style={{ background: 'none', border: 'none', color: V3.textTertiary, cursor: 'pointer', fontSize: 14 }}>✕</button>
            </div>

            <h3 style={{ color: V3.textPrimary, fontSize: 14, fontWeight: 500, margin: '0 0 16px' }}>{selectedFile.name}</h3>

            {[
              { l: 'ID', v: selectedFile.id },
              { l: 'Type', v: selectedFile.artifactType.replace(/_/g, ' ') },
              { l: 'Status', v: selectedFile.status.toUpperCase() },
              { l: 'Uploaded By', v: selectedFile.uploadedBy },
              { l: 'Date', v: selectedFile.uploadedAt },
              { l: 'Size', v: selectedFile.size },
            ].map((row, i) => (
              <div key={i} style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid rgba(255,255,255,0.04)' }}>
                <span style={{ color: V3.textTertiary, fontSize: 11 }}>{row.l}</span>
                <span style={{ color: V3.textSecondary, fontSize: 12 }}>{row.v}</span>
              </div>
            ))}

            <div style={{ marginTop: 16, padding: 12, borderRadius: 8, background: 'rgba(255,255,255,0.02)' }}>
              <div style={{ fontSize: 10, color: V3.textTertiary, fontWeight: 600, letterSpacing: '0.06em', marginBottom: 6 }}>TRIPLET</div>
              <div style={{ fontSize: 11, color: V3.textSecondary, lineHeight: 1.6 }}>
                Policy: <span style={{ color: V3.tealLight }}>{selectedFile.triplet.policyId}</span><br />
                Workflow: <span style={{ color: V3.tealLight }}>{selectedFile.triplet.workflowId}</span><br />
                Event: <span style={{ color: V3.tealLight }}>{selectedFile.triplet.eventId}</span>
              </div>
            </div>

            {selectedFile.hash && (
              <div style={{ marginTop: 12, padding: 10, borderRadius: 8, background: 'rgba(0, 209, 193, 0.06)' }}>
                <div style={{ fontSize: 10, color: V3.textTertiary, fontWeight: 600, letterSpacing: '0.06em', marginBottom: 4 }}>AUDIT TRAIL HASH</div>
                <div style={{ fontSize: 11, color: V3.tealLight, fontFamily: 'monospace', wordBreak: 'break-all' }}>{selectedFile.hash}</div>
              </div>
            )}

            {selectedFile.status !== 'missing' && (
              <div style={{ display: 'flex', gap: 8, marginTop: 16 }}>
                <button style={{ flex: 1, padding: '8px 0', fontSize: 12, borderRadius: 6, background: V3.teal, color: '#FFF', border: 'none', cursor: 'pointer' }}>View</button>
                <button style={{ flex: 1, padding: '8px 0', fontSize: 12, borderRadius: 6, background: V3.glass2, color: V3.textSecondary, border: `1px solid ${V3.borderDefault}`, cursor: 'pointer' }}>Download</button>
              </div>
            )}
          </div>
        </div>
      )}

      <div style={{ position: 'fixed', bottom: 0, left: 0, right: 0, padding: '10px 24px', borderTop: '1px solid rgba(255,255,255,0.06)', color: V3.textTertiary, fontSize: 11, background: 'rgba(5, 6, 10, 0.95)' }}>
        Visual preview only — real Evidence Center uses buildCesEvidenceHierarchy (FROZEN), triplet enforcement, IndexedDB/AWS presigned URLs, and shared VeilDrawer for file preview.
      </div>
    </div>
  );
}

