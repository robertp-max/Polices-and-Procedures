// Gate-based compliance activation. KpiTile, StatusPill, GateTile, UnitDrawer, AuditTimeline.
// Hash-chain verification preview. Reconciliation preview panel.

import React, { useState } from 'react';

const V3 = {
  glass2: 'rgba(255, 255, 255, 0.04)',
  teal: '#007970',
  tealLight: '#00D1C1',
  orange: '#E07B2C',
  textPrimary: '#FFFFFF',
  textSecondary: '#94A3B8',
  textTertiary: '#64748B',
  borderDefault: 'rgba(255, 255, 255, 0.33)',
} as const;

type GateStatus = 'passed' | 'in-progress' | 'locked' | 'failed';
type ViewTab = 'pipeline' | 'activation' | 'audit-trail';

interface Gate {
  num: number; label: string; desc: string; requiredForms: number; requiredSigs: number;
}

interface OnboardingUnit {
  id: string; name: string; role: string; startDate: string;
  currentGate: number; gateStatus: GateStatus; pct: number;
  formsCompleted: number; formsTotal: number;
  sigsComplete: boolean;
  hashChainValid: boolean;
  lastActivity: string;
}

const GATES: Gate[] = [
  { num: 1, label: 'Pre-Employment', desc: 'Background check, offer letter, employment eligibility', requiredForms: 5, requiredSigs: 3 },
  { num: 2, label: 'Orientation', desc: 'Company orientation, policy acknowledgments, safety training', requiredForms: 12, requiredSigs: 8 },
  { num: 3, label: 'Competency', desc: 'Skills checkoff, clinical competency, OSHA/HIPAA cert', requiredForms: 8, requiredSigs: 6 },
  { num: 4, label: 'Field Ready', desc: 'Supervised visit, final sign-off, system access activation', requiredForms: 4, requiredSigs: 4 },
];

const UNITS: OnboardingUnit[] = [
  { id: 'OB-001', name: 'Angela Torres', role: 'Home Health Aide', startDate: '2026-05-13', currentGate: 3, gateStatus: 'in-progress', pct: 68, formsCompleted: 17, formsTotal: 29, sigsComplete: false, hashChainValid: true, lastActivity: '2h ago' },
  { id: 'OB-002', name: 'Kevin Pham', role: 'Registered Nurse', startDate: '2026-05-06', currentGate: 4, gateStatus: 'in-progress', pct: 89, formsCompleted: 26, formsTotal: 29, sigsComplete: false, hashChainValid: true, lastActivity: '30m ago' },
  { id: 'OB-003', name: 'Destiny Williams', role: 'Physical Therapist', startDate: '2026-05-13', currentGate: 2, gateStatus: 'in-progress', pct: 41, formsCompleted: 12, formsTotal: 29, sigsComplete: false, hashChainValid: true, lastActivity: '4h ago' },
  { id: 'OB-004', name: 'Roberto Garcia', role: 'Home Health Aide', startDate: '2026-04-29', currentGate: 4, gateStatus: 'passed', pct: 100, formsCompleted: 29, formsTotal: 29, sigsComplete: true, hashChainValid: true, lastActivity: '2d ago' },
  { id: 'OB-005', name: 'Sarah Kim', role: 'LVN', startDate: '2026-05-20', currentGate: 1, gateStatus: 'in-progress', pct: 12, formsCompleted: 3, formsTotal: 29, sigsComplete: false, hashChainValid: true, lastActivity: '1h ago' },
  { id: 'OB-006', name: 'James Wright', role: 'Home Health Aide', startDate: '2026-05-18', currentGate: 1, gateStatus: 'failed', pct: 8, formsCompleted: 2, formsTotal: 29, sigsComplete: false, hashChainValid: false, lastActivity: '1d ago' },
];

const gateColor = (s: GateStatus) => ({ passed: '#4ADE80', 'in-progress': V3.tealLight, locked: V3.textTertiary, failed: '#F87171' }[s]);

const AUDIT_TRAIL = [
  { time: '2026-05-20 09:14', actor: 'Kevin Pham', action: 'Completed Gate 3 → Competency Assessment signed', hash: 'sha256:4f2a...' },
  { time: '2026-05-20 08:45', actor: 'Angela Torres', action: 'Uploaded OSHA training certificate', hash: 'sha256:8b1c...' },
  { time: '2026-05-19 16:30', actor: 'System', action: 'Roberto Garcia — all gates passed, activation complete', hash: 'sha256:d7e3...' },
  { time: '2026-05-19 14:22', actor: 'Destiny Williams', action: 'Completed 3 orientation acknowledgments', hash: 'sha256:a9f4...' },
  { time: '2026-05-19 11:00', actor: 'System', action: 'James Wright — background check FAILED, gate 1 blocked', hash: 'sha256:c2b5...' },
  { time: '2026-05-18 15:00', actor: 'Sarah Kim', action: 'Employment eligibility form submitted', hash: 'sha256:e6d8...' },
];

export default function V3OnboardingPreview() {
  const [activeView, setActiveView] = useState<ViewTab>('pipeline');
  const [selectedUnit, setSelectedUnit] = useState<string | null>(null);

  const active = UNITS.filter(u => u.pct < 100 && u.gateStatus !== 'failed').length;
  const completed = UNITS.filter(u => u.pct === 100).length;
  const failed = UNITS.filter(u => u.gateStatus === 'failed').length;
  const avgPct = Math.round(UNITS.reduce((s, u) => s + u.pct, 0) / UNITS.length);

  return (
    <div className="v3-page-animate" style={{ padding: 24 }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 20 }}>
        <div>
          <h1 style={{ color: V3.textPrimary, fontSize: 20, fontWeight: 600, margin: 0 }}>Onboarding & Activation</h1>
          <p style={{ color: V3.textTertiary, fontSize: 12, margin: '4px 0 0' }}>{UNITS.length} employees · 4-gate compliance activation · Hash-chain verified</p>
        </div>
        <div style={{ display: 'flex', gap: 4, background: V3.glass2, borderRadius: 8, padding: 3 }}>
          {(['pipeline', 'activation', 'audit-trail'] as ViewTab[]).map(v => (
            <button key={v} onClick={() => setActiveView(v)} style={{
              padding: '6px 14px', fontSize: 12, borderRadius: 6, border: 'none', cursor: 'pointer',
              background: activeView === v ? V3.teal : 'transparent',
              color: activeView === v ? '#FFF' : V3.textTertiary, textTransform: 'capitalize',
            }}>{v.replace('-', ' ')}</button>
          ))}
        </div>
      </div>

      {/* KPIs — borderless */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: 16, marginBottom: 28 }}>
        {[
          { label: 'In Pipeline', value: active, color: V3.tealLight },
          { label: 'Completed', value: completed, color: '#4ADE80' },
          { label: 'Failed', value: failed, color: '#F87171' },
          { label: 'Avg Progress', value: `${avgPct}%`, color: V3.textPrimary },
          { label: 'Sigs Pending', value: UNITS.filter(u => !u.sigsComplete && u.gateStatus !== 'failed').length, color: '#FBBF24' },
        ].map((k, i) => (
          <div key={i} style={{ textAlign: 'center', padding: 12 }}>
            <div style={{ fontSize: 28, fontWeight: 600, color: k.color }}>{k.value}</div>
            <div style={{ fontSize: 10, color: V3.textTertiary, marginTop: 4, textTransform: 'uppercase', letterSpacing: '0.06em' }}>{k.label}</div>
          </div>
        ))}
      </div>

      <div key={activeView} className="v3-subview-animate">
        {(activeView === 'pipeline' || activeView === 'activation') && (
          <>
            {/* Gate pipeline visualization */}
            <div style={{ display: 'flex', gap: 8, marginBottom: 24 }}>
              {GATES.map((gate, gi) => {
                const unitsAtGate = UNITS.filter(u => u.currentGate === gate.num && u.gateStatus !== 'failed');
                return (
                  <React.Fragment key={gate.num}>
                    <div style={{ flex: 1, padding: 16, borderRadius: 12, background: V3.glass2, border: `1px solid ${V3.borderDefault}` }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
                        <span style={{ fontSize: 11, color: V3.tealLight, fontWeight: 600 }}>GATE {gate.num}</span>
                        <span style={{ fontSize: 10, padding: '2px 8px', borderRadius: 10, background: V3.glass2, color: V3.textTertiary }}>{unitsAtGate.length}</span>
                      </div>
                      <div style={{ color: V3.textPrimary, fontSize: 13, fontWeight: 500, marginBottom: 4 }}>{gate.label}</div>
                      <div style={{ color: V3.textTertiary, fontSize: 11, lineHeight: 1.3 }}>{gate.desc}</div>
                      <div style={{ color: V3.textTertiary, fontSize: 10, marginTop: 8 }}>{gate.requiredForms}F · {gate.requiredSigs}S</div>
                    </div>
                    {gi < GATES.length - 1 && (
                      <div style={{ display: 'flex', alignItems: 'center', color: V3.textTertiary, fontSize: 16 }}>→</div>
                    )}
                  </React.Fragment>
                );
              })}
            </div>

            {/* Employee cards */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
              {UNITS.map(unit => (
                <div key={unit.id}
                  onClick={() => setSelectedUnit(selectedUnit === unit.id ? null : unit.id)}
                  style={{
                    padding: 16, borderRadius: 10, background: V3.glass2,
                    border: `1px solid ${unit.gateStatus === 'failed' ? 'rgba(248, 113, 113, 0.2)' : V3.borderDefault}`,
                    cursor: 'pointer', transition: 'all 0.2s ease',
                  }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>
                    <div style={{ flex: 2 }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                        <span style={{ color: V3.textPrimary, fontSize: 14, fontWeight: 500 }}>{unit.name}</span>
                        {!unit.hashChainValid && <span style={{ fontSize: 10, padding: '1px 6px', borderRadius: 4, background: 'rgba(248, 113, 113, 0.12)', color: '#F87171' }}>⚠ CHAIN INVALID</span>}
                      </div>
                      <div style={{ color: V3.textTertiary, fontSize: 12, marginTop: 2 }}>{unit.role} · Started {unit.startDate} · {unit.lastActivity}</div>
                    </div>
                    <div style={{ flex: 1, display: 'flex', alignItems: 'center', gap: 8 }}>
                      <div style={{ height: 4, flex: 1, borderRadius: 2, background: 'rgba(255,255,255,0.06)' }}>
                        <div style={{ height: '100%', borderRadius: 2, width: `${unit.pct}%`, background: unit.pct === 100 ? '#4ADE80' : unit.gateStatus === 'failed' ? '#F87171' : V3.tealLight, transition: 'width 0.5s ease' }} />
                      </div>
                      <span style={{ color: V3.textSecondary, fontSize: 12, fontWeight: 500, minWidth: 36, textAlign: 'right' }}>{unit.pct}%</span>
                    </div>
                    <div style={{ width: 80, textAlign: 'center' }}>
                      <span style={{ fontSize: 11, padding: '3px 10px', borderRadius: 6, background: `${gateColor(unit.gateStatus)}15`, color: gateColor(unit.gateStatus), fontWeight: 500 }}>
                        G{unit.currentGate}
                      </span>
                    </div>
                    <div style={{ width: 90, textAlign: 'center', color: V3.textTertiary, fontSize: 12 }}>{unit.formsCompleted}/{unit.formsTotal}</div>
                  </div>

                  {/* Expanded detail (UnitDrawer pattern) */}
                  {selectedUnit === unit.id && (
                    <div style={{ marginTop: 16, paddingTop: 16, borderTop: '1px solid rgba(255,255,255,0.04)', display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 12 }}>
                      {GATES.map(gate => {
                        const isPassed = unit.currentGate > gate.num || (unit.currentGate === gate.num && unit.gateStatus === 'passed');
                        const isCurrent = unit.currentGate === gate.num && unit.gateStatus !== 'passed';
                        const isFailed = unit.currentGate === gate.num && unit.gateStatus === 'failed';
                        return (
                          <div key={gate.num} style={{
                            padding: 12, borderRadius: 8,
                            background: isPassed ? 'rgba(74, 222, 128, 0.06)' : isFailed ? 'rgba(248, 113, 113, 0.06)' : isCurrent ? 'rgba(0, 209, 193, 0.06)' : 'rgba(255,255,255,0.02)',
                            border: `1px solid ${isPassed ? 'rgba(74, 222, 128, 0.15)' : isFailed ? 'rgba(248, 113, 113, 0.15)' : isCurrent ? 'rgba(0, 209, 193, 0.15)' : 'rgba(255,255,255,0.04)'}`,
                          }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 4 }}>
                              <span style={{ fontSize: 10, color: V3.textTertiary, fontWeight: 600 }}>GATE {gate.num}</span>
                              <span style={{ fontSize: 12 }}>{isPassed ? '✓' : isFailed ? '✕' : isCurrent ? '●' : '○'}</span>
                            </div>
                            <div style={{ color: V3.textSecondary, fontSize: 12 }}>{gate.label}</div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </>
        )}

        {activeView === 'audit-trail' && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 0 }}>
            <div style={{ fontSize: 10, color: V3.textTertiary, fontWeight: 600, letterSpacing: '0.08em', textTransform: 'uppercase', marginBottom: 12 }}>
              HASH-CHAIN AUDIT TRAIL — eCign v2
            </div>
            {AUDIT_TRAIL.map((entry, i) => (
              <div key={i} style={{
                padding: '12px 0 12px 20px',
                borderLeft: `2px solid ${i === 0 ? V3.tealLight : 'rgba(255,255,255,0.08)'}`,
                marginLeft: 8,
                position: 'relative',
              }}>
                <div style={{ position: 'absolute', left: -5, top: 15, width: 8, height: 8, borderRadius: '50%', background: i === 0 ? V3.tealLight : 'rgba(255,255,255,0.15)' }} />
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                  <div>
                    <div style={{ color: V3.textPrimary, fontSize: 13 }}>{entry.action}</div>
                    <div style={{ color: V3.textTertiary, fontSize: 11, marginTop: 2 }}>{entry.actor} · {entry.time}</div>
                  </div>
                  <span style={{ fontSize: 10, fontFamily: 'monospace', color: V3.tealLight, padding: '2px 6px', borderRadius: 4, background: 'rgba(0, 209, 193, 0.06)' }}>{entry.hash}</span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div style={{ marginTop: 32, padding: '12px 16px', borderTop: '1px solid rgba(255,255,255,0.06)', color: V3.textTertiary, fontSize: 11 }}>
        Visual preview only — real Onboarding V2 uses KpiTile, StatusPill, GateTile, UnitDrawer, AuditTimeline, reconciliation preview, hash-chain verification (eCign v2), and allowlist CSV validation.
      </div>
    </div>
  );
}

