<div style={{ fontSize: '12px', color: V3.textTertiary, padding: '16px 0', textAlign: 'center' }}>No folder data for this event</div>
)}
</div>
</div>
{/* Signatures */}
{selectedUnit.requiredSigners.length > 0 && (
<div className="v3-invisible-glare" style={{ padding: '20px', borderRadius: '12px' }}>
<div style={{ fontSize: '11px', fontWeight: 600, color: V3.textSecondary, marginBottom: '12px', textTransform: 'uppercase' }}>Signature Roster</div>
<div style={{ display: 'flex', gap: '12px' }}>
{selectedUnit.requiredSigners.map((s, i) => (
<div key={i} style={{ display: 'flex', alignItems: 'center', gap: '8px', padding: '10px 16px', borderRadius: '8px', background: 'rgba(255,255,255,0.02)', border: `1px solid ${s.signed ? V3.teal : 'rgba(255,255,255,0.06)'}` }}>
<div style={{
width: '32px', height: '32px', borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center',
background: s.signed ? 'rgba(0,209,193,0.15)' : 'rgba(255,255,255,0.05)',
border: `2px solid ${s.signed ? V3.tealLight : V3.textTertiary}`,
fontSize: '12px', fontWeight: 600, color: s.signed ? V3.tealLight : V3.textTertiary
}}>{s.signed ? '✓' : s.name.charAt(0)}</div>
<div>
<div style={{ fontSize: '12px', color: V3.textPrimary }}>{s.name}</div>
<div style={{ fontSize: '10px', color: s.signed ? V3.tealLight : V3.orangeLight }}>{s.signed ? 'Signed' : 'Pending'}</div>
</div>
</div>
))}
</div>
</div>
)}
{/* Actions */}
<div style={{ display: 'flex', gap: '10px' }}>
<button style={{ padding: '10px 20px', fontSize: '12px', fontWeight: 600, borderRadius: '8px', border: 'none', background: V3.teal, color: '#fff', cursor: 'pointer' }}>Advance Phase</button>
<button style={{ padding: '10px 20px', fontSize: '12px', fontWeight: 500, borderRadius: '8px', border: '1px solid rgba(255,255,255,0.15)', background: 'transparent', color: V3.textSecondary, cursor: 'pointer' }}>Upload Evidence</button>
<button style={{ padding: '10px 20px', fontSize: '12px', fontWeight: 500, borderRadius: '8px', border: '1px solid rgba(255,255,255,0.15)', background: 'transparent', color: V3.textSecondary, cursor: 'pointer' }}>Request Signature</button>
</div>
</div>
</div>
</div>
);
}
