3. CES Sprint Execution Board (Kanban) — CesBoardPageV3

This is the #1 priority surface. Full 6-column Kanban with swimlanes, drag enforcement, and WorkflowDrawer.

// ============================================================
// CES SPRINT EXECUTION BOARD — V3 VEIL GLASS KANBAN
// Drop into V3StagingApp.tsx PageContent switch
// ============================================================
function CesBoardPageV3() {
const [units, setUnits] = useState<ExecutionUnit[]>(CES_EXECUTION_UNITS);
const [selectedUnit, setSelectedUnit] = useState<ExecutionUnit | null>(null);
const [dragId, setDragId] = useState<string | null>(null);
const [dragOverCol, setDragOverCol] = useState<ComplianceState | null>(null);
const [warnMsg, setWarnMsg] = useState<string | null>(null);
const [filterDomain, setFilterDomain] = useState<string>('all');
const [filterPhase, setFilterPhase] = useState<string>('all');
const [searchTerm, setSearchTerm] = useState('');
const [activeSprint] = useState('Sprint 9 — May 2026');
// Enforcement check
const canTransition = (unit: ExecutionUnit, target: ComplianceState): { allowed: boolean; reason?: string } => {
if (unit.complianceState === target) return { allowed: false, reason: 'Already in this state' };
if (target === 'completed' && unit.evidenceStatus.missingFormIds.length > 0)
return { allowed: false, reason: `Cannot complete: ${unit.evidenceStatus.missingFormIds.length} missing forms` };
if (target === 'completed' && unit.evidenceStatus.signaturesComplete < unit.evidenceStatus.signaturesRequired)
return { allowed: false, reason: `Cannot complete: ${unit.evidenceStatus.signaturesRequired - unit.evidenceStatus.signaturesComplete} signatures pending` };
const allowed = STATE_TRANSITIONS[unit.complianceState];
if (!allowed.includes(target)) return { allowed: false, reason: `Cannot move from ${STATE_LABELS[unit.complianceState]} to ${STATE_LABELS[target]}` };
return { allowed: true };
};
const handleDragStart = (unitId: string) => setDragId(unitId);
const handleDragEnd = () => { setDragId(null); setDragOverCol(null); };
const handleDragOver = (e: React.DragEvent, col: ComplianceState) => {
e.preventDefault();
setDragOverCol(col);
};
const handleDrop = (targetState: ComplianceState) => {
if (!dragId) return;
const unit = units.find(u => u.id === dragId);
if (!unit) return;
const verdict = canTransition(unit, targetState);
if (!verdict.allowed) {
setWarnMsg(verdict.reason || 'Transition denied');
setTimeout(() => setWarnMsg(null), 3000);
setDragId(null);
setDragOverCol(null);
return;
}
setUnits(prev => prev.map(u => u.id === dragId ? { ...u, complianceState: targetState } : u));
setDragId(null);
setDragOverCol(null);
};
// Filtered units
const filtered = useMemo(() => units.filter(u => {
if (filterDomain !== 'all' && u.domain !== filterDomain) return false;
if (filterPhase !== 'all' && u.workflowPhase !== filterPhase) return false;
if (searchTerm && !u.title.toLowerCase().includes(searchTerm.toLowerCase()) && !u.code.toLowerCase().includes(searchTerm.toLowerCase())) return false;
return true;
}), [units, filterDomain, filterPhase, searchTerm]);
// Group by event within each column
const getColumnUnits = (state: ComplianceState) => {
const stateUnits = filtered.filter(u => u.complianceState === state);
const grouped: Record<string, ExecutionUnit[]> = {};
stateUnits.forEach(u => {
if (!grouped[u.parentEventId]) grouped[u.parentEventId] = [];
grouped[u.parentEventId].push(u);
});
return grouped;
};
const domains = ['all', ...Array.from(new Set(CES_EXECUTION_UNITS.map(u => u.domain)))];
const phases = ['all', 'initiation', 'evidence_collection', 'review', 'approval', 'certification'];
const stateColors: Record<ComplianceState, string> = {
upcoming: V3.textTertiary,
ready: V3.teal,
in_progress: V3.tealLight,
awaiting_signature: V3.orangeLight,
blocked: '#E76F51',
completed: V3.teal,
};
// KPIs
const totalUnits = units.length;
const completedCount = units.filter(u => u.complianceState === 'completed').length;
const blockedCount = units.filter(u => u.complianceState === 'blocked').length;
const overdueCount = units.filter(u => u.daysUntilDue < 0 && u.complianceState !== 'completed').length;
const auditReadyPct = Math.round((units.filter(u => u.auditReadiness === 'audit_ready').length / totalUnits) * 100);
return (
<div className="v3-subview-animate" style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
{/* HEADER BLOCK */}
<div>
<div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '12px' }}>
<span style={{
fontSize: '11px', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.8px',
color: V3.orangeLight,
textShadow: '0 0 10px rgba(255, 160, 89, 0.95), 0 0 20px rgba(255, 160, 89, 0.45)'
}}>Compliance Execution</span>
<span style={{ fontSize: '12px', color: V3.textTertiary }}>Sprint Board</span>
</div>
<h1 style={{
fontSize: '28px', fontWeight: 600, lineHeight: 1.2, margin: 0, letterSpacing: '-0.5px',
background: 'linear-gradient(135deg, #FFFFFF 0%, #94A3B8 100%)',
WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent'
}}>Sprint Execution Board</h1>
<p style={{ fontSize: '14px', color: V3.textSecondary, marginTop: '8px' }}>{activeSprint}</p>
</div>
{/* KPI ROW */}
<div style={{ display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: '16px' }}>
{[
{ label: 'Completion', value: `${Math.round((completedCount/totalUnits)*100)}%`, sub: `${completedCount}/${totalUnits} units` },
{ label: 'Audit Readiness', value: `${auditReadyPct}%`, sub: `${units.filter(u=>u.auditReadiness==='audit_ready').length} ready` },
{ label: 'Blocked', value: String(blockedCount), sub: blockedCount > 0 ? 'action required' : 'all clear', alert: blockedCount > 0 },
{ label: 'Overdue', value: String(overdueCount), sub: overdueCount > 0 ? 'past due date' : 'on track', alert: overdueCount > 0 },
{ label: 'Awaiting Sig', value: String(units.filter(u=>u.complianceState==='awaiting_signature').length), sub: 'pending signatures' },
].map((kpi, i) => (
<div key={i} className="v3-invisible-glare" style={{ padding: '20px', borderRadius: '12px' }}>
<div style={{ fontSize: '11px', color: V3.textTertiary, textTransform: 'uppercase', letterSpacing: '0.5px', marginBottom: '8px' }}>{kpi.label}</div>
<div style={{ fontSize: '24px', fontWeight: 600, color: kpi.alert ? V3.orangeLight : V3.textPrimary }}>{kpi.value}</div>
<div style={{ fontSize: '12px', color: kpi.alert ? V3.orangeLight : V3.textTertiary, marginTop: '4px' }}>{kpi.sub}</div>
</div>
))}
</div>
{/* FILTER BAR */}
<div style={{
display: 'flex', alignItems: 'center', gap: '12px', padding: '12px 16px',
background: V3.glass3, borderRadius: '12px', flexWrap: 'wrap'
}}>
<div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
<Search size={14} color={V3.textTertiary} />
<input
value={searchTerm} onChange={e => setSearchTerm(e.target.value)}
placeholder="Search units, codes..."
style={{ background: 'transparent', border: 'none', color: V3.textPrimary, outline: 'none', fontSize: '13px', width: '200px' }}
/>
</div>
<div style={{ width: '1px', height: '20px', background: 'rgba(255,255,255,0.12)' }} />
<div style={{ display: 'flex', gap: '6px', flexWrap: 'wrap' }}>
{domains.map(d => (
<button key={d} onClick={() => setFilterDomain(d)} style={{
padding: '5px 12px', fontSize: '11px', fontWeight: 500, borderRadius: '16px', border: 'none', cursor: 'pointer',
background: filterDomain === d ? 'rgba(0, 209, 193, 0.15)' : 'transparent',
color: filterDomain === d ? V3.tealLight : V3.textTertiary,
transition: 'all 0.2s'
}}>{d === 'all' ? 'All Domains' : d}</button>
))}
</div>
<div style={{ marginLeft: 'auto', display: 'flex', gap: '8px' }}>
<button style={{
padding: '6px 14px', fontSize: '11px', fontWeight: 600, borderRadius: '8px',
border: `1px solid ${V3.teal}`, background: 'rgba(0, 121, 112, 0.15)',
color: V3.tealLight, cursor: 'pointer'
}}>+ Add Task</button>
</div>
</div>
{/* ENFORCEMENT WARNING */}
{warnMsg && (
<div style={{
padding: '12px 20px', background: 'rgba(231, 111, 81, 0.12)', borderRadius: '8px',
border: '1px solid rgba(231, 111, 81, 0.3)', display: 'flex', alignItems: 'center', gap: '10px',
animation: 'fadeIn 0.3s ease'
}} role="alert" aria-live="assertive">
<AlertTriangle size={16} color="#E76F51" />
<span style={{ fontSize: '13px', color: '#E76F51', fontWeight: 500 }}>{warnMsg}</span>
</div>
)}
{/* 6-COLUMN KANBAN BOARD */}
<div style={{
display: 'grid', gridTemplateColumns: 'repeat(6, minmax(220px, 1fr))', gap: '12px',
overflowX: 'auto', paddingBottom: '20px', minHeight: '500px'
}}>
{COMPLIANCE_STATE_ORDER.map(state => {
const grouped = getColumnUnits(state);
const colCount = Object.values(grouped).flat().length;
const isOver = dragOverCol === state;
return (
<div
key={state}
onDragOver={e => handleDragOver(e, state)}
onDragLeave={() => setDragOverCol(null)}
onDrop={() => handleDrop(state)}
style={{
background: isOver ? 'rgba(0, 209, 193, 0.04)' : 'transparent',
borderRadius: '12px', padding: '12px 8px',
border: isOver ? '1px dashed rgba(0, 209, 193, 0.3)' : '1px solid transparent',
transition: 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)', minHeight: '400px'
}}
>
{/* Column Header */}
<div style={{
display: 'flex', alignItems: 'center', justifyContent: 'space-between',
marginBottom: '16px', padding: '0 4px'
}}>
<div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
<div style={{ width: '8px', height: '8px', borderRadius: '50%', background: stateColors[state] }} />
<span style={{ fontSize: '11px', fontWeight: 600, textTransform: 'uppercase', letterSpacing: '0.5px', color: V3.textSecondary }}>
{STATE_LABELS[state]}
</span>
</div>
<span style={{
fontSize: '10px', fontWeight: 600, padding: '2px 8px', borderRadius: '10px',
background: 'rgba(255,255,255,0.06)', color: V3.textTertiary
}}>{colCount}</span>
</div>
{/* Swimlane Groups */}
<div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
{Object.entries(grouped).map(([eventId, eventUnits]) => {
const event = CES_EVENTS.find(e => e.id === eventId);
return (
<div key={eventId}>
{/* Swimlane Header */}
<div style={{
fontSize: '10px', fontWeight: 600, color: V3.textTertiary,
padding: '4px 8px', marginBottom: '8px', letterSpacing: '0.3px',
borderLeft: `2px solid ${stateColors[state]}40`, paddingLeft: '10px'
}}>
{event?.title || eventId}
<span style={{
marginLeft: '6px', fontSize: '9px', padding: '1px 6px', borderRadius: '8px',
background: 'rgba(255,255,255,0.05)', color: V3.textTertiary
}}>{event?.domain}</span>
</div>
{/* Cards */}
<div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
{eventUnits.map(unit => (
<V3ExecutionUnitCard
key={unit.id}
unit={unit}
stateColor={stateColors[state]}
isDragging={dragId === unit.id}
onDragStart={() => handleDragStart(unit.id)}
onDragEnd={handleDragEnd}
onClick={() => setSelectedUnit(unit)}
/>
))}
</div>
</div>
);
})}
{Object.keys(grouped).length === 0 && (
<div style={{
padding: '24px 12px', textAlign: 'center', color: V3.textTertiary,
fontSize: '11px', fontStyle: 'italic'
}}>No items</div>
)}
</div>
</div>
);
})}
</div>
{/* WORKFLOW DRAWER */}
{selectedUnit && (
<V3WorkflowDrawer
unit={selectedUnit}
onClose={() => setSelectedUnit(null)}
onUpdate={(updated) => {
setUnits(prev => prev.map(u => u.id === updated.id ? updated : u));
setSelectedUnit(updated);
}}
/>
)}
</div>
);
}
4. V3 Execution Unit Card
function V3ExecutionUnitCard({ unit, stateColor, isDragging, onDragStart, onDragEnd, onClick }: {
unit: ExecutionUnit; stateColor: string; isDragging: boolean;
onDragStart: () => void; onDragEnd: () => void; onClick: () => void;
}) {
const isOverdue = unit.daysUntilDue < 0 && unit.complianceState !== 'completed';
const isCompleted = unit.complianceState === 'completed';
const evPct = unit.evidenceStatus.requiredFormsTotal > 0
? Math.round((unit.evidenceStatus.completedForms / unit.evidenceStatus.requiredFormsTotal) * 100) : 0;
const readinessColor = unit.auditReadiness === 'audit_ready' ? V3.tealLight
: unit.auditReadiness === 'partial' ? V3.orangeLight : V3.textTertiary;
return (
<article
draggable={!isCompleted}
onDragStart={onDragStart}
onDragEnd={onDragEnd}
onClick={onClick}
className="v3-invisible-glare"
style={{
padding: '14px 12px', borderRadius: '10px', cursor: 'pointer',
border: `1px solid ${isDragging ? V3.tealLight : 'rgba(255,255,255,0.08)'}`,
borderTop: `2px solid ${stateColor}`,
opacity: isDragging ? 0.5 : 1,
transition: 'all 0.25s cubic-bezier(0.16, 1, 0.3, 1)',
transform: isDragging ? 'scale(0.97) rotate(1deg)' : 'none',
}}
>
{/* Code + Phase */}
<div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>
<span style={{ fontSize: '10px', fontWeight: 600, color: V3.tealLight, letterSpacing: '0.3px' }}>{unit.code}</span>
<span style={{
fontSize: '9px', fontWeight: 500, padding: '2px 6px', borderRadius: '6px',
background: 'rgba(0, 209, 193, 0.1)', color: V3.tealLight,
textTransform: 'capitalize'
}}>{unit.workflowPhase.replace('_', ' ')}</span>
</div>
{/* Title */}
<div style={{ fontSize: '12.5px', fontWeight: 500, color: V3.textPrimary, lineHeight: 1.35, marginBottom: '10px' }}>
{unit.title}
