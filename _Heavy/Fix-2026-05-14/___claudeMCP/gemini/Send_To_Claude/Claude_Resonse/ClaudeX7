/* ═══════════════════════════════════════════════════
VIEWPORT SHELL — generous breathing room from edges
═══════════════════════════════════════════════════ *
.viewport {
display: flex;
align-items: stretch;
justify-content: center;
min-height: 100vh;
padding: 20px;
}
/* ═══════════════════════════════════════════════════
SINGLE MAIN CARD — the entire app lives here
Nav merges INTO this card. No separate sidebar.
═══════════════════════════════════════════════════ *
.main-card {
width: 100%;
max-width: 1440px;
background: var(--main-card-bg);
border: 1.5px solid var(--main-card-border);
border-radius: 12px;
display: grid;
grid-template-columns: var(--nav-w) 1px 1fr;
grid-template-rows: 52px 1fr;
overflow: hidden;
position: relative;
}
/* ═══════════════════════════════════════════════════
BROKEN LINE SEPARATOR — nav from content
NOT a solid border. Segmented / interrupted.
═══════════════════════════════════════════════════ *
.nav-divider {
grid-column: 2;
grid-row: 1 / -1;
width: 1px;
background: repeating-linear-gradient(
to bottom,
var(--border-main) 0px,
var(--border-main) 28px,
transparent 28px,
transparent 40px
);
opacity: 0.7;
}
/* ═══════════════════════════════════════════════════
HEADER — spans full width inside main card
═══════════════════════════════════════════════════ *
.header {
grid-column: 1 / -1;
grid-row: 1;
display: flex;
align-items: center;
padding: 0 20px 0 0;
border-bottom: 1px solid transparent;
/* Broken horizontal line under header *
background-image: repeating-linear-gradient(
to right,
var(--border-main) 0px,
var(--border-main) 60px,
transparent 60px,
transparent 76px
);
background-repeat: repeat-x;
background-position: bottom;
background-size: auto 1px;
}
.logo-area {
width: var(--nav-w);
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
}
.logo-mark {
width: 26px;
height: 26px;
border-radius: 6px;
background: var(--teal);
display: grid;
place-items: center;
font-size: 13px;
font-weight: 800;
color: #fff;
letter-spacing: -0.5px;
}
.header-search {
margin-left: 20px;
display: flex;
align-items: center;
gap: 8px;
background: var(--surface-1);
border: 1px solid var(--border-main);
border-radius: 6px;
padding: 6px 12px;
width: 240px;
color: var(--text-tertiary);
font-size: 13px;
cursor: text;
transition: border-color 120ms;
}
.header-search:hover { border-color: var(--teal); }
.header-search-icon { font-size: 12px; opacity: 0.5; }
.header-kbd {
margin-left: auto;
font-size: 10px;
background: var(--surface-2);
border: 1px solid var(--border-main);
border-radius: 3px;
padding: 1px 5px;
color: var(--text-tertiary);
font-family: monospace;
}
.header-right {
margin-left: auto;
display: flex;
align-items: center;
gap: 4px;
padding-right: 4px;
}
.h-btn {
width: 30px;
height: 30px;
border-radius: var(--radius-sm);
background: transparent;
border: none;
display: grid;
place-items: center;
cursor: pointer;
color: var(--text-tertiary);
font-size: 14px;
transition: color 120ms, background 120ms;
position: relative;
}
.h-btn:hover { color: var(--text-primary); background: var(--surface-1); }
.notif-dot {
position: absolute;
top: 5px; right: 5px;
width: 5px; height: 5px;
border-radius: 50%;
background: var(--orange);
border: 1px solid var(--main-card-bg);
}
/* Avatar at BOTTOM of nav per spec *
.header-avatar {
width: 28px;
height: 28px;
border-radius: 50%;
background: var(--surface-2);
border: 1px solid var(--border-main);
display: grid;
place-items: center;
font-size: 11px;
font-weight: 700;
color: var(--text-secondary);
cursor: pointer;
margin-left: 4px;
}
/* ═══════════════════════════════════════════════════
LEFT NAV — icon-only, collapsed by default
Notification + avatar live at BOTTOM per spec
═══════════════════════════════════════════════════ *
.nav {
grid-column: 1;
grid-row: 2;
display: flex;
flex-direction: column;
align-items: center;
padding: 12px 0;
gap: 2px;
}
.nav-icon-btn {
width: 36px;
height: 36px;
border-radius: var(--radius-sm);
display: grid;
place-items: center;
cursor: pointer;
color: var(--text-tertiary);
font-size: 15px;
transition: color 120ms, background 120ms;
position: relative;
border: 1px solid transparent;
}
.nav-icon-btn:hover {
color: var(--text-primary);
background: var(--surface-1);
}
.nav-icon-btn.active {
color: var(--teal-light);
background: rgba(0, 121, 112, 0.10);
border-color: rgba(0, 121, 112, 0.20);
}
/* active indicator — teal left pip *
.nav-icon-btn.active::before {
content: '';
position: absolute;
left: -8px;
top: 50%; transform: translateY(-50%);
width: 2px;
height: 16px;
background: var(--teal);
border-radius: 0 2px 2px 0;
}
.nav-badge-dot {
position: absolute;
top: 6px; right: 6px;
width: 5px; height: 5px;
border-radius: 50%;
background: var(--orange);
border: 1px solid var(--main-card-bg);
}
.nav-spacer { flex: 1; }
.nav-section-break {
width: 20px;
height: 1px;
background: var(--border-main);
margin: 6px 0;
opacity: 0.5;
}
/* ═══════════════════════════════════════════════════
CONTENT AREA
═══════════════════════════════════════════════════ *
.content {
grid-column: 3;
grid-row: 2;
overflow-y: auto;
padding: 28px 32px;
display: flex;
flex-direction: column;
gap: 24px;
}
/* ═══════════════════════════════════════════════════
PAGE HEADER — minimal
═══════════════════════════════════════════════════ *
.page-head {
display: flex;
align-items: flex-end;
justify-content: space-between;
}
.page-title {
font-size: var(--text-display);
font-weight: 600;
letter-spacing: -0.5px;
color: var(--text-primary);
line-height: 1.1;
}
.page-meta {
font-size: var(--text-small);
color: var(--text-tertiary);
margin-top: 4px;
letter-spacing: 0.01em;
}
.page-actions {
display: flex;
gap: 8px;
}
/* ═══════════════════════════════════════════════════
BUTTONS — restrained, teal primary only
═══════════════════════════════════════════════════ *
.btn {
display: inline-flex;
align-items: center;
gap: 6px;
padding: 7px 14px;
border-radius: var(--radius-sm);
font-size: 13px;
font-weight: 500;
cursor: pointer;
border: none;
transition: all 120ms;
white-space: nowrap;
letter-spacing: 0.01em;
}
.btn-primary {
background: var(--teal);
color: #fff;
}
.btn-primary:hover { background: var(--teal-light); }
.btn-ghost {
background: transparent;
color: var(--text-secondary);
border: 1px solid var(--border-main);
}
.btn-ghost:hover {
background: var(--surface-1);
color: var(--text-primary);
border-color: rgba(255,255,255,0.12);
}
/* ═══════════════════════════════════════════════════
ALERT ROW — minimal, not a colored card
═══════════════════════════════════════════════════ *
.alert-row {
display: flex;
align-items: center;
gap: 12px;
padding: 12px 16px;
background: rgba(224, 123, 44, 0.06);
border: 1px solid rgba(224, 123, 44, 0.18);
border-radius: var(--radius);
}
.alert-pip {
width: 6px; height: 6px;
border-radius: 50%;
background: var(--orange);
flex-shrink: 0;
animation: pulse-orange 2s infinite;
}
@keyframes pulse-orange {
0%, 100% { opacity: 1; }
50% { opacity: 0.4; }
}
.alert-text {
font-size: 13px;
color: var(--text-secondary);
flex: 1;
}
.alert-text strong { color: var(--orange-light); font-weight: 500; }
.alert-action {
font-size: 12px;
color: var(--orange);
cursor: pointer;
padding: 4px 10px;
border-radius: var(--radius-sm);
border: 1px solid rgba(224, 123, 44, 0.25);
transition: background 120ms;
}
.alert-action:hover { background: rgba(224, 123, 44, 0.10); }
/* ═══════════════════════════════════════════════════
STAT STRIP — flat, no colored cards, no gradients
Per spec: flat rows with border separation only
═══════════════════════════════════════════════════ *
.stat-strip {
display: grid;
grid-template-columns: repeat(4, 1fr);
background: var(--surface-1);
border: 1px solid var(--border-main);
border-radius: var(--radius);
overflow: hidden;
}
.stat-cell {
padding: 18px 20px;
border-right: 1px solid var(--border-main);
transition: background 120ms;
cursor: default;
}
.stat-cell:last-child { border-right: none; }
.stat-cell:hover { background: var(--surface-2); }
.stat-label {
font-size: var(--text-micro);
font-weight: 500;
color: var(--text-tertiary);
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 8px;
}
.stat-value {
font-size: 26px;
font-weight: 600;
letter-spacing: -0.8px;
color: var(--text-primary);
line-height: 1;
margin-bottom: 6px;
}
.stat-sub {
font-size: var(--text-micro);
color: var(--text-tertiary);
display: flex;
align-items: center;
gap: 5px;
}
.delta-up { color: var(--teal-light); }
.delta-down { color: var(--orange); }
/* Bottom progress line — teal only, 2px *
.stat-bar {
margin-top: 12px;
height: 2px;
background: var(--surface-3);
border-radius: 2px;
overflow: hidden;
}
.stat-bar-fill {
height: 100%;
background: var(--teal);
border-radius: 2px;
}
.stat-bar-fill.warn { background: var(--orange); }
/* ═══════════════════════════════════════════════════
TWO-COLUMN LAYOUT
═══════════════════════════════════════════════════ *
.cols {
display: grid;
grid-template-columns: 1fr 300px;
gap: 20px;
}
.col-left { display: flex; flex-direction: column; gap: 20px; }
.col-right { display: flex; flex-direction: column; gap: 20px; }
/* ═══════════════════════════════════════════════════
PANEL — flat surface, no glass, no glow
═══════════════════════════════════════════════════ *
.panel {
background: var(--surface-1);
border: 1px solid var(--border-main);
border-radius: var(--radius);
overflow: hidden;
}
.panel-head {
display: flex;
align-items: center;
justify-content: space-between;
padding: 14px 18px;
border-bottom: 1px solid var(--border-main);
}
.panel-title {
font-size: 13px;
font-weight: 600;
color: var(--text-primary);
letter-spacing: 0.01em;
}
.panel-sub {
font-size: var(--text-micro);
color: var(--text-tertiary);
margin-top: 1px;
}
.panel-body { padding: 0; }
/* ═══════════════════════════════════════════════════
FILTER TABS — minimal
═══════════════════════════════════════════════════ *
.tab-row {
display: flex;
gap: 2px;
}
.tab {
padding: 4px 12px;
border-radius: var(--radius-sm);
font-size: var(--text-small);
font-weight: 500;
color: var(--text-tertiary);
cursor: pointer;
transition: all 120ms;
border: 1px solid transparent;
}
.tab.active {
color: var(--teal-light);
background: rgba(0, 121, 112, 0.10);
border-color: rgba(0, 121, 112, 0.20);
}
.tab:hover:not(.active) { color: var(--text-secondary); }
/* ═══════════════════════════════════════════════════
TASK LIST — TaskRowMinimal
Per Agent 06: max 5–7 elements per row. Flat.
Row height 52–60px. No cards, no borders on rows.
═══════════════════════════════════════════════════ *
.task-list { display: flex; flex-direction: column; }
.task-row {
display: grid;
grid-template-columns: 20px 1fr auto auto auto 80px;
align-items: center;
gap: 14px;
height: var(--row-h);
padding: 0 18px;
border-bottom: 1px solid var(--border-main);
cursor: pointer;
transition: background 120ms, transform 120ms;
position: relative;
}
.task-row:last-child { border-bottom: none; }
.task-row:hover {
background: var(--surface-2);
transform: translateY(-1px);
}
.task-row:hover .task-open-btn { opacity: 1; }
/* Checkbox *
.task-check {
width: 14px;
height: 14px;
border-radius: 3px;
border: 1px solid var(--border-main);
background: transparent;
flex-shrink: 0;
cursor: pointer;
}
/* Title + one-line context *
.task-info {}
.task-title {
font-size: 13px;
font-weight: 500;
color: var(--text-primary);
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
max-width: 380px;
}
.task-context {
font-size: var(--text-micro);
color: var(--text-tertiary);
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
max-width: 380px;
margin-top: 1px;
}
/* Status pill — teal or orange ONLY *
.pill {
display: inline-flex;
align-items: center;
gap: 4px;
padding: 2px 8px;
border-radius: 99px;
font-size: var(--text-micro);
font-weight: 500;
white-space: nowrap;
}
.pill-dot {
width: 4px; height: 4px;
border-radius: 50%;
flex-shrink: 0;
}
.pill-confirmed {
background: rgba(0, 121, 112, 0.12);
color: var(--teal-light);
border: 1px solid rgba(0, 121, 112, 0.20);
}
.pill-confirmed .pill-dot { background: var(--teal); }
.pill-pending {
background: rgba(224, 123, 44, 0.10);
color: var(--orange-light);
border: 1px solid rgba(224, 123, 44, 0.18);
}
.pill-pending .pill-dot { background: var(--orange); }
.pill-open {
background: rgba(224, 123, 44, 0.08);
color: var(--orange);
border: 1px solid rgba(224, 123, 44, 0.15);
}
.pill-open .pill-dot { background: var(--orange); }
/* Due date *
.due-chip {
font-size: var(--text-micro);
color: var(--text-tertiary);
white-space: nowrap;
}
.due-chip.urgent { color: var(--orange); }
/* Count chips *
.count-chips {
display: flex;
gap: 6px;
align-items: center;
}
.count-chip {
font-size: var(--text-micro);
color: var(--text-tertiary);
background: var(--surface-2);
border: 1px solid var(--border-main);
border-radius: 4px;
padding: 2px 6px;
cursor: pointer;
transition: border-color 120ms, color 120ms;
}
.count-chip:hover {
border-color: var(--teal);
color: var(--teal-light);
}
.count-chip.alert {
border-color: rgba(224, 123, 44, 0.25);
color: var(--orange);
}
/* Veil open button — hidden until hover *
.task-open-btn {
font-size: var(--text-micro);
color: var(--teal);
border: 1px solid rgba(0, 121, 112, 0.25);
border-radius: var(--radius-sm);
padding: 3px 9px;
cursor: pointer;
opacity: 0;
transition: opacity 120ms, background 120ms;
background: transparent;
white-space: nowrap;
}
.task-open-btn:hover { background: rgba(0, 121, 112, 0.10); }
/* List footer *
.list-footer {
display: flex;
align-items: center;
justify-content: space-between;
padding: 10px 18px;
border-top: 1px solid var(--border-main);
}
.list-footer-label {
font-size: var(--text-micro);
color: var(--text-tertiary);
}
/* ═══════════════════════════════════════════════════
COVERAGE CHART — flat bars, teal only
═══════════════════════════════════════════════════ *
.chart-area {
padding: 18px;
display: flex;
flex-direction: column;
gap: 14px;
}
.chart-bars {
display: flex;
align-items: flex-end;
gap: 6px;
height: 80px;
}
.bar-col {
flex: 1;
display: flex;
flex-direction: column;
align-items: center;
gap: 5px;
height: 100%;
}
.bar-track {
flex: 1;
width: 100%;
background: var(--surface-2);
border-radius: 3px 3px 0 0;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: flex-end;
}
.bar-fill {
width: 100%;
background: var(--teal);
border-radius: 3px 3px 0 0;
opacity: 0.7;
transition: opacity 120ms;
}
.bar-fill:hover { opacity: 1; }
.bar-fill.today { opacity: 1; background: var(--orange); }
.bar-fill.future { opacity: 0.25; }
.bar-lbl {
font-size: 9px;
color: var(--text-tertiary);
font-weight: 500;
text-transform: uppercase;
letter-spacing: 0.04em;
}
.bar-lbl.today { color: var(--orange); }
/* ═══════════════════════════════════════════════════
RIGHT COLUMN PANELS
═══════════════════════════════════════════════════ *
/* Mini calendar *
.cal-grid {
padding: 14px 16px;
}
.cal-dow {
display: grid;
grid-template-columns: repeat(7, 1fr);
margin-bottom: 6px;
}
.cal-dow-label {
text-align: center;
font-size: 9px;
font-weight: 600;
color: var(--text-tertiary);
text-transform: uppercase;
letter-spacing: 0.06em;
}
.cal-days {
display: grid;
grid-template-columns: repeat(7, 1fr);
gap: 2px;
}
.cal-day {
aspect-ratio: 1;
display: grid;
place-items: center;
font-size: var(--text-small);
color: var(--text-tertiary);
border-radius: 4px;
cursor: pointer;
transition: background 120ms, color 120ms;
position: relative;
}
.cal-day:hover { background: var(--surface-2); color: var(--text-primary); }
.cal-day.today {
background: var(--teal);
color: #fff;
font-weight: 600;
}
.cal-day.has-event::after {
content: '';
position: absolute;
bottom: 3px;
width: 3px; height: 3px;
border-radius: 50%;
background: var(--orange);
}
.cal-day.today.has-event::after { background: rgba(255,255,255,0.7); }
/* CES score — flat, minimal *
.ces-wrap {
padding: 18px 16px;
display: flex;
flex-direction: column;
gap: 14px;
}
.ces-hero {
display: flex;
align-items: center;
gap: 14px;
}
.ces-ring {
position: relative;
width: 64px;
height: 64px;
flex-shrink: 0;
}
.ces-ring svg { transform: rotate(-90deg); }
.ces-ring-val {
position: absolute;
inset: 0;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
}
.ces-number {
font-size: 18px;
font-weight: 700;
letter-spacing: -0.5px;
color: var(--text-primary);
line-height: 1;
}
.ces-denom {
font-size: 9px;
color: var(--text-tertiary);
}
.ces-meta { flex: 1; }
.ces-headline {
font-size: 13px;
font-weight: 600;
color: var(--text-primary);
}
.ces-desc {
font-size: var(--text-micro);
color: var(--text-tertiary);
margin-top: 2px;
}
/* CES breakdown rows *
.ces-rows { display: flex; flex-direction: column; gap: 8px; }
.ces-row {
display: flex;
align-items: center;
gap: 10px;
font-size: var(--text-micro);
}
.ces-row-label { color: var(--text-secondary); width: 90px; flex-shrink: 0; }
.ces-row-track {
flex: 1;
height: 3px;
background: var(--surface-3);
border-radius: 2px;
overflow: hidden;
}
.ces-row-fill {
height: 100%;
background: var(--teal);
border-radius: 2px;
}
.ces-row-val {
font-weight: 600;
color: var(--text-primary);
width: 24px;
text-align: right;
}
/* Onboarding rows *
.ob-list { display: flex; flex-direction: column; }
.ob-row {
display: flex;
align-items: center;
gap: 10px;
padding: 12px 16px;
border-bottom: 1px solid var(--border-main);
cursor: pointer;
transition: background 120ms;
}
.ob-row:last-child { border-bottom: none; }
.ob-row:hover { background: var(--surface-2); }
.ob-avatar {
width: 26px;
height: 26px;
border-radius: 50%;
background: var(--surface-2);
border: 1px solid var(--border-main);
display: grid;
place-items: center;
font-size: 9px;
font-weight: 700;
color: var(--text-secondary);
flex-shrink: 0;
}
.ob-info { flex: 1; min-width: 0; }
.ob-name {
font-size: 12px;
font-weight: 500;
color: var(--text-primary);
}
.ob-step {
font-size: 10px;
color: var(--text-tertiary);
margin-top: 1px;
}
.ob-pct {
font-size: var(--text-micro);
font-weight: 600;
color: var(--teal-light);
width: 30px;
text-align: right;
}
/* Quick links *
.quick-list { display: flex; flex-direction: column; }
.quick-row {
display: flex;
align-items: center;
gap: 10px;
padding: 11px 16px;
border-bottom: 1px solid var(--border-main);
cursor: pointer;
transition: background 120ms, transform 120ms;
}
.quick-row:last-child { border-bottom: none; }
.quick-row:hover {
background: var(--surface-2);
transform: translateX(2px);
}
.quick-row-icon {
font-size: 13px;
width: 16px;
text-align: center;
color: var(--text-tertiary);
flex-shrink: 0;
}
.quick-row-label {
font-size: 12px;
color: var(--text-secondary);
flex: 1;
}
.quick-row:hover .quick-row-label { color: var(--text-primary); }
.quick-row-count {
font-size: var(--text-micro);
color: var(--orange);
font-weight: 600;
}
.quick-arrow {
font-size: 11px;
color: var(--text-tertiary);
}
/* ═══════════════════════════════════════════════════
VEIL DRAWER — glassmorphic, right side
This is the ONLY surface with glass treatment.
═══════════════════════════════════════════════════ *
.veil-overlay {
position: fixed;
inset: 0;
z-index: 200;
pointer-events: none;
opacity: 0;
transition: opacity 220ms;
}
.veil-overlay.open {
pointer-events: auto;
opacity: 1;
}
.veil-scrim {
position: absolute;
inset: 0;
background: rgba(0,0,0,0.45);
}
.veil-drawer {
position: absolute;
top: 20px; right: 20px; bottom: 20px;
width: 440px;
background: var(--veil-bg);
backdrop-filter: blur(var(--veil-blur)) saturate(1.18);
-webkit-backdrop-filter: blur(var(--veil-blur)) saturate(1.18);
border: 1px solid var(--border-veil);
border-radius: 10px 10px 10px 10px;
box-shadow: var(--veil-shadow),
inset 0 1px 0 rgba(255,255,255,0.07);
display: flex;
flex-direction: column;
transform: translateX(460px);
transition: transform 300ms cubic-bezier(0.32,0.72,0,1);
overflow: hidden;
}
.veil-overlay.open .veil-drawer {
transform: translateX(0);
}
.veil-header {
display: flex;
align-items: center;
justify-content: space-between;
padding: 16px 20px;
border-bottom: 1px solid var(--border-veil);
}
.veil-title {
font-size: 15px;
font-weight: 600;
color: var(--text-primary);
}
.veil-subtitle {
font-size: var(--text-micro);
color: var(--text-tertiary);
margin-top: 1px;
}
.veil-close {
width: 28px;
height: 28px;
border-radius: var(--radius-sm);
background: rgba(255,255,255,0.05);
border: 1px solid var(--border-veil);
display: grid;
place-items: center;
cursor: pointer;
color: var(--text-secondary);
font-size: 13px;
transition: background 120ms;
}
.veil-close:hover { background: rgba(255,255,255,0.10); }
.veil-tabs {
display: flex;
gap: 2px;
padding: 10px 16px;
border-bottom: 1px solid var(--border-veil);
}
.veil-tab {
padding: 5px 12px;
border-radius: var(--radius-sm);
font-size: var(--text-small);
color: var(--text-tertiary);
cursor: pointer;
transition: all 120ms;
border: 1px solid transparent;
}
.veil-tab.active {
color: var(--teal-light);
background: rgba(0, 121, 112, 0.12);
border-color: rgba(0, 121, 112, 0.22);
}
.veil-tab:hover:not(.active) { color: var(--text-secondary); }
.veil-body {
flex: 1;
overflow-y: auto;
padding: 18px 20px;
display: flex;
flex-direction: column;
gap: 14px;
}
/* VeilSection — inner glass card inside veil *
.veil-section {
background: rgba(255,255,255,0.03);
border: 1px solid rgba(255,255,255,0.08);
border-radius: var(--radius);
overflow: hidden;
}
.veil-section-head {
display: flex;
align-items: center;
justify-content: space-between;
padding: 10px 14px;
border-bottom: 1px solid rgba(255,255,255,0.06);
}
.veil-section-title {
font-size: var(--text-small);
font-weight: 600;
color: var(--text-secondary);
text-transform: uppercase;
letter-spacing: 0.06em;
}
.veil-section-body { padding: 12px 14px; }
.veil-kv {
display: grid;
grid-template-columns: 110px 1fr;
gap: 8px 12px;
}
.veil-kv-label {
font-size: var(--text-micro);
color: var(--text-tertiary);
align-self: center;
}
.veil-kv-value {
font-size: var(--text-small);
color: var(--text-primary);
font-weight: 500;
}
/* Evidence grid inside veil *
.veil-evidence-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 8px;
}
.veil-folder {
background: rgba(255,255,255,0.04);
border: 1px solid rgba(255,255,255,0.07);
border-radius: 6px;
padding: 10px 8px;
text-align: center;
cursor: pointer;
transition: background 120ms;
position: relative;
}
.veil-folder:hover { background: rgba(255,255,255,0.07); }
