3.5.3 Tab Transition Wrapper
// src/components/v3/V3TabTransition.tsx
import { motion, AnimatePresence } from 'framer-motion';
const V3_EASE = [0.16, 1, 0.3, 1];
export function V3TabTransition({ activeKey, direction, children }: {
activeKey: string; direction: 'left' | 'right'; children: React.ReactNode;
}) {
return (
<AnimatePresence mode="wait" custom={direction}>
<motion.div
key={activeKey}
custom={direction}
initial={{ opacity: 0, x: direction === 'right' ? 16 : -16, filter: 'blur(4px)' }}
animate={{ opacity: 1, x: 0, filter: 'blur(0px)', transition: { duration: 0.4, ease: V3_EASE } }}
exit={{ opacity: 0, x: direction === 'right' ? -16 : 16, filter: 'blur(4px)', transition: { duration: 0.25, ease: V3_EASE } }}
>
{children}
</motion.div>
</AnimatePresence>
);
}
