// Helper: flatten all routes for React Router registration
export function flattenRoutes(items: NavItem[]): Array<{ path: string; component: string }> {
  const routes: Array<{ path: string; component: string }> = [];
  for (const item of items) {
    routes.push({ path: item.route, component: item.component });
    if (item.children) {
      routes.push(...flattenRoutes(item.children));
    }
  }
  return routes;
}

// Helper: find active nav item by current path
export function findActiveNavItem(path: string, items: NavItem[] = NAV_CONFIG): NavItem | null {
  for (const item of items) {
    if (item.children) {
      const child = findActiveNavItem(path, item.children);
      if (child) return child;
    }
    // Exact match or pattern match for parameterized routes
    const pattern = item.route.replace(/:[^/]+/g, '[^/]+');
    if (new RegExp(`^${pattern}$`).test(path)) return item;
  }
  return null;
}

