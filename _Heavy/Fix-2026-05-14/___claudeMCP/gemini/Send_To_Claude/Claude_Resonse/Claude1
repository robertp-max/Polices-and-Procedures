// src/components/shell/V3Sidebar.tsx
import { useState } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { NAV_CONFIG, BOTTOM_RAIL, findActiveNavItem, type NavItem } from '@/navigation/navConfig';
import { ChevronLeft, ChevronDown, ChevronRight } from 'lucide-react';
const V3_EASE = [0.16, 1, 0.3, 1] as const;
export function V3Sidebar() {
const [expanded, setExpanded] = useState(false);
const [openSubmenus, setOpenSubmenus] = useState<Set<string>>(new Set());
const location = useLocation();
const navigate = useNavigate();
const activeItem = findActiveNavItem(location.pathname);
const toggleSubmenu = (id: string) => {
setOpenSubmenus(prev => {
const next = new Set(prev);
next.has(id) ? next.delete(id) : next.add(id);
return next;
});
};
const handleNavClick = (item: NavItem) => {
if (item.status === 'phase-3') return;
if (item.children && expanded) {
toggleSubmenu(item.id);
}
navigate(item.route);
};
return (
<motion.nav
animate={{ width: expanded ? 240 : 68 }}
transition={{ duration: 0.4, ease: V3_EASE }}
style={{
display: 'flex', flexDirection: 'column', alignItems: expanded ? 'stretch' : 'center',
padding: '20px 0', position: 'relative', flexShrink: 0, overflow: 'hidden',
}}
>
{/* Broken vertical divider */}
<div style={{
position: 'absolute', right: 0, top: '16px', bottom: '16px', width: '1px',
background: `repeating-linear-gradient(to bottom,
rgba(255,255,255,0.33) 0px, rgba(255,255,255,0.33) 12px,
transparent 12px, transparent 20px)`,
opacity: 0.6,
}} />
{/* Logo */}
<div
onClick={() => navigate('/dashboard')}
style={{
width: '36px', height: '36px', borderRadius: '10px',
background: 'linear-gradient(135deg, #007970, #007970dd)',
display: 'flex', alignItems: 'center', justifyContent: 'center',
marginBottom: '24px', cursor: 'pointer', flexShrink: 0,
fontSize: '12px', fontWeight: 700, color: '#fff', letterSpacing: '-0.5px',
alignSelf: expanded ? 'flex-start' : 'center',
marginLeft: expanded ? '16px' : 0,
}}
>
CI
</div>
{/* Expand/collapse toggle (visible in expanded state) */}
{expanded && (
<button
onClick={() => setExpanded(false)}
style={{
position: 'absolute', top: '24px', right: '12px',
width: '24px', height: '24px', borderRadius: '6px',
background: 'rgba(255,255,255,0.05)', border: '1px solid rgba(255,255,255,0.12)',
color: 'rgba(255,255,255,0.45)', display: 'flex', alignItems: 'center',
justifyContent: 'center', cursor: 'pointer',
}}
>
<ChevronLeft size={14} />
</button>
)}
{/* Nav items */}
<div style={{
display: 'flex', flexDirection: 'column', gap: '2px', flex: 1,
padding: expanded ? '0 8px' : '0 14px', overflowY: 'auto',
}}>
{NAV_CONFIG.map(item => {
const isActive = activeItem?.id === item.id ||
item.children?.some(c => c.id === activeItem?.id);
const isOpen = openSubmenus.has(item.id);
const isDisabled = item.status === 'phase-3';
const Icon = item.icon;
return (
<div key={item.id}>
{/* Main nav item */}
<div
onClick={() => !isDisabled && handleNavClick(item)}
onMouseEnter={() => !expanded && undefined /* tooltip logic */}
style={{
width: expanded ? '100%' : '40px', height: '40px',
display: 'flex', alignItems: 'center', gap: '12px',
borderRadius: '10px', cursor: isDisabled ? 'not-allowed' : 'pointer',
padding: expanded ? '0 12px' : '0',
justifyContent: expanded ? 'flex-start' : 'center',
color: isActive ? 'rgba(255,255,255,0.95)' : 'rgba(255,255,255,0.45)',
background: isActive ? 'rgba(255,255,255,0.06)' : 'transparent',
border: isActive ? '1px solid rgba(255,255,255,0.12)' : '1px solid transparent',
opacity: isDisabled ? 0.3 : 1,
transition: 'background 120ms ease, border-color 120ms ease, color 120ms ease',
}}
>
<Icon size={20} />
{expanded && (
<motion.span
initial={{ opacity: 0 }}
animate={{ opacity: 1 }}
transition={{ delay: 0.15, duration: 0.2 }}
style={{
fontSize: '13px', fontWeight: 500, flex: 1,
whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis',
}}
>
{item.label}
</motion.span>
)}
{expanded && item.children && item.children.length > 0 && (
<ChevronDown
size={14}
style={{
transform: isOpen ? 'rotate(180deg)' : 'rotate(0deg)',
transition: 'transform 0.3s ease', flexShrink: 0,
}}
/>
)}
</div>
{/* Submenu */}
{expanded && item.children && (
<AnimatePresence>
{isOpen && (
<motion.div
initial={{ height: 0, opacity: 0 }}
animate={{ height: 'auto', opacity: 1 }}
exit={{ height: 0, opacity: 0 }}
transition={{ duration: 0.3, ease: V3_EASE }}
style={{ overflow: 'hidden', paddingLeft: '16px' }}
>
{item.children
.filter(c => c.status !== 'phase-3' && !c.route.includes(':'))
.map(child => {
const isChildActive = activeItem?.id === child.id;
return (
<div
key={child.id}
onClick={() => navigate(child.route)}
style={{
height: '34px', display: 'flex', alignItems: 'center',
paddingLeft: '20px', borderRadius: '8px', cursor: 'pointer',
fontSize: '12px', fontWeight: 500,
color: isChildActive ? 'rgba(255,255,255,0.9)' : 'rgba(255,255,255,0.45)',
background: isChildActive ? 'rgba(255,255,255,0.04)' : 'transparent',
transition: 'background 120ms ease, color 120ms ease',
}}
>
{child.label}
{child.status === 'phase-2' && (
<span style={{
marginLeft: '8px', fontSize: '9px', fontWeight: 600,
padding: '1px 5px', borderRadius: '4px',
background: 'rgba(255,255,255,0.06)',
color: 'rgba(255,255,255,0.3)',
}}>SOON</span>
