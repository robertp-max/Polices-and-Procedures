{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "//": "Designless baseline: build compiles ONLY the neutral scaffold. The preserved process-logic files under src/policy/** are intentionally NOT in include — kept on disk (headless) but not type-checked, bundled, or reachable from the active app. V6 re-includes what it needs.",
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/_scaffold",
    "src/v6",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "src/v6/components/controlled-vertex-ai-compliance-review-harness"
  ]
}
