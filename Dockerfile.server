# syntax=docker/dockerfile:1
#
# Care Indeed Home Health V2 — COMBINED image for Google Cloud Run.
# Serves BOTH the Express API (/api/*, incl. /api/brad) AND the built Vite SPA
# from a single Cloud Run service, so the Brad UI's live actions work end-to-end
# (no 405 from a static-only server). The web-tier-only Dockerfile remains for
# SPA-only deploys.
#
# No secrets are baked into the image. Google/AWS credentials, if ever needed by
# optional routes, are provided at runtime via env / Secret Manager references.

# ---- 1) Build stage: install full deps + produce dist ----
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=true
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build && test -f dist/index.html

# ---- 2) Runtime stage: Express server (via tsx) serving API + dist ----
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
# Bring installed deps (includes tsx), the built SPA, the server source, and the
# tsconfig(s) tsx reads. No src/, no .env, no credentials.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/tsconfig.json ./tsconfig.json
COPY --from=build /app/tsconfig.app.json ./tsconfig.app.json
COPY --from=build /app/tsconfig.node.json ./tsconfig.node.json
EXPOSE 8080
USER node
CMD ["npx", "tsx", "server/index.ts"]
