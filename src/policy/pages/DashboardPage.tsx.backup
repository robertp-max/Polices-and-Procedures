// --- TAXONOMY DATA & HELPER COMPONENTS ---

const getPolicyIcon = (title) => {
  const t = title.toLowerCase();
  if (t.includes('review') || t.includes('audit') || t.includes('investigation') || t.includes('screening')) return Search;
  if (t.includes('security') || t.includes('privacy') || t.includes('hipaa') || t.includes('protection') || t.includes('fraud')) return Shield;
  if (t.includes('approval') || t.includes('compliance') || t.includes('consent') || t.includes('accuracy')) return FileCheck;
  if (t.includes('management') || t.includes('governance') || t.includes('operations')) return Settings;
  if (t.includes('data') || t.includes('record') || t.includes('log')) return Database;
  if (t.includes('safety') || t.includes('risk') || t.includes('emergency') || t.includes('incident') || t.includes('hazard')) return AlertTriangle;
  if (t.includes('finance') || t.includes('billing') || t.includes('payment') || t.includes('cost')) return DollarSign;
  if (t.includes('clinical') || t.includes('care') || t.includes('therapy') || t.includes('assessment')) return Activity;
  if (t.includes('staff') || t.includes('employee') || t.includes('workforce') || t.includes('personnel')) return Users;
  return FileText;
};

