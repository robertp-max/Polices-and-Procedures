                       </div>
                     ))}
                  </div>
               </div>
             </div>
          </div>
        )}

        {/* --- 4. CLINICAL ENFORCEMENT ENGINE TAB --- */}
        {activeSubTab === 'enforcement' && (
          <div className="flex flex-col gap-8 animate-in slide-in-from-bottom-4 duration-500">
             
             {/* Header Rule Setup */}
             <div className="bg-white/[0.02] border border-white/5 rounded-[32px] p-8 flex flex-col md:flex-row gap-8">
                <div className="flex-1">
                   <div className="flex items-center gap-3 mb-4 flex-wrap">
                     <span className="text-[#C74600] text-[10px] font-bold tracking-widest uppercase">DOMAIN CL</span>
                     <span className="text-white/30 text-[10px]">•</span>
                     <span className="text-amber-500 text-[10px] font-bold tracking-widest uppercase">SUBDOMAIN OA</span>
                     <span className="text-white/30 text-[10px]">•</span>
                     <span className="text-[#00c2b4] text-[10px] font-bold tracking-widest uppercase">POLICY CL-OA-006</span>
                   </div>
                   <h2 className="text-2xl font-light text-white mb-4">CL-OA-006 &middot; ACTIVE &middot; REQUIRED &middot; <span className="font-bold">42 CFR §484.55</span></h2>
                   <p className="text-[15px] font-light text-white/70 leading-relaxed max-w-3xl">
                     Establishes a <strong className="text-white font-medium">six-tier evidence hierarchy</strong> governing <strong>which documentation source</strong> holds clinical authority.
                   </p>
                </div>

                <div className="w-full md:w-[400px] bg-white/[0.05] border border-white/10 rounded-[24px] p-6 flex flex-col justify-center shrink-0">
                   <h3 className="text-[#00c2b4] font-bold text-xs uppercase tracking-widest mb-6 flex items-center gap-2"><Key size={16}/> Enforcement Engine Logic</h3>
                   <div className="space-y-6">
                     <div>
                       <p className="text-[15px] font-light text-white/90 mb-1"><span className="font-bold text-[#00c2b4]">CL-OA-006</span> → Governs HOW data is SELECTED</p>
                       <p className="text-[13px] font-light text-white/50">Forces evidence hierarchy application.</p>
                     </div>
                   </div>
                </div>
             </div>

             {/* Evidence Hierarchy Chart */}
             <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div className="lg:col-span-2 bg-white/[0.02] border border-white/5 rounded-[32px] p-8">
