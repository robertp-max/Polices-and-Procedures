const allSubdomainsFlattened = taxonomy.flatMap(d => 
  d.subdomains.map(s => ({ ...s, domainId: d.id, domainColor: d.color, domainBg: d.bg, domainName: d.name }))
);

const ALL_DOMAIN = {
  id: 'ALL',
  name: 'All Domains',
  icon: Layers,
  color: 'text-fuchsia-300',
  bg: 'bg-fuchsia-500/20',
  animation: 'anim-float',
  subdomains: allSubdomainsFlattened
};

const getPoliciesForSubdomain = (domainId, subId, overrideColor, overrideBg) => {
  const list = rawPolicies[`${domainId}-${subId}`] || [];
  return list.map(item => {
    const [idNum, ...titleParts] = item.split(': ');
    const title = titleParts.join(': ');
    const parentDomain = taxonomy.find(d => d.id === domainId);
    const color = overrideColor || (parentDomain ? parentDomain.color : 'text-white');
    const bg = overrideBg || (parentDomain ? parentDomain.bg : 'bg-white/10');
    const domainName = parentDomain ? parentDomain.name : 'Unknown Domain';
    
    return { id: `${domainId}-${subId}-${idNum}`, title, icon: getPolicyIcon(title), color, bg, domainName };
  });
};

