function TaxonomyView() {
  const [activeDomain, setActiveDomain] = useState(ALL_DOMAIN);
  const [activeSubdomain, setActiveSubdomain] = useState({ id: 'ALL', name: 'All Subdomains', icon: Layout, animation: 'anim-float' });
  const [activePolicy, setActivePolicy] = useState(null);

  const handleDomainClick = (domain) => {
    setActiveDomain(domain);
    setActiveSubdomain({ id: 'ALL', name: `All ${domain.id === 'ALL' ? '' : domain.id + ' '}Subdomains`, icon: Layout, animation: 'anim-float' });
    setActivePolicy(null);
  };

  const handleSubdomainClick = (sub) => {
    setActiveSubdomain(sub);
    setActivePolicy(null);
  };

  const subdomainsToRender = [
    { id: 'ALL', name: activeDomain.id === 'ALL' ? 'All Subdomains' : `All ${activeDomain.id} Subdomains`, icon: Layout, animation: 'anim-float' },
    ...activeDomain.subdomains
  ];

  const activePolicies = useMemo(() => {
    if (activeDomain.id === 'ALL') {
      if (activeSubdomain.id === 'ALL') {
        return taxonomy.flatMap(d => d.subdomains.flatMap(s => getPoliciesForSubdomain(d.id, s.id, d.color, d.bg)));
      }
      return getPoliciesForSubdomain(activeSubdomain.domainId, activeSubdomain.id, activeSubdomain.domainColor, activeSubdomain.domainBg);
    }
    if (activeSubdomain.id === 'ALL') {
      return activeDomain.subdomains.flatMap(sub => getPoliciesForSubdomain(activeDomain.id, sub.id, activeDomain.color, activeDomain.bg));
    }
    return getPoliciesForSubdomain(activeDomain.id, activeSubdomain.id, activeDomain.color, activeDomain.bg);
  }, [activeDomain, activeSubdomain]);

  const getSubdomainCount = (domain, sub) => {
    if (sub.id === 'ALL') {
      if (domain.id === 'ALL') return 244;
      return domain.subdomains.reduce((acc, s) => acc + (rawPolicies[`${domain.id}-${s.id}`] || []).length, 0);
    }
    const targetDomainId = sub.domainId || domain.id;
    return (rawPolicies[`${targetDomainId}-${sub.id}`] || []).length;
  };

  return (
    <div className="flex-1 w-full h-full flex flex-col relative z-10 font-sans animate-in fade-in duration-500 overflow-y-auto custom-scrollbar p-6 md:p-10 pt-2">
      
      {/* VERTICAL HIERARCHY LAYOUT */}
      <div className="flex-1 w-full flex flex-col gap-6 relative z-10 min-h-0">
        
        {/* LEVEL 1: DOMAINS ROW */}
        {!activePolicy && (
          <section className="shrink-0 flex flex-col transition-all duration-500">
            <div className="flex items-center gap-3 mb-4 px-1">
              <span className="text-[10px] font-bold text-[#00c2b4] uppercase tracking-widest">Level 1</span>
              <h2 className="text-xs font-bold text-white/80 uppercase tracking-widest">Primary Domains</h2>
            </div>
            <div className="flex overflow-x-auto custom-scrollbar-x pb-4 gap-2 px-1 border-b border-white/10">
              {[ALL_DOMAIN, ...taxonomy].map((domain) => {
                const Icon = domain.icon;
                const isActive = activeDomain.id === domain.id;
                
                return (
                  <button 
                    key={domain.id}
                    onClick={() => handleDomainClick(domain)}
                    className={`group flex items-center gap-3 p-3 pr-6 rounded-2xl transition-all duration-300 shrink-0
                      ${isActive 
                        ? 'border border-[#00c2b4] bg-[#00c2b4]/10' 
                        : 'border border-transparent hover:bg-white/5 opacity-60 hover:opacity-100'
                      }`}
                  >
                    <div className={`flex items-center justify-center w-10 h-10 rounded-xl bg-transparent ${isActive ? domain.color : 'text-white/80 group-hover:text-white'}`}>
                      <Icon className={`w-5 h-5 ${domain.animation}`} strokeWidth={1.5} />
                    </div>
                    <div className="text-left">
                      <div className="text-[10px] font-bold uppercase tracking-[0.2em] leading-none mb-1 opacity-50">{domain.id}</div>
                      <div className={`text-[14px] font-light leading-none ${isActive ? 'text-white' : 'text-white/80'}`}>
                        {domain.name}
                      </div>
                    </div>
                  </button>
                );
              })}
            </div>
          </section>
        )}

        {/* LEVEL 2: SUBDOMAINS ROW */}
        {!activePolicy && (
          <section className="shrink-0 flex flex-col transition-all duration-500">
            <div className="flex items-center gap-3 mb-4 px-1">
              <span className="text-[10px] font-bold text-[#C74600] uppercase tracking-widest">Level 2</span>
              <ChevronRight className="w-3 h-3 text-white/40" />
              <h2 className="text-xs font-bold text-white/80 uppercase tracking-widest">Subdomains for {activeDomain.name}</h2>
            </div>
            <div className="flex overflow-x-auto custom-scrollbar-x pb-4 gap-2 px-1 border-b border-white/10">
              {subdomainsToRender.map((sub) => {
                const SubIcon = sub.icon;
                const isActive = activeSubdomain?.id === sub.id;
                const subColor = sub.id === 'ALL' ? activeDomain.color : (sub.domainColor || activeDomain.color);
                const count = getSubdomainCount(activeDomain, sub);
                const labelId = sub.id === 'ALL' ? 'ALL' : `${sub.domainId || activeDomain.id}-${sub.id}`;
                
                return (
                  <button 
                    key={`${sub.domainId || 'ALL'}-${sub.id}`} 
                    onClick={() => handleSubdomainClick(sub)}
                    className={`group flex items-center gap-3 p-3 pr-6 rounded-2xl transition-all duration-300 shrink-0
                      ${isActive 
                        ? 'border border-[#C74600] bg-[#C74600]/10' 
                        : 'border border-transparent hover:bg-white/5 opacity-60 hover:opacity-100'
                      }`}
                  >
                    <div className={`flex items-center justify-center w-10 h-10 rounded-xl bg-transparent ${isActive ? subColor : 'text-white/80 group-hover:text-white'}`}>
                      <SubIcon className={`w-5 h-5 ${isActive ? sub.animation : ''}`} strokeWidth={1.5} />
                    </div>
                    <div className="text-left">
                      <div className="flex items-center gap-2 mb-1">
                        <div className="text-[10px] font-bold uppercase tracking-[0.2em] leading-none opacity-50">
                          {labelId}
                        </div>
                        <div className="text-[9px] font-medium opacity-50 leading-none">
                          {count} Policies
                        </div>
                      </div>
                      <div className={`text-[14px] font-light leading-none ${isActive ? 'text-white' : 'text-white/80'}`}>
                        {sub.name}
                      </div>
                    </div>
                  </button>
                );
              })}
            </div>
          </section>
        )}

        {/* LEVEL 3: POLICIES GRID OR DOCUMENT VIEWER */}
        <section className={`flex-1 flex flex-col overflow-hidden min-h-0 relative`}>
          
          {/* STATE A: POLICY GRID */}
          {!activePolicy && (
            <>
              <div className="py-2 shrink-0 flex items-center justify-between px-1 mt-2">
                <div className="flex items-center gap-3">
                  <span className="text-[10px] font-bold text-white/50 uppercase tracking-widest">Level 3</span>
                  <ChevronRight className="w-3 h-3 text-white/40" />
                  <h2 className="text-[11px] font-bold text-white/80 uppercase tracking-widest">
                    Policies & Procedures: {activeSubdomain.id === 'ALL' ? `All contained in ${activeDomain.name}` : `${activeSubdomain.domainId || activeDomain.id}-${activeSubdomain.id} ${activeSubdomain.name}`}
                  </h2>
                </div>
                <div className="text-[10px] font-bold text-white/50 uppercase tracking-widest">
                  Showing {activePolicies.length} Documents
                </div>
              </div>

              <div className="flex-1 overflow-y-auto custom-scrollbar pt-2 pb-8">
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  {activePolicies.map((policy) => {
                    const PolicyIcon = policy.icon;
                    return (
                      <button 
                        key={policy.id} 
                        onClick={() => setActivePolicy(policy)}
                        className="group text-left flex items-start gap-4 p-5 rounded-2xl bg-transparent hover:bg-white/[0.03] transition-all duration-300 h-full border border-white/10 hover:border-white/20"
                      >
                        <div className={`flex items-center justify-center w-10 h-10 rounded-xl bg-transparent ${policy.color} shrink-0`}>
                          <PolicyIcon className="w-5 h-5 anim-float" strokeWidth={1.5} />
                        </div>
                        <div className="flex-1 min-w-0 flex flex-col justify-center">
                          <div className="mb-2">
                            <span className="inline-block text-[10px] font-bold text-white/50 px-2 py-0.5 rounded leading-none border border-white/10 tracking-widest">
                              {policy.id}
                            </span>
                          </div>
                          <h5 className="text-[15px] font-light text-white/80 leading-snug group-hover:text-white transition-colors">
                            {policy.title}
                          </h5>
                        </div>
                      </button>
                    );
                  })}
                </div>
              </div>
            </>
          )}

          {/* STATE B: DOCUMENT VIEWER */}
          {activePolicy && (
            <div className="flex flex-col h-full bg-transparent border border-white/10 rounded-[32px] w-full animate-in fade-in duration-500 overflow-hidden relative">
              <div className="p-8 md:px-12 bg-transparent shrink-0 border-b border-white/5">
                <div className="flex justify-between items-start mb-8">
                  <div>
                    <button 
                      onClick={() => setActivePolicy(null)}
                      className="flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#00c2b4] hover:text-white mb-6 transition-colors"
                    >
                      <ChevronLeft className="w-4 h-4" /> Policy Taxonomy
                    </button>
                    <div className="flex items-center gap-3 mb-4">
                       <span className="text-[10px] font-bold text-white border border-white/20 px-3 py-1 rounded-full uppercase tracking-widest">{activePolicy.id}</span>
                       <span className="text-[10px] font-bold text-[#C74600] border border-[#C74600]/30 bg-[#C74600]/10 px-3 py-1 rounded-full uppercase tracking-widest">DRAFT</span>
                       <span className="text-[10px] font-bold text-white border border-white/20 bg-white/5 px-3 py-1 rounded-full uppercase tracking-widest">REQUIRED</span>
                    </div>
                    <h2 className="text-3xl md:text-5xl font-light text-white tracking-tight leading-tight max-w-4xl">{activePolicy.title}</h2>
                  </div>
                  <button className="hidden sm:flex items-center gap-2 bg-transparent hover:bg-white/10 px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-widest text-white transition-all border border-white/20">
                    <Printer className="w-4 h-4" /> Export
                  </button>
                </div>
                
                <div className="grid grid-cols-2 md:grid-cols-4 gap-6 text-[10px] font-bold text-white/50 uppercase tracking-widest">
                  <div>
                    <div className="mb-1.5">Domain</div>
                    <div className="text-white/90 text-sm normal-case tracking-normal font-light">{activePolicy.domainName || 'Governance & Administration'}</div>
                  </div>
                  <div>
                    <div className="mb-1.5">Tier</div>
                    <div className="text-white/90 text-sm normal-case tracking-normal font-light">REQUIRED</div>
                  </div>
                  <div>
                    <div className="mb-1.5">Approved By</div>
                    <div className="text-white/90 text-sm normal-case tracking-normal font-light">Governing Body Chair</div>
                  </div>
                  <div>
                    <div className="mb-1.5">Version</div>
                    <div className="text-white/90 text-sm normal-case tracking-normal font-light">v6.0</div>
                  </div>
                </div>
              </div>

              <div className="flex-1 overflow-y-auto p-8 md:p-12 space-y-10 custom-scrollbar bg-transparent"> 
                 <div className="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div className="bg-transparent border-l-[3px] border-[#00c2b4] pl-6">
                       <h3 className="flex items-center gap-3 text-lg font-bold text-white mb-4 uppercase tracking-widest">
                         <Target className="w-5 h-5 text-[#00c2b4]"/> 2. Purpose
                       </h3>
                       <p className="text-[15px] font-light text-white/70 leading-relaxed">
                         This policy establishes requirements for scheduling, conducting, and documenting official business. Proper documentation is a primary surveyor focus and a fundamental requirement for compliance.
                       </p>
                    </div>
                    <div className="bg-transparent border-l-[3px] border-[#C74600] pl-6">
                       <h3 className="flex items-center gap-3 text-lg font-bold text-white mb-5 uppercase tracking-widest">
                         <Search className="w-5 h-5 text-[#C74600]"/> 3. Scope
                       </h3>
                       <ul className="space-y-4">
                          <li className="flex items-start gap-4 text-[15px] font-light text-white/70 leading-snug">
                            <CheckCircle className="w-5 h-5 text-[#C74600] shrink-0 mt-0.5"/> 
                            All members of the Governing Body and clinical staff
                          </li>
                          <li className="flex items-start gap-4 text-[15px] font-light text-white/70 leading-snug">
                            <CheckCircle className="w-5 h-5 text-[#C74600] shrink-0 mt-0.5"/> 
                            The Administrator responsible for agenda preparation
                          </li>
                       </ul>
                    </div>
                 </div>
              </div>
            </div>
          )}
        </section>
      </div>
    </div>
  );
}

// --- IBM FRAMEWORK VIEW ---

function IBMFrameworkView() {
  const [activeSubTab, setActiveSubTab] = useState('hierarchy');

  const fwTabs = [
    { id: 'hierarchy', label: 'System Hierarchy', icon: Layers },
    { id: 'lifecycle', label: 'Governance Lifecycle', icon: RefreshCw },
    { id: 'dictionary', label: 'Classification Dictionary', icon: BookOpen },
    { id: 'enforcement', label: 'Clinical Enforcement Engine', icon: Scale },
    { id: 'audit', label: 'Audit Defense System', icon: AlertTriangle },
  ];

  return (
    <div className="flex-1 w-full h-full flex flex-col relative z-10 font-sans animate-in fade-in duration-500 overflow-hidden p-6 md:p-10 pt-2">

      {/* Dynamic Tabs */}
      <div className="shrink-0 mb-8 relative z-10">
        <div className="flex gap-6 overflow-x-auto custom-scrollbar-x pb-2">
          {fwTabs.map(tab => {
            const Icon = tab.icon;
            const isActive = activeSubTab === tab.id;
            return (
              <button
                key={tab.id}
                onClick={() => setActiveSubTab(tab.id)}
                className={`flex items-center gap-3 pb-3 transition-all whitespace-nowrap font-bold text-xs uppercase tracking-widest border-b-2
                  ${isActive 
                    ? 'text-[#00c2b4] border-[#00c2b4]' 
                    : 'text-white/40 border-transparent hover:text-white/80'
                  }`}
              >
                <Icon size={16} className={isActive ? 'text-[#00c2b4]' : ''} />
                {tab.label}
              </button>
            );
          })}
        </div>
      </div>

      {/* CONTENT AREA */}
      <div className="flex-1 overflow-y-auto custom-scrollbar relative z-10 pb-8 pr-2">
        
        {/* --- 1. SYSTEM HIERARCHY TAB --- */}
        {activeSubTab === 'hierarchy' && (
          <div className="flex flex-col gap-8 animate-in slide-in-from-bottom-4 duration-500">
            {/* Top Stats Cards */}
            <div className="grid grid-cols-2 lg:grid-cols-4 gap-6">
               {[
                 { val: '10', label: 'Top-Level Categories', icon: Layers, c: 'text-[#00c2b4]' },
                 { val: '42', label: 'Structural Pillars', icon: Network, c: 'text-amber-400' },
                 { val: '244', label: 'Managed Artifacts', icon: FileText, c: 'text-[#ff8e52]' },
                 { val: '100%', label: 'IBM Watson Logic', icon: Shield, c: 'text-emerald-400' }
               ].map((stat, i) => {
                 const StatIcon = stat.icon;
                 return (
                 <div key={i} className="bg-white/[0.02] p-6 flex items-center justify-between border border-white/5 rounded-2xl transition-transform hover:-translate-y-1">
                    <div>
                      <div className={`text-4xl font-light ${stat.c} mb-2`}>{stat.val}</div>
                      <div className="text-[10px] font-bold text-white/50 uppercase tracking-widest">{stat.label}</div>
                    </div>
                    <div className={`opacity-50 ${stat.c}`}>
                      <StatIcon size={32} strokeWidth={1} />
                    </div>
                 </div>
                 )
               })}
            </div>

            {/* Architecture Diagram & Sidebar */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
              <div className="lg:col-span-2 bg-white/[0.02] border border-white/5 rounded-[32px] p-10 flex flex-col items-center justify-center gap-6 min-h-[500px]">
                 
                 {/* Layer 0 */}
                 <div className="w-full max-w-2xl bg-emerald-500/5 border border-emerald-500/20 rounded-2xl p-6 flex flex-col items-center justify-center relative">
                    <span className="text-emerald-400 font-bold text-xs tracking-widest uppercase mb-3 text-center">Layer 0: Regulatory Compliance Foundation</span>
                    <div className="flex flex-wrap justify-center gap-4 md:gap-8 text-[11px] text-emerald-200/50 font-medium tracking-wider">
                      <span>42 CFR Part 484</span><span>HIPAA Privacy/Security</span><span>OSHA Standards</span><span>OIG Compliance</span>
                    </div>
