                        </div>
                        <div className="w-full bg-white/5 h-[3px] rounded-full overflow-hidden">
                          <div className="bg-emerald-400 h-full w-[90%] shadow-[0_0_15px_rgba(52,211,153,1)]"></div>
                        </div>
                     </div>
                     {/* Level 3 */}
                     <div className="relative mt-6">
                        <div className="flex justify-between items-center mb-2">
                          <h4 className="font-light text-white text-lg">3. Standardized Tools</h4>
                          <span className="text-amber-400 text-[10px] font-bold tracking-widest uppercase">Low Risk</span>
                        </div>
                        <div className="w-full bg-white/5 h-[3px] rounded-full overflow-hidden">
                          <div className="bg-amber-400 h-full w-[70%] shadow-[0_0_15px_rgba(251,191,36,1)]"></div>
                        </div>
                     </div>
                   </div>
                </div>

                {/* Right Sidebar */}
                <div className="flex flex-col gap-8">
                   <div className="bg-white/[0.02] border border-white/5 rounded-[32px] p-8">
                      <h3 className="text-red-400 font-bold text-sm tracking-widest uppercase mb-6 flex items-center gap-3">
                        <AlertTriangle size={18}/> Common Violations
                      </h3>
                      <div className="space-y-6">
                         <div className="flex items-start justify-between gap-4">
                            <span className="text-[14px] font-light text-white/80 leading-snug">Coding GG from hospital discharge summary</span>
                            <span className="text-[10px] font-bold border border-purple-500/50 text-purple-400 px-2 py-0.5 rounded">FCA</span>
                         </div>
                         <div className="flex items-start justify-between gap-4">
                            <span className="text-[14px] font-light text-white/80 leading-snug">No true evidence for OASIS M1800</span>
                            <span className="text-[10px] font-bold border border-red-500/50 text-red-400 px-2 py-0.5 rounded">ADR</span>
                         </div>
                      </div>
                   </div>
                </div>
             </div>
          </div>
        )}

        {/* --- 5. AUDIT DEFENSE SYSTEM TAB --- */}
        {activeSubTab === 'audit' && (
          <div className="flex flex-col gap-8 animate-in slide-in-from-bottom-4 duration-500">
            
            <div className="bg-transparent mb-4">
               <h2 className="text-white font-light text-3xl mb-2">AUDIT DEFENSE ARCHITECTURE</h2>
               <p className="text-sm font-light text-white/50 tracking-wide uppercase"><span className="text-[#C74600] font-bold">PROBLEM</span> → <span className="text-[#00c2b4] font-bold">POLICY</span> → <span className="text-purple-400 font-bold">CONTROL</span></p>
            </div>

            <div className="grid grid-cols-1 gap-8">
               {/* Survey Validation Row */}
               <div className="bg-white/[0.02] border border-white/5 rounded-[32px] overflow-hidden">
                  <div className="border-b border-white/5 p-6 md:px-8">
                     <h3 className="text-[#ff8e52] font-bold text-sm tracking-widest uppercase">CMS Survey / OASIS Validation</h3>
                  </div>
                  <div className="p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
                     <div className="bg-transparent border-l-[3px] border-[#ff8e52] pl-5">
                        <span className="text-[10px] font-bold text-[#ff8e52] uppercase tracking-widest mb-2 block">Problem</span>
                        <p className="text-[14px] font-light text-white/80 leading-relaxed">M-item scored high, but clinical documentation states "patient ambulates independently". Direct conflict.</p>
                     </div>
                     <div className="bg-transparent border-l-[3px] border-[#00c2b4] pl-5 flex flex-col justify-center">
                        <span className="text-[10px] font-bold text-[#00c2b4] uppercase tracking-widest mb-2 block">Policy Link</span>
                        <span className="text-xl font-bold text-white mb-1">CL-OA-006</span>
                        <span className="text-red-500 text-[10px] font-bold uppercase tracking-widest">CRITICAL</span>
                     </div>
                     <div className="bg-transparent border-l-[3px] border-purple-400 pl-5">
                        <span className="text-[10px] font-bold text-purple-400 uppercase tracking-widest mb-2 block">Control</span>
                        <p className="text-[14px] font-light text-white/80 leading-relaxed">Level 1/2 Evidence hierarchy enforced. Surveyor cannot cite conflict if explicitly justified per policy.</p>
                     </div>
                  </div>
               </div>

               {/* ADR Row */}
               <div className="bg-white/[0.02] border border-white/5 rounded-[32px] overflow-hidden">
                  <div className="border-b border-white/5 p-6 md:px-8">
                     <h3 className="text-red-400 font-bold text-sm tracking-widest uppercase">Additional Documentation Request (ADR)</h3>
                  </div>
                  <div className="p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
                     <div className="bg-transparent border-l-[3px] border-red-400 pl-5">
                        <span className="text-[10px] font-bold text-red-400 uppercase tracking-widest mb-2 block">Problem</span>
                        <p className="text-[14px] font-light text-white/80 leading-relaxed">Narrative text diverges heavily from OASIS items. MAC reviewer determines OASIS is artificially inflated.</p>
                     </div>
                     <div className="bg-transparent border-l-[3px] border-[#00c2b4] pl-5 flex flex-col justify-center">
                        <span className="text-[10px] font-bold text-[#00c2b4] uppercase tracking-widest mb-2 block">Policy Link</span>
                        <span className="text-xl font-bold text-white mb-1">CL-OA-007</span>
                     </div>
                     <div className="bg-transparent border-l-[3px] border-purple-400 pl-5">
                        <span className="text-[10px] font-bold text-purple-400 uppercase tracking-widest mb-2 block">Control</span>
                        <p className="text-[14px] font-light text-white/80 leading-relaxed">Policy enforces "cross-document verification". QA flow blocks OASIS locking if primary assessment contradicts.</p>
                     </div>
                  </div>
               </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}

// Export DashboardView as DashboardPage for routing
export const DashboardPage = DashboardView;

export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard');

  const currentNav = NAV_ITEMS.find(item => item.id === activeTab) || NAV_ITEMS[0];
  const CurrentNavIcon = currentNav.icon;

  return (
    <>
      <style>
        {`
          @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Roboto:wght@300;400;500;700&display=swap');
          
          .font-montserrat { font-family: 'Montserrat', sans-serif; }
          .font-roboto { font-family: 'Roboto', sans-serif; }

          /* Elegant custom scrollbar implementation */
          .custom-scrollbar::-webkit-scrollbar, .custom-scrollbar-x::-webkit-scrollbar {
            width: 8px;
            height: 8px;
          }
          .custom-scrollbar::-webkit-scrollbar-track, .custom-scrollbar-x::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 10px;
          }
          .custom-scrollbar::-webkit-scrollbar-thumb, .custom-scrollbar-x::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            border: 2px solid transparent;
            background-clip: padding-box;
          }
          .custom-scrollbar::-webkit-scrollbar-thumb:hover, .custom-scrollbar-x::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
            border: 2px solid transparent;
            background-clip: padding-box;
          }

          @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
          .anim-float { animation: float 90s ease-in-out infinite; }
          
          @keyframes heartbeat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.15); } 30% { transform: scale(1); } 45% { transform: scale(1.15); } 60% { transform: scale(1); } }
          @keyframes wiggle { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(-8deg); } 75% { transform: rotate(8deg); } }
          @keyframes flip { 0% { transform: perspective(400px) rotateY(0); } 100% { transform: perspective(400px) rotateY(360deg); } }
          @keyframes spin-slow { 100% { transform: rotate(360deg); } }
          @keyframes bounce-subtle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
          
          .group:hover .anim-heartbeat { animation: heartbeat 36s ease-in-out infinite; }
          .group:hover .anim-wiggle { animation: wiggle 15s ease-in-out infinite; }
          .group:hover .anim-spin { animation: spin-slow 90s linear infinite; }
          .group:hover .anim-flip { animation: flip 30s ease-in-out; }
          .group:hover .anim-bounce { animation: bounce-subtle 30s ease-in-out infinite; }

          /* Rich, moving diagonal gradient */
          @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
          }
          .bg-animated-gradient {
            background: linear-gradient(-45deg, #0d9488, #7e22ce, #f97316, #0d9488);
            background-size: 300% 300%;
            animation: gradientMove 20s ease infinite;
          }
        `}
      </style>

      {/* Deep Animated Gradient Background Root */}
      <div className="fixed inset-0 bg-animated-gradient flex items-center justify-center overflow-hidden p-4 md:p-8">

        {/* Cinematic 16:9 Letterbox Container (Strict Aspect Ratio) */}
        <div className="relative w-full aspect-video max-h-full max-w-[calc(100vh*16/9)] bg-[#050505]/70 backdrop-blur-3xl rounded-3xl md:rounded-[40px] border border-white/20 shadow-[0_0_80px_rgba(0,0,0,0.8)] overflow-hidden">
          
          {/* Inner Scaling Wrapper: Scales all content down by 33% (0.67 scale factor) */}
          <div 
            className="flex"
            style={{
              width: 'calc(100% / 0.67)',
              height: 'calc(100% / 0.67)',
              transform: 'scale(0.67)',
              transformOrigin: 'top left'
            }}
          >
            {/* TEXT-BASED LEFT NAVIGATION */}
            <nav className="w-64 md:w-[280px] border-r border-white/5 flex flex-col p-6 md:p-8 pt-8 md:pt-10 shrink-0 custom-scrollbar overflow-y-auto">
               <img 
                 src="https://policies-and-procedures-xkng.vercel.app/assets/CI%20Home%20Health%20Logo_White-DfgJTkII-DfgJTkII.png" 
                 alt="Care Indeed" 
                 className="h-8 w-auto opacity-90 object-contain mb-10 md:mb-12 pointer-events-none self-start shrink-0"
               />
               
               <div className="flex flex-col gap-1 flex-1 shrink-0">
                  {NAV_ITEMS.map((item) => {
                    const isActive = activeTab === item.id;
                    return (
                      <div key={item.id} className="flex flex-col shrink-0">
                        <button
                          onClick={() => setActiveTab(item.id)}
                          className="flex items-center justify-between w-full text-left py-3 group"
                        >
                          <span className={`text-[15px] md:text-[17px] font-light transition-colors ${isActive ? 'text-white' : 'text-white/40 group-hover:text-white/70'}`}>
                            {item.label}
                          </span>
                          <ChevronRight size={14} className={`transition-colors ${isActive ? 'text-[#00c2b4]' : 'text-white/10 group-hover:text-white/30'}`} />
                        </button>
                        
                        {/* Nested Active Indicator (Expanded SubItems array) */}
                        {isActive && item.subItems && (
                          <div className="pl-4 py-2 flex flex-col gap-4 animate-in slide-in-from-top-2 duration-300">
                            {item.subItems.map((sub, idx) => (
                              <div key={idx} className="flex items-center gap-4 cursor-pointer group/sub">
                                <div className={`w-1.5 h-1.5 rounded-full ${idx === 0 ? 'bg-[#00c2b4] shadow-[0_0_10px_#00c2b4]' : 'bg-white/20 group-hover/sub:bg-white/50 transition-colors'}`}></div>
                                <span className={`font-bold text-[10px] md:text-[11px] tracking-widest uppercase transition-colors ${idx === 0 ? 'text-white' : 'text-white/40 group-hover/sub:text-white/70'}`}>{sub}</span>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    );
                  })}
               </div>
               
               <div className="mt-8 pt-8 flex flex-col gap-6 shrink-0 border-t border-white/5">
                 {/* Help Center */}
                 <button className="flex items-center gap-3 text-white/40 hover:text-white transition-colors group">
                    <HelpCircle size={18} className="group-hover:text-[#00c2b4] transition-colors" />
                    <span className="text-[13px] font-medium tracking-wide">Help Center</span>
                 </button>
                 
                 <div>
                   <div className="text-white/30 text-[10px] font-bold tracking-[0.2em] mb-4 uppercase">System Info</div>
                   <div className="flex items-center gap-4 cursor-pointer group">
                      <div className="w-10 h-10 rounded-full bg-gradient-to-br from-[#007970] to-[#004a45] flex items-center justify-center text-white font-bold text-sm shadow-md group-hover:scale-105 transition-transform relative">
                        JD
                        <div className="absolute top-0 right-0 w-2.5 h-2.5 rounded-full bg-[#00c2b4] shadow-[0_0_8px_rgba(0,194,180,0.8)]"></div>
                      </div>
                      <div>
                        <p className="text-white/80 text-sm font-light">John Doe</p>
                        <p className="text-white/40 text-[10px] tracking-widest uppercase">Admin</p>
                      </div>
                   </div>
                 </div>
               </div>
            </nav>

            {/* MAIN CONTENT AREA */}
            <main className="flex-1 flex flex-col relative z-10 w-full overflow-hidden">
              
              {/* INTEGRATED TOP BAR */}
              <header className="w-full px-6 md:px-10 pt-8 md:pt-10 pb-4 flex items-start justify-between shrink-0">
                 <div className="flex flex-col gap-1.5">
                    <h1 className="text-[#00c2b4] text-[10px] md:text-[11px] font-bold tracking-[0.25em] uppercase">Policy Taxonomy</h1>
                    <p className="text-white/40 text-[9px] md:text-[10px] font-bold tracking-[0.2em] uppercase">Context: {currentNav.label}</p>
                 </div>
                 
                 <div className="flex items-center gap-4 md:gap-8">
                    {/* Glass Search Bar */}
                    <div className="hidden sm:flex items-center bg-white/[0.03] border border-white/10 rounded-full px-5 py-2.5 w-48 md:w-64 focus-within:border-[#00c2b4]/50 focus-within:bg-white/[0.05] transition-all">
                      <Search size={14} className="text-white/30 mr-3 shrink-0" />
                      <input 
                        type="text" 
                        placeholder="Search policies..." 
                        className="bg-transparent border-none outline-none text-white text-xs w-full placeholder-white/30 font-light" 
                      />
                    </div>
                 </div>
              </header>

              {/* Page Content Scrollable Area */}
              <div className="flex-1 w-full h-full relative overflow-hidden">
                {activeTab === 'taxonomy' ? (
                  <div className="absolute inset-0"><TaxonomyView /></div>
                ) : activeTab === 'framework' ? (
                  <div className="absolute inset-0"><IBMFrameworkView /></div>
                ) : activeTab === 'dashboard' ? (
                  <div className="absolute inset-0"><DashboardView /></div>
                ) : activeTab === 'calendar' ? (
                  <div className="absolute inset-0"><CalendarView /></div>
                ) : (
                  <div className="p-10 w-full space-y-8 h-full flex flex-col items-center justify-center text-center">
                    <div className="p-8 rounded-full bg-white/[0.02] border border-white/5 mb-6">
                      <CurrentNavIcon size={48} className="text-[#00c2b4] opacity-50 anim-float" strokeWidth={1} />
                    </div>
                    <h2 className="text-3xl font-light text-white tracking-tight mb-2">{currentNav.label}</h2>
                    <p className="text-[15px] font-light text-white/50 max-w-md leading-relaxed">
                      This module is currently under construction in the IBM framework. Please check back later.
                    </p>
                  </div>
                )}
              </div>

            </main>
          </div>
        </div>
      </div>
    </>
  );
}