                 <tr className="hover:bg-white/5 transition-colors border-b border-transparent">
                    <td className="p-8">
                       <p className="text-white font-bold mb-2">Comprehensive policy review</p>
                       <p className="text-white/50 text-xs">CAL-021</p>
                    </td>
                    <td className="p-8 text-white/80">Calendar</td>
                    <td className="p-8 text-white/80">Day 5</td>
                    <td className="p-8">
                       <span className="bg-[#C74600]/20 text-[#ff8e52] border border-[#C74600]/50 font-bold text-xs px-3 py-1 rounded shadow-[0_0_8px_rgba(199,70,0,0.3)]">ESCALATION</span>
                    </td>
                    <td className="p-8 text-right">
                       <a href="#" className="text-white font-bold hover:text-[#00c2b4] transition-colors flex items-center justify-end gap-1 text-sm">
                          Initiate Review <ChevronRight size={16}/>
                       </a>
                    </td>
                 </tr>
               </tbody>
            </table>
         </div>
      </div>
    </div>
  );
}

