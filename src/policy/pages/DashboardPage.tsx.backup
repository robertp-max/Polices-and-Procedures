      {/* Urgent Action Required Table */}
      <div className="bg-white/[0.03] border border-white/5 rounded-2xl overflow-hidden relative z-10">
         <div className="p-8 border-b border-white/5">
            <h3 className="text-red-400 font-bold text-base tracking-widest uppercase flex items-center gap-2">
               <AlertTriangle size={22} /> Urgent Action Required
            </h3>
         </div>
         <div className="w-full overflow-x-auto custom-scrollbar-x">
            <table className="w-full text-left border-collapse min-w-[600px]">
               <thead>
                 <tr className="text-xs font-bold text-white/40 uppercase tracking-widest border-b border-white/5">
                    <th className="p-8 font-medium">Task / ID</th>
                    <th className="p-8 font-medium">Module</th>
