                    <span className="text-[#ff8e52] font-bold text-xs tracking-widest uppercase mb-6 text-center">Architecture Level 1: 10 Strategic Domains</span>
                    <div className="flex flex-wrap justify-center gap-3">
                       {['GV', 'CL', 'QA', 'HR', 'CO', 'FN', 'OP', 'IT', 'RM', 'EN'].map(d => (
                         <span key={d} className="bg-black/30 border border-[#ff8e52]/30 text-[#ff8e52] px-4 py-2 rounded-xl text-sm font-bold">{d}</span>
                       ))}
                    </div>
