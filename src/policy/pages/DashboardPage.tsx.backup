               </thead>
               <tbody className="text-base">
                 <tr className="border-b border-white/5 hover:bg-white/5 transition-colors">
                    <td className="p-8">
                       <p className="text-white font-bold mb-2">Quarterly clinical record aggregate report</p>
                       <p className="text-white/50 text-xs">AUD-001</p>
                    </td>
                    <td className="p-8 text-white/80">Auditor</td>
                    <td className="p-8 text-white/80">Day 2</td>
                    <td className="p-8">
                       <span className="bg-red-500/20 text-red-400 border border-red-500/50 font-bold text-xs px-3 py-1 rounded shadow-[0_0_8px_rgba(239,68,68,0.3)]">CRITICAL</span>
                    </td>
