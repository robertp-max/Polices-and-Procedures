import { useCalendarStore } from '@/policy/stores/calendarStore';
import {
  Calendar, FileText, Clock, AlertCircle, CheckCircle,
  AlertTriangle, ChevronRight, ShieldCheck, BookOpen, BarChart2,
  Download, Plus,
} from 'lucide-react';

const STATUS_BADGE: Record<string, string> = {
  COMPLETED: 'bg-[#007970] text-white border-transparent',
  'DUE SOON': 'bg-[#C74600] text-white border-transparent',
  UPCOMING: 'bg-slate-500 text-white border-transparent',
  OVERDUE: 'bg-[#DC2626] text-white border-transparent',
  'On Track': 'bg-[#007970] text-white border-transparent',
  Warning: 'bg-[#D97706] text-white border-transparent',
  Escalation: 'bg-[#C74600] text-white border-transparent',
  Completed: 'bg-[#007970] text-white border-transparent',
};

const MODULE_BADGE: Record<string, string> = {
  Clinical: 'border border-white/30 text-white/80 bg-white/10',
  QAPI: 'border border-[#00c2b4]/30 text-[#00c2b4] bg-white/10',
  Governance: 'border border-[#ff8e52]/30 text-[#ff8e52] bg-white/10',
  Finance: 'border border-amber-400/30 text-amber-400 bg-white/10',
};

function getDisplayStatus(status: string) {
  const map: Record<string, string> = {
    'On Track': 'UPCOMING',
    Completed: 'COMPLETED',
    Warning: 'DUE SOON',
    Escalation: 'OVERDUE',
  };
  return map[status] ?? status;
}

function StatusKpiCard({ status, count, desc, icon, textColor, bgIconClass }: {
  status: string; count: number | string; desc: string; icon: React.ReactNode;
  textColor: string; bgIconClass: string;
}) {
  return (
    <div className="bg-white/[0.03] backdrop-blur-md rounded-2xl p-6 border border-white/5 shadow-sm transition-transform hover:-translate-y-1 cursor-default">
      <div className="flex justify-between items-start mb-4">
        <div className={`p-2 rounded-lg ${bgIconClass}`}>{icon}</div>
      </div>
      <div className="text-5xl font-light text-white mt-2">{count}</div>
      <div>
        <h3 className={`text-sm font-montserrat font-bold uppercase tracking-widest mb-1 mt-3 ${textColor}`}>{status}</h3>
        <p className="text-xs text-white/60 font-roboto leading-tight">{desc}</p>
      </div>
    </div>
  );
}

function MetricItem({ label, value, icon }: { label: string; value: number | string; icon: React.ReactNode }) {
  return (
    <div className="flex justify-between items-end border-b border-white/10 pb-2 group cursor-default relative">
      <div className="absolute bottom-[-1px] left-0 w-0 h-px bg-[#00c2b4] transition-all duration-300 group-hover:w-full" />
      <div className="flex flex-col">
        <div className="text-[#00c2b4] mb-1 group-hover:text-[#ff8e52] transition-colors">{icon}</div>
        <span className="text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest truncate">{label}</span>
      </div>
      <span className="text-xl font-montserrat font-bold text-white leading-none">{value}</span>
    </div>
  );
}

export function MasterCalendarPage() {
  const tasks = useCalendarStore(state => state.tasks);

  const today = new Date();
  const in30 = new Date(); in30.setDate(today.getDate() + 30);
  const in7  = new Date(); in7.setDate(today.getDate() + 7);

  const totalEvents      = tasks.length;
  const compliantActions = tasks.filter(t => t.status === 'Completed').length;
  const upcoming30Days   = tasks.filter(t => { const d = new Date(t.nextDate); return d >= today && d <= in30; }).length;
  const criticalDeadlines= tasks.filter(t => { const d = new Date(t.nextDate); return d >= today && d <= in7; }).length;

  const futureEvents = tasks.filter(t => new Date(t.nextDate) >= today);
  const overdueEvents = tasks.filter(t => new Date(t.nextDate) < today && t.status !== 'Completed').slice(0, 2);

  const byCategory: Record<string, number> = {};
  tasks.forEach(t => { byCategory[t.category] = (byCategory[t.category] ?? 0) + 1; });
  const categoryEntries = Object.entries(byCategory).slice(0, 4);

  const catIcons: Record<string, React.ReactNode> = {
    Governance: <ShieldCheck size={18} />,
    Clinical:   <BookOpen size={18} />,
    QAPI:       <BarChart2 size={18} />,
    Finance:    <FileText size={18} />,
  };

  return (
    <div className="h-full w-full flex flex-col relative z-10 font-sans animate-in fade-in duration-500 overflow-y-auto custom-scrollbar p-6 md:p-10 pt-4">

      {/* Header */}
      <div className="flex justify-between items-end mb-6">
        <div>
          <h1 className="text-2xl font-montserrat font-bold text-white leading-none mb-2">Compliance Calendar</h1>
          <p className="text-sm text-white/60 font-roboto">View and manage all recurring governance and operational deadlines</p>
        </div>
        <div className="flex space-x-3">
          <button className="flex items-center space-x-2 px-4 py-2 bg-white/10 border border-white/20 text-white rounded-xl text-sm font-montserrat font-bold hover:bg-white/20 transition-colors shadow-sm backdrop-blur-sm">
            <Download size={18} /><span>Export</span>
          </button>
          <button className="flex items-center space-x-2 px-4 py-2 bg-[#C74600] text-white border border-[#C74600] rounded-xl text-sm font-montserrat font-bold hover:bg-[#A83B00] transition-colors shadow-sm">
            <Plus size={18} /><span>New Event</span>
          </button>
        </div>
      </div>

      {/* KPI Row */}
      <div className="grid grid-cols-4 gap-4 xl:gap-6 mb-8 relative z-10">
        <StatusKpiCard status="TOTAL EVENTS" count={totalEvents} desc="Tracked for the current year"
          icon={<FileText size={20} />} textColor="text-slate-600" bgIconClass="bg-slate-500 text-white shadow-sm" />
        <StatusKpiCard status="UPCOMING (30 DAYS)" count={upcoming30Days} desc="Requires immediate attention"
          icon={<Clock size={20} />} textColor="text-[#C74600]" bgIconClass="bg-[#C74600] text-white shadow-sm" />
        <StatusKpiCard status="CRITICAL DEADLINES" count={criticalDeadlines} desc="Action required (0-7 Days)"
          icon={<AlertCircle size={20} />} textColor="text-[#DC2626]" bgIconClass="bg-[#DC2626] text-white shadow-sm" />
        <StatusKpiCard status="COMPLIANT ACTIONS" count={compliantActions} desc="Completed as scheduled"
          icon={<CheckCircle size={20} />} textColor="text-[#007970]" bgIconClass="bg-[#007970] text-white shadow-sm" />
      </div>

      {/* Main Row */}
      <div className="grid grid-cols-3 gap-6 mb-8 relative z-10">

        {/* Events Table */}
        <div className="col-span-2 bg-white/[0.03] backdrop-blur-md rounded-2xl border border-white/5 flex flex-col overflow-hidden">
          <div className="p-6 border-b border-white/5 shrink-0">
            <h2 className="text-lg font-montserrat font-bold text-white flex items-center">
              <Calendar className="mr-2 text-[#00c2b4]" size={24} /> Upcoming Compliance Events
            </h2>
          </div>
          <div className="flex-1 overflow-auto custom-scrollbar">
            <table className="w-full text-left table-fixed">
              <thead className="bg-white/[0.02] backdrop-blur-sm sticky top-0 z-10">
                <tr>
                  <th className="py-3 px-4 text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest w-[15%] border-b border-white/5">ID</th>
                  <th className="py-3 px-4 text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest w-[30%] border-b border-white/5">Title</th>
                  <th className="py-3 px-4 text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest w-[20%] border-b border-white/5">Owner</th>
                  <th className="py-3 px-4 text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest w-[12%] text-center border-b border-white/5">Module</th>
                  <th className="py-3 px-4 text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest w-[10%] text-center border-b border-white/5">Date</th>
                  <th className="py-3 px-4 text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest w-[13%] text-center border-b border-white/5">Status</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-white/5 font-roboto">
                {futureEvents.map(event => {
                  const displayStatus = getDisplayStatus(event.status);
                  const modBadge = MODULE_BADGE[event.category] ?? 'border border-white/30 text-white/50 bg-white/10';
                  const stBadge  = STATUS_BADGE[displayStatus] ?? 'bg-gray-200 text-gray-800';
                  return (
                    <tr key={event.id} className="hover:bg-white/[0.05] transition-colors group">
                      <td className="py-3 px-4 align-middle w-[15%]">
                        <span className="text-base font-bold text-[#00c2b4]">{event.id}</span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[30%] truncate">
                        <span className="text-base font-bold text-white group-hover:text-[#ff8e52] transition-colors truncate block">{event.task}</span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[20%] truncate">
                        <span className="text-sm font-medium text-white/70 truncate block">{event.responsible}</span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[12%] text-center">
                        <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-montserrat font-bold tracking-wider uppercase whitespace-nowrap ${modBadge}`}>
                          {event.category}
                        </span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[10%] text-center">
                        <span className="text-sm font-medium text-white/70">
                          {new Date(event.nextDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                        </span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[13%] text-center">
                        <span className={`inline-flex items-center justify-center px-2 py-1 rounded text-xs font-montserrat font-bold tracking-wider uppercase shadow-sm whitespace-nowrap ${stBadge}`}>
                          {displayStatus}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        {/* Right Column */}
        <div className="col-span-1 flex flex-col gap-6">

          {/* Compliance Metrics */}
          <div className="bg-white/[0.03] backdrop-blur-md rounded-2xl p-6 border border-white/5 flex flex-col">
            <div className="flex justify-between items-center mb-4">
              <h2 className="text-lg font-montserrat font-bold text-white flex items-center">
                <FileText className="mr-2 text-[#00c2b4]" size={24} /> Compliance Metrics
              </h2>
            </div>
            <div className="grid grid-cols-2 gap-y-4 gap-x-4">
              {categoryEntries.map(([cat, count]) => (
                <MetricItem key={cat} label={cat.toUpperCase()} value={count} icon={catIcons[cat] ?? <FileText size={18} />} />
              ))}
            </div>
          </div>

          {/* Compliance Action Needed */}
          <div className="bg-white/[0.03] backdrop-blur-md rounded-2xl border border-white/5 overflow-hidden flex-1 flex flex-col">
            <div className="px-6 py-3 border-b border-white/5 bg-red-500/10 shrink-0">
              <h2 className="text-lg font-montserrat font-bold text-red-400 flex items-center">
                <AlertTriangle className="mr-2" size={24} /> Compliance Action Needed
              </h2>
            </div>
            <div className="flex-1 overflow-y-auto custom-scrollbar">
              <table className="w-full text-left table-fixed">
                <tbody className="divide-y divide-white/5 font-roboto">
                  {overdueEvents.length === 0 ? (
                    <tr><td colSpan={4} className="py-8 text-center text-sm text-white/40 font-roboto">No overdue actions</td></tr>
                  ) : overdueEvents.map(ev => (
                    <tr key={ev.id} className="hover:bg-white/[0.05] transition-colors group">
                      <td className="py-3 px-4 align-middle w-[50%]">
                        <div className="flex flex-col">
                          <span className="text-base font-bold text-white truncate">{ev.task}</span>
                          <span className="text-xs font-montserrat font-bold text-white/50 uppercase tracking-widest">{ev.id}</span>
                        </div>
                      </td>
                      <td className="py-3 px-4 align-middle w-[20%] text-center">
                        <span className="text-sm font-bold text-[#ff8e52]">
                          {new Date(ev.nextDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                        </span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[20%] text-center">
                        <span className="inline-flex items-center justify-center px-2 py-1 bg-[#DC2626] text-white rounded text-xs font-montserrat font-bold tracking-wider uppercase whitespace-nowrap shadow-sm">
                          OVERDUE
                        </span>
                      </td>
                      <td className="py-3 px-4 align-middle w-[10%] text-right pr-4">
                        <button className="px-2 py-1 bg-white/10 border border-white/20 text-white font-montserrat font-bold text-xs rounded-lg hover:bg-white/20 hover:text-[#00c2b4] shadow-sm transition-all flex items-center ml-auto">
                          Review <ChevronRight size={12} className="ml-1" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  );
}

