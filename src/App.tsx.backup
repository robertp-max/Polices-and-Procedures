  taskDistribution: [
    { label: 'QAPI Training Module', val: 33, max: 33, color: '#FF5A1F' },
    { label: 'OASIS-E2 SOC Simulator', val: 29, max: 33, color: '#00F0FF' },
    { label: 'CMS Documentation Toolkit', val: 29, max: 33, color: '#00F0FF' },
    { label: 'CMS-485 Form Training', val: 22, max: 33, color: '#00F0FF' },
    { label: 'CIHHC LMS Integration', val: 19, max: 33, color: '#FF5A1F' },
