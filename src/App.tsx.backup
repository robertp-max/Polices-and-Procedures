    { role: 'Content / Clinical SME', cost: '$15k - $29k', desc: '535 scripts, 108 cards, 33 cases' },
    { role: 'UI/UX Designer', cost: '$8k - $18k', desc: 'Design tokens, animations, brand compliance' },
    { role: 'Instructional Designer', cost: '$6k - $12k', desc: '6-phase course model, simulator design' },
