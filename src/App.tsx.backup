type TabId = 'portfolio' | 'roi' | 'sprint' | 'metrics' | 'tasks';

type ReportId = 'executive' | 'commits' | 'roi' | 'sprint' | 'stakeholder' | 'tasks';

type SubTabState = {
  portfolio: 'overview' | 'readiness';
  roi: 'overview' | 'avoided';
  sprint: 'trajectory' | 'velocity';
  metrics: 'inventory' | 'scale';
  tasks: 'deliverables' | 'overview';
};

type GlassCardProps = {
  children: React.ReactNode;
  className?: string;
};

type MetallicTextProps = {
  text: string;
  className?: string;
};

type StatBlockProps = {
  label: string;
  value: string;
  sub: string;
  highlightColor?: string;
};

const reportData = {
  tabs: [
    {
      id: 'portfolio' as const,
