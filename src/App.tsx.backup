  deliverables: [
    { tag: 'Architecture', txt: '6-phase linear workflow locked (Disclosure -> Sections -> Review)' },
    { tag: 'UI/UX', txt: 'Design System strictly applied (Glassmorphism, Roboto Thin, Contrast)' },
    { tag: 'Simulation', txt: 'Remediation state machine implemented (QUIZ -> REVIEW -> SUCCESS)' },
    { tag: 'Audio', txt: '3,176 audio files generated, mapped, and synced to logic triggers' },
    { tag: 'Data', txt: '27-artifact patient case built (Evelyn Vance, 82F, CHF/DM2)' },
    { tag: 'Engineering', txt: 'SCORM 1.2 multi-protocol completion cascade (SCORM -> xAPI -> Webhook)' },
