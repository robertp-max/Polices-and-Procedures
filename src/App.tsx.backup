    { id: 'commits' as const, label: 'Git Commits', file: 'GIT-COMMITS.md', content: gitCommitsText },
    { id: 'roi' as const, label: 'ROI Analysis', file: 'ROI-ANALYSIS.md', content: roiAnalysisText },
    { id: 'sprint' as const, label: 'Sprint Map', file: 'SPRINT-MAP.md', content: sprintMapText },
    { id: 'stakeholder' as const, label: 'Stakeholder Metrics', file: 'STAKEHOLDER-METRICS.md', content: stakeholderMetricsText },
    { id: 'tasks' as const, label: 'Tasks Completed', file: 'TASKS-COMPLETED.md', content: tasksCompletedText },
