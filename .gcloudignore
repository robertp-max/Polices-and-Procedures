# Controls what `gcloud builds submit` uploads as the Cloud Build context.
# (Cloud Build then applies .dockerignore when building the image.)
# Keep everything the Vite SPA build needs (src, public, scripts, configs,
# package*.json, Dockerfile, deploy/) and exclude heavy/secret/irrelevant content.

# Dependencies & build outputs (rebuilt inside the image)
.git
.gitignore
node_modules
**/node_modules
dist
.cache
# Nested experimental git worktrees — never part of a build (huge bloat)
.wtpreview

# Secrets / local env (NEVER upload)
.env
.env.*
# ...but the PUBLIC build-time Vite config must ship (combined image build
# needs VITE_AUTH_API_BASE_URL=/api/auth; contains no secrets)
!.env.production
**/*service-account*.json
**/*credentials*.json
**/*.private.json
server/credentials

# NOTE: server/ IS uploaded — the combined Cloud Run image (Dockerfile.server)
# builds the SPA AND runs the Express API from server/. Only secrets under
# server/credentials are excluded (above).
infra
migrations

# Heavy or irrelevant local content
Bin-(thrash)
Project_Intelligence
REVIEW_OUTPUTS
# Generated scratch outputs (may contain PHI extractions/PDFs) — never upload
output
outputs
**/mock_assessments
**/screenshots
**/uat-results
**/uat-html-report
**/downloads
*.docx
*.xlsx
*.pptx
*.mov
*.mp4
*.mp3
# STABLE narration audio (~1.2GB, advanced-training only) lives in the
# ci-hhv2-narration GCS bucket, mounted into Cloud Run at /mnt/narration —
# if those files ever change, sync with:
#   gsutil -m rsync -r public/advanced-training gs://ci-hhv2-narration/advanced-training
# Narration under ACTIVE development (onboarding/ACHC → public/assets/narration)
# intentionally ships with every build; move a module here + bucket-sync it
# only once it stabilizes.
public/advanced-training/**/*.wav

# Scratch, logs, manifests
*.log
*.pid
*.err
npm-run-*
tmp_*
tmp-*
temp-*
build*.log
tsc-*.log
dev-*.log
*_MANIFEST.txt
DELETE_LIST.txt
